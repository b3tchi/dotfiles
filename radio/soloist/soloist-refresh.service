[Unit]
Description=Refresh Spotify Soloist before its build expires (radio)
Documentation=file:%h/.dotfiles/radio/soloist/soloist-refresh
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/soloist-refresh
# downloads ~13 MB (+ ~14 MB of libraries on musl); bounded so a hung
# mirror still ends in the failure notification
TimeoutStartSec=20min
