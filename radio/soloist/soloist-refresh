#!/bin/sh
# soloist-refresh: keep Spotify Soloist from expiring (builds stop 90 days
# after they were built). Run weekly by soloist-refresh.timer (radio dot);
# the installer (this directory's main.go, `go run`) only downloads when the
# copy is older than 30 days, so a refresh lands about monthly.
# Log: ~/.local/state/soloist-refresh.log. Notifies when it fetched a new
# build or failed; quiet otherwise. A running Soloist keeps the old build
# until radio restarts.
SRC="$HOME/.dotfiles/radio/soloist"
if command -v akm-root >/dev/null 2>&1; then
    ROOT="$(akm-root 2>/dev/null || true)"
    [ -n "$ROOT" ] && [ -d "$ROOT/radio/soloist" ] && SRC="$ROOT/radio/soloist"
fi
log="${XDG_STATE_HOME:-$HOME/.local/state}/soloist-refresh.log"
mkdir -p "$(dirname "$log")"
notify() { command -v notify-send >/dev/null 2>&1 && timeout 5 notify-send "$@" >/dev/null 2>&1; true; }

if CGO_ENABLED=0 go run -C "$SRC" . > "$log" 2>&1; then
    if grep -q "downloading the" "$log"; then
        notify -a radio "Soloist updated" "$(grep -m1 'Release' "$log" | sed 's/^soloist: //')"
    fi
    exit 0
fi
notify -a radio -u critical "Soloist refresh failed" "see $log"
exit 1
