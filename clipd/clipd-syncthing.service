# clipd's own Syncthing (sp039 Task 9). Not the user's syncthing.service:
# this instance is LAN-only (no discovery, relays or NAT), which is a
# per-instance setting the user's NAS sync cannot live with. Home, GUI and
# listen address are configured by `clipd.nu setup`; the home is generated by
# clipd.nu too, so the first start after install should be `clipd.nu start`
# or `clipd.nu setup`, not this unit on its own.
[Unit]
Description=Syncthing for clipd (LAN-only clipboard sync)
Documentation=file://%h/.dotfiles/clipd/dot.yaml
After=network.target
ConditionPathExists=%h/.local/state/clipd/syncthing/config.xml
# Bounded restarts (adr0014): five tries in five minutes, then give up and
# leave the failure visible in `systemctl --user status`.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=STNODEFAULTFOLDER=1
ExecStart=/usr/bin/syncthing serve --home=%h/.local/state/clipd/syncthing --no-browser --no-restart
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
