#!/usr/bin/env node
// kwi3-theme - make draw.io match the kwi3 grid: kwi3 palette in dark mode,
// kwi3 font at the kwi3 px size for the UI (menus, toolbar, panels, dialogs).
// Diagram text is untouched: shapes keep their own fontFamily/fontSize.
//
// Reads the live grid from kwi3 (`kwi3-msg grid.get`) and falls back to
// kwi3's shipped values, like libreoffice/kwi3-theme. Re-run after a kwi3
// color/font change. Idempotent.
//
// draw.io keeps its configuration (Extras > Configuration) only in the
// renderer's localStorage, key ".configuration"; it has no config file. So
// this starts draw.io with a private --remote-debugging-port, merges the keys
// it owns (css, darkColor, defaultDarkGridColor, gridSteps,
// defaultVertexStyle, defaultEdgeStyle) into that JSON over the DevTools protocol and
// closes the window again; every other configuration key is kept. draw.io
// applies the configuration on its next start.
//
//   kwi3-theme              apply (refuses while draw.io runs: two
//                           instances would share one localStorage)
//   kwi3-theme --port N     apply to an instance already started with
//                           --remote-debugging-port=N, live, and leave it open
//   kwi3-theme --print      print the configuration JSON, change nothing
//
// The launcher is ~/.local/bin/drawio (Flatpak on postmarketOS, see
// dot.yaml), else `drawio` on PATH.
import { execFileSync, spawn } from "node:child_process";
import { existsSync } from "node:fs";
import { createServer } from "node:net";
import { homedir } from "node:os";
import { join } from "node:path";

const FALLBACK = {
  font: { family: "Iosevka", pixelSize: 16 },
  colors: {
    focused: { background: "#152024", text: "#FDF6E3" },
    unfocused: { background: "#222D31", text: "#707880" },
    urgent: { border: "#CB4B16", indicator: "#268BD2" },
  },
  frame: { color: "#16a085" },
};

function kwi3Grid() {
  try {
    const out = execFileSync("kwi3-msg", ["grid.get"], {
      timeout: 3000, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"],
    });
    return [JSON.parse(out), "kwi3"];
  } catch {
    return [FALLBACK, "fallback"];
  }
}

function lighten(h, amount) {
  const v = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  return "#" + v.map((c) => Math.min(255, c + amount).toString(16).padStart(2, "0")).join("");
}

// Same roles as libreoffice/kwi3-theme: dark = titlebar/input bg, body =
// tile body bg; the chrome is dark. The canvas (the grid) is black.
// Grid: main lines in the dim kwi3 body color, sub-grid at MINOR of that.
// draw.io hard-codes the sub-grid at 20% opacity inside the grid image it
// builds, so the css swaps that image for gridImage() below. draw.io still
// sizes and positions it (background-size = one GRID_STEPS cell at the
// current zoom), so the replacement follows zoom and pan.
const CANVAS = "#000000";
const GRID_STEPS = 4;   // draw.io's stock gridSteps
const MINOR = 0.70;     // sub-grid opacity relative to the main lines
// New shapes and edges: hand-drawn like the kwi3 docs/diagrams/*.drawio
// (sketch, Architects Daughter from the fonts dot), rounded.
const SKETCH = {
  sketch: "1", rounded: "1", hachureGap: "4", jiggle: "2", curveFitting: "1",
  fontFamily: "Architects Daughter",
};
// draw.io's stock edge defaults, kept under the sketch keys.
const EDGE = {
  edgeStyle: "orthogonalEdgeStyle", jettySize: "auto", orthogonalLoop: "1",
  defaultLabelBackgroundColor: "page", labelPadding: "0 4",
};
// One GRID_STEPS x GRID_STEPS cell, stretched by draw.io's background-size;
// non-scaling-stroke keeps lines 1px at any zoom.
function gridImage(color) {
  const n = GRID_STEPS;
  const minor = [];
  for (let i = 1; i < n; i++) minor.push(`M0 ${i}H${n}M${i} 0V${n}`);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${n} ${n}" preserveAspectRatio="none">`
    + `<path d="${minor.join("")}" fill="none" stroke="${color}" stroke-opacity="${MINOR}" stroke-width="1" vector-effect="non-scaling-stroke"/>`
    + `<path d="M0 0H${n}V${n}H0Z" fill="none" stroke="${color}" stroke-width="1" vector-effect="non-scaling-stroke"/>`
    + `</svg>`;
  return `url("data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}")`;
}

export function build(grid) {
  const c = grid.colors;
  const dark = c.focused.background;
  const body = c.unfocused.background;
  const fg = c.focused.text;
  const muted = c.unfocused.text;
  const accent = (grid.frame || FALLBACK.frame).color;
  const warn = c.urgent.border;
  const font = grid.font || FALLBACK.font;
  const px = font.pixelSize;
  const hover = lighten(body, 0x10);
  const border = lighten(body, 0x18);
  // draw.io's dark rules read these via light-dark(light, dark); only the
  // dark half is overridden, so light mode stays stock.
  const vars = {
    "--dark-color": CANVAS,
    "--ge-dark-color": CANVAS,
    "--ge-dark-panel-color": dark,
    "--dark-toolbar-color": dark,
    "--dark-header-color": dark,
    "--dark-border-color": border,
    "--dark-text-color": fg,
    "--dark-strong-text-color": fg,
    "--dark-secondary-text-color": muted,
    "--dark-faint-text-color": muted,
    "--dark-accent-color": `color-mix(in srgb, ${accent} 35%, ${dark})`,
    "--dark-accent-text-color": accent,
    "--dark-active-accent-color": accent,
    "--dark-focus-color": accent,
    "--dark-highlight-color": dark,
    "--dark-dialog-color": body,
    "--dark-field-color": dark,
    "--dark-field-border-color": border,
    "--dark-strong-border-color": border,
    "--dark-card-color": body,
    "--dark-soft-color": hover,
    "--dark-soft-hover-color": border,
    "--dark-scrollbar-color": hover,
    "--dark-error-background-color": warn,
  };
  const ui = [
    ".geMenubarContainer", ".geMenubarContainer *",
    ".geToolbarContainer", ".geToolbarContainer *",
    ".geSidebarContainer", ".geSidebarContainer .geTitle",
    ".geFormatContainer", ".geFormatContainer *",
    ".geFooterContainer", ".geFooterContainer *",
    ".geTabContainer", ".geTabContainer *",
    ".mxPopupMenu", ".mxPopupMenu *",
    ".geDialog", ".geDialog *", ".mxWindow", ".mxWindow *",
    ".geHint", ".mxTooltip", ".geStatus",
  ].join(",\n");
  const css = `/* generated by ~/.dotfiles/drawio/kwi3-theme */
:root:root {
${Object.entries(vars).map(([k, v]) => `  ${k}: ${v};`).join("\n")}
}
${ui} {
  font-family: "${font.family}", sans-serif !important;
  font-size: ${px}px !important;
}
/* grid image: only on the element draw.io put its own grid on (page
   background, or the canvas svg without page view), dark mode only */
body.geDarkMode .geDiagramContainer > [style*="image/svg+xml"] {
  background-image: ${gridImage(body)} !important;
}
`;
  return {
    darkColor: CANVAS, defaultDarkGridColor: body, gridSteps: GRID_STEPS,
    defaultVertexStyle: { ...SKETCH },
    defaultEdgeStyle: { ...EDGE, ...SKETCH },
    css,
  };
}

function freePort() {
  return new Promise((resolve, reject) => {
    const s = createServer();
    s.unref();
    s.on("error", reject);
    s.listen(0, "127.0.0.1", () => {
      const { port } = s.address();
      s.close(() => resolve(port));
    });
  });
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function pageTarget(port, timeoutMs) {
  const end = Date.now() + timeoutMs;
  while (Date.now() < end) {
    try {
      const list = await (await fetch(`http://127.0.0.1:${port}/json`)).json();
      const page = list.find((t) => t.type === "page" && /\/index\.html/.test(t.url));
      if (page) return page;
    } catch { /* not up yet */ }
    await sleep(500);
  }
  throw new Error(`no draw.io page on port ${port} after ${timeoutMs / 1000}s`);
}

function cdp(wsUrl) {
  const ws = new WebSocket(wsUrl);
  let id = 0;
  const pending = new Map();
  ws.onmessage = (ev) => {
    const msg = JSON.parse(ev.data);
    const p = pending.get(msg.id);
    if (!p) return;
    pending.delete(msg.id);
    msg.error ? p.reject(new Error(msg.error.message)) : p.resolve(msg.result);
  };
  const ready = new Promise((resolve, reject) => {
    ws.onopen = resolve;
    ws.onerror = () => reject(new Error(`cannot connect to ${wsUrl}`));
  });
  return {
    ready,
    send(method, params = {}) {
      return new Promise((resolve, reject) => {
        pending.set(++id, { resolve, reject });
        ws.send(JSON.stringify({ id, method, params }));
      });
    },
    close: () => ws.close(),
  };
}

// Runs in the page. Merges the owned keys into ".configuration" and swaps a
// live <style> so the open window shows the result at once.
// The grid color also lives in draw.io's own settings (mxSettings,
// ".drawio-config"), saved there on first start with the stock #424242; that
// copy wins over the configuration key, so it is set through mxSettings too.
function applyInPage(owned) {
  if (typeof mxSettings !== "undefined" && owned.defaultDarkGridColor) {
    mxSettings.setGridColor(owned.defaultDarkGridColor, true);
    mxSettings.save();
  }
  const key = ".configuration";
  let conf = {};
  try { conf = JSON.parse(localStorage.getItem(key)) || {}; } catch { conf = {}; }
  Object.assign(conf, owned);
  localStorage.setItem(key, JSON.stringify(conf));
  let st = document.getElementById("kwi3Theme");
  if (!st) {
    st = document.createElement("style");
    st.id = "kwi3Theme";
    document.head.appendChild(st);
  }
  st.textContent = owned.css;
  return Object.keys(conf).join(",");
}

async function apply(port, owned) {
  const page = await pageTarget(port, 60000);
  const c = cdp(page.webSocketDebuggerUrl);
  await c.ready;
  // Wait for the editor: localStorage is per origin, ready before that, but
  // the live <style> needs the UI.
  for (let i = 0; i < 60; i++) {
    const r = await c.send("Runtime.evaluate", {
      expression: "typeof Editor !== 'undefined' && document.querySelector('.geEditor') != null",
      returnByValue: true,
    });
    if (r.result.value) break;
    await sleep(500);
  }
  const r = await c.send("Runtime.evaluate", {
    expression: `(${applyInPage})(${JSON.stringify(owned)})`,
    returnByValue: true,
  });
  if (r.exceptionDetails) throw new Error(r.exceptionDetails.text);
  c.close();
  return r.result.value;
}

function drawioRunning() {
  try {
    const out = execFileSync("flatpak", ["ps", "--columns=application"], {
      encoding: "utf8", stdio: ["ignore", "pipe", "ignore"],
    });
    if (out.includes("com.jgraph.drawio.desktop")) return true;
  } catch { /* no flatpak */ }
  try {
    execFileSync("pgrep", ["-x", "drawio"], { stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
}

async function main() {
  const args = process.argv.slice(2);
  const [grid, source] = kwi3Grid();
  const owned = build(grid);
  if (args.includes("--print")) {
    console.log(JSON.stringify(owned, null, 2));
    return;
  }
  const pi = args.indexOf("--port");
  if (pi >= 0) {
    const keys = await apply(Number(args[pi + 1]), owned);
    console.log(`kwi3-theme: draw.io configured live from ${source} (keys: ${keys})`);
    return;
  }
  if (drawioRunning()) {
    console.error("kwi3-theme: draw.io is running; close it first");
    process.exit(1);
  }
  const local = join(homedir(), ".local", "bin", "drawio");
  const launcher = existsSync(local) ? local : "drawio";
  const port = await freePort();
  const child = spawn(launcher, [`--remote-debugging-port=${port}`], {
    stdio: "ignore",
  });
  try {
    const keys = await apply(port, owned);
    console.log(`kwi3-theme: draw.io configured from ${source} (keys: ${keys})`);
  } finally {
    // Close via the browser target (lets draw.io flush localStorage), then
    // make sure the process this script started is gone.
    try {
      const v = await (await fetch(`http://127.0.0.1:${port}/json/version`)).json();
      const b = cdp(v.webSocketDebuggerUrl);
      await b.ready;
      await b.send("Browser.close").catch(() => {});
      b.close();
    } catch { /* already gone */ }
    for (let i = 0; i < 20 && child.exitCode === null; i++) await sleep(500);
    if (child.exitCode === null) child.kill();
  }
}

main().catch((e) => {
  console.error(`kwi3-theme: ${e.message}`);
  process.exit(1);
});
