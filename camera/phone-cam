#!/bin/sh
# phone-cam: viewfinder-then-snap for the Nothing Phone's back ultrawide
# (s5kjn1). On the phone $mod+f (Alt+f) runs `phone-cam start` and enters
# hotkeyd's "camera" layer (host_phone.go), whose keys run the other verbs;
# the bar shows them in its hint strip.
#
#   phone-cam start   live preview sized to the focused workspace; kwi3
#                     floats it frameless over the tabs, so the bar and its
#                     camera hint strip stay visible. The same pipeline tees a few
#                     JPEGs a second into $RUN, so the photo is the frame you
#                     were looking at — the camera is never reopened.
#   phone-cam snap    newest COMPLETE frame -> ~/Pictures/camera/<stamp>.jpg
#                     and the clipboard (wl-copy, as image/png); the preview
#                     closes, notify-send says where it went.
#   phone-cam cancel  close the preview, save nothing.
#   phone-cam         no verb: snap if the preview is up, else start.
#
# However the preview ends (snap, cancel, its window closed), the watcher
# clears hotkeyd's layer, so the camera layer's grabs never outlive it.
#
# The main imx766 has no driver; this sensor has no colour tuning yet, so
# expect a green/cyan cast. The DT says rotation=90; on the phone held
# upright that means videoflip counterclockwise (tested 2026-11-22). Override with
# PHONE_CAM_FLIP (videoflip method names:
# none, clockwise, rotate-180, counterclockwise) and PHONE_CAM_NAME.
set -u

CAM="${PHONE_CAM_NAME:-/base/soc@0/cci@ac4b000/i2c-bus@0/camera@2d}"
FLIP="${PHONE_CAM_FLIP:-counterclockwise}"
RUN="${XDG_RUNTIME_DIR:-/tmp}/phone-cam"
PID="$RUN/pid"
OUT="${PHONE_CAM_DIR:-$HOME/Pictures/camera}"

notify() { notify-send -a phone-cam "$@" 2>/dev/null || echo "phone-cam: $*" >&2; }

running() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

snap() {
  # multifilesink keeps the last 3 frames; the newest may still be being
  # written, so take the second newest when there is one.
  frame=$(ls -1t "$RUN"/frame-*.jpg 2>/dev/null | sed -n 2p)
  [ -n "$frame" ] || frame=$(ls -1t "$RUN"/frame-*.jpg 2>/dev/null | sed -n 1p)
  if [ -z "$frame" ]; then
    notify "Camera" "no frame yet — press again in a moment"
    return 1
  fi
  mkdir -p "$OUT"
  dest="$OUT/$(date +%Y%m%d-%H%M%S).jpg"
  cp "$frame" "$dest"
  kill -INT "$(cat "$PID")" 2>/dev/null
  # also onto the Wayland clipboard, ready to paste as an image. As PNG:
  # the $mod+v history (i3/scripts/clip-store-wl.sh) only keeps image/png.
  if command -v wl-copy >/dev/null 2>&1; then
    png="$RUN/clip.png"
    if gst-launch-1.0 -q filesrc location="$dest" ! jpegdec ! videoconvert ! \
         pngenc ! filesink location="$png" >/dev/null 2>&1; then
      wl-copy --type image/png <"$png"
    else
      wl-copy --type image/jpeg <"$dest"
    fi
    rm -f "$png"
  fi
  notify -i "$dest" "Photo saved + copied" "$dest"
}

start() {
  command -v gst-launch-1.0 >/dev/null 2>&1 || {
    notify "Camera" "gst-launch-1.0 missing: rotz install camera"
    exit 1
  }
  mkdir -p "$RUN"
  rm -f "$RUN"/frame-*.jpg
  # The preview fills the focused workspace (kwi3 floats it frameless over
  # the tabs, kwi3/config.js): scale + letterbox to its size. The photo
  # branch keeps the sensor's full 720x1280. No kwi3 tree: unscaled.
  fit=""
  wh=$(i3tree 2>/dev/null | jq -r 'first(.. | objects | select(.type == "workspace")
        | select([.. | objects | .focused?] | any) | "\(.rect.width) \(.rect.height)")' 2>/dev/null)
  case "$wh" in
  [0-9]*" "[0-9]*) fit="videoscale add-borders=true ! video/x-raw,width=${wh% *},height=${wh#* } !" ;;
  esac
  gst-launch-1.0 -q -e libcamerasrc camera-name="$CAM" ae-exposure-mode=long ! \
    video/x-raw,width=1280,height=720 ! videoconvert ! videoflip method="$FLIP" ! \
    tee name=t \
    t. ! queue ! videoconvert ! $fit waylandsink fullscreen=false \
    t. ! queue leaky=downstream max-size-buffers=1 ! videorate max-rate=4 ! \
         jpegenc quality=92 ! multifilesink location="$RUN/frame-%05d.jpg" max-files=3 \
    >"$RUN/log" 2>&1 &
  echo $! >"$PID"
  # wait in the background so the preview cleans up after itself, however
  # it ends, and hands the keyboard back (leaves the camera layer).
  ( wait_pid=$(cat "$PID"); while kill -0 "$wait_pid" 2>/dev/null; do sleep 1; done
    rm -f "$PID" "$RUN"/frame-*.jpg
    "$HOME/.local/bin/hotkeyd" set-layer default ) >/dev/null 2>&1 &
}

cancel() {
  running && kill -INT "$(cat "$PID")" 2>/dev/null
  return 0
}

case "${1:-}" in
start) running || start ;;
snap) if running; then snap; else notify "Camera" "no preview open"; fi ;;
cancel) cancel ;;
"") if running; then snap; else start; fi ;;
*) echo "usage: phone-cam [start|snap|cancel]" >&2; exit 2 ;;
esac
