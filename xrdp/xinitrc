# xrdp session entry (see poc002) — sourced by /etc/xrdp/startwm.sh
# NOTE: do NOT set GALLIUM_DRIVER=d3d12 here — poisons /dev/dxg (poc002)
unset SWAYSOCK I3SOCK
# Alt as i3 modifier in any xrdp session (Win key captured by client
# host: Windows windowed RDP, Android RDP apps) — base config reads this
# via set_from_resource, fallback Mod4. Guard keeps local startx on Mod4.
if [ -n "$XRDP_SESSION" ]; then
    printf 'i3wm.mod: Mod1\n' | xrdb -merge
fi
# Reset keymap + clear inherited locked modifiers. xrdp sessions can start
# with a stuck Mod3 (ISO_Level5 lock) latched in from the RDP client's
# keyboard-state sync. That extra bit rides on every key event, so i3's
# keybind grabs (which only compensate for NumLock/CapsLock) never match and
# Alt shortcuts silently leak to the focused window. setxkbmap recompiles the
# map and resets the locked state to 0.
# Layout is re-applied, never chosen: xorgxrdp already loaded the RDP client's
# keyboard (rdpLoadLayout 0x00010409 -> us(dvorak)) before this runs, and a
# hard-coded `-layout us` turned a Dvorak client into QWERTY. Only reconnects
# hid it (they re-run rdpLoadLayout after this file). See kwi3 krdp/phone/config/xinitrc.
xkb_layout=$(setxkbmap -query 2>/dev/null | sed -n 's/^layout: *//p')
xkb_variant=$(setxkbmap -query 2>/dev/null | sed -n 's/^variant: *//p')
setxkbmap -layout "${xkb_layout:-us}" ${xkb_variant:+-variant "$xkb_variant"} \
    -model pc104 -option ""
unset xkb_layout xkb_variant

# ------------------------------------------- session env snapshot (sp038 T1)
# wm-launch-detach starts every launched app from THIS environment, never the
# caller's. Written right before each exec below (kwi3 and i3), when DISPLAY
# and everything the session exported are final. A failure is reported, not
# fatal: the session must still come up (launches then refuse by name).
wm_session_env_snapshot() {
    _snap="$HOME/.local/bin/wm-session-env-snapshot"
    if [ -x "$_snap" ]; then
        "$_snap" || echo "xinitrc: wm-session-env-snapshot failed" >&2
    else
        echo "xinitrc: $_snap missing - launches will refuse" >&2
    fi
    unset _snap
}

# ------------------------------------------------- the kwi3 leg (kwi3-7m8.7)
# Set only by the kwi3 xrdp listener's own sesman.ini
# ([SessionVariables] KWI3_SESSION=1 in kwi3/xrdp/sesman.ini) — nothing else
# on this machine sets it, so the i3 leg below runs exactly as it always has
# whenever this is unset. Placed after the mod-resource merge and the
# setxkbmap reset above: hotkeyd resolves $mod from the same i3wm.mod X
# resource i3 does (hotkeyd/internal/bind/chord.go), so both legs need it,
# and both need the keymap reset for the same stuck-Mod3 reason. See
# i3kwin/examples/xinitrc (upstream kwi3 repo) and krdp/README.md "Two xrdp
# listeners" for the phone's version of this same branch (there, the
# discriminator is a second xrdp listener on a different port; here it is
# this same listener's own sesman, per kwi3-7m8.7).
if [ -n "${KWI3_SESSION:-}" ]; then
    # Sourced, not run: the whole job of kwi3-session-env.sh is one export,
    # $KWI3SOCK (kwi3's JSON-RPC socket) — never restated here, because the
    # X11 host computes the same socket path itself (adapters/x11/src/
    # ipcserver.cpp) and two spellings of one path is how a session ends up
    # exporting a socket nothing serves. Since kwi3 sp004 Task 18
    # (kwi3-234.18) kwi3 serves no i3 IPC socket, and the script UNSETS
    # I3SOCK/HOTKEYD_I3SOCK rather than exporting them.
    ENV_SH="$HOME/.local/bin/kwi3-session-env.sh"
    if [ -r "$ENV_SH" ]; then
        # shellcheck source=/dev/null
        . "$ENV_SH"
    fi

    # Refuse rather than start half a session: if the env script did not
    # run, or is a stale pre-T18 copy that names kwi3's old i3 socket and no
    # $KWI3SOCK, nothing in the session knows where kwi3 is - hotkeyd would
    # dispatch nowhere and the bar would read nothing. Falling through to the
    # i3 leg below is safer than starting kwi3 with a keyboard aimed at
    # nothing. (kwi3-x11-session makes the same check again, and also
    # refuses an i3 variable left set.)
    if [ -n "${KWI3SOCK:-}" ] && [ -x "$HOME/.local/bin/kwi3-x11-session" ]; then
        wm_session_env_snapshot
        exec "$HOME/.local/bin/kwi3-x11-session"
    fi

    echo "xinitrc: KWI3_SESSION is set but the launcher is missing, not" \
         "executable, or kwi3-session-env.sh exported no KWI3SOCK - falling through" >&2
fi

# shared config (ft003): ~/.i3/config + ~/.i3/config.d/wsl.conf via rotz
wm_session_env_snapshot
exec i3
