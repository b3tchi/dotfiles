[diff]
	tool = vimdiff
	external = difft

[merge]
	tool = vimdiff

[init]
	defaultBranch = main

[diff]
        tool = difftastic

[difftool]
        prompt = false

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

# diff.external (difft) only drives `git diff`; log and show need --ext-diff
[alias]
	dlog = log -p --ext-diff
	dshow = show --ext-diff
