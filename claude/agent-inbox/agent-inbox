#!/usr/bin/env python3
"""agent-inbox -- ask/answer channel between a detached agent and its operator.

Agent side is one verb:

    agent-inbox ask "<question>"

Run it with the Bash tool and run_in_background=true. It parks; the harness wakes
the agent when the operator answers. The agent never learns the store path, the
filename, or the protocol.

Operator side is a directory. Open it, type under '# reply', save. No command
required -- the subcommands below are conveniences.

Store, in precedence order:
    $AGENT_INBOX
    $XDG_STATE_HOME/agent-inbox     (adr0013 precedent: XDG_STATE_HOME, 0700)
    ~/.local/state/agent-inbox

Answered exchanges are filed under sent/ and pruned after $AGENT_INBOX_MAX_AGE
seconds (default 14 days). Pending requests are never pruned.

Evidence: docs/notes/lab/poc020.md (channel), poc021.md (mode).
"""
import argparse, os, re, subprocess, sys, time
from pathlib import Path

MAX_AGE = int(os.environ.get("AGENT_INBOX_MAX_AGE", 14 * 24 * 3600))


def store() -> Path:
    if v := os.environ.get("AGENT_INBOX"):
        p = Path(v)
    else:
        base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state")
        p = Path(base) / "agent-inbox"
    (p / "sent").mkdir(parents=True, exist_ok=True)
    try:
        p.chmod(0o700)
    except OSError:
        pass
    return p


def prune(d: Path) -> None:
    """Prune-on-write, per adr0013: an external timer can silently not run."""
    cutoff = time.time() - MAX_AGE
    for f in (d / "sent").glob("*.md"):
        try:
            if f.stat().st_mtime < cutoff:
                f.unlink()
        except OSError:
            pass


def agent_id() -> str:
    """Address of the asking agent. Derived, never supplied by the agent."""
    for var in ("AGENT_NAME", "CLAUDE_AGENT_NAME", "TMUX_PANE"):
        if v := os.environ.get(var):
            if cleaned := re.sub(r"\W+", "", v):
                return cleaned
    return f"pid{os.getppid()}"


def project() -> str:
    """Which codebase the asking agent is working in. Derived, not supplied."""
    if v := os.environ.get("AGENT_PROJECT"):
        return v
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=3)
        if r.returncode == 0 and r.stdout.strip():
            return Path(r.stdout.strip()).name
    except Exception:
        pass
    return Path.cwd().name


def subject_of_text(q: str, n: int = 72) -> str:
    first = next((l.strip() for l in q.splitlines() if l.strip()), "(no subject)")
    return first if len(first) <= n else first[: n - 1].rstrip() + "…"


def yaml_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


FM_RE = re.compile(r"\A---\n(.*?)\n---\n", re.S)


def frontmatter(text: str) -> dict:
    if not (m := FM_RE.match(text)):
        return {}
    out = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            v = v.strip()
            if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
                v = v[1:-1].replace('\\"', '"').replace("\\\\", "\\")
            out[k.strip()] = v
    return out


def strip_frontmatter(text: str) -> str:
    return FM_RE.sub("", text, count=1)


def slug(s: str, n: int = 60) -> str:
    s = re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-")
    if len(s) <= n:
        return s
    # keep the tail -- it carries the distinguishing part of a question
    return s[: n // 2].rstrip("-") + "--" + s[-(n // 2 - 2):].lstrip("-")


REPLY_RE = re.compile(r"^# reply\s*$", re.M)


def reply_of(text: str) -> str:
    if not (m := REPLY_RE.search(text)):
        return ""
    return re.sub(r"<!--.*?-->", "", text[m.end():], flags=re.S).strip()


def question_of(p: Path) -> str:
    """Body of the question, frontmatter and headers removed. Tolerates files
    written before frontmatter existed (the old `from:` line form)."""
    head = strip_frontmatter(p.read_text()).split("# reply")[0]
    head = head.replace("# question", "")
    return "\n".join(
        l for l in head.splitlines() if l.strip() and not l.startswith("from:")
    ).strip()


def pending(d: Path):
    return sorted((p for p in d.glob("*.md") if p.is_file()), key=lambda p: p.stat().st_mtime)


def new_path(d: Path, question: str) -> Path:
    """Idempotent PER AGENT: the same agent re-asking the same question resumes
    its pending request rather than forking the conversation (poc020). Scoped by
    agent id so two agents asking an identical question do not collide."""
    aid = agent_id()
    for p in pending(d):
        if p.name.startswith(f"{aid}--") and question_of(p) == question.strip():
            return p
    stem = f"{aid}--{slug(question)}"
    p, n = d / f"{stem}.md", 2
    while p.exists():
        p, n = d / f"{stem}-{n}.md", n + 1
    return p


TEMPLATE = """---
from: {aid}
subject: {subject}
project: {project}
created: {created}
---

# question

{q}

# reply

<!-- Type your answer below this line and save the file.
     That is the whole protocol - there is no command to run.
     This file moves to sent/ once the agent has read your answer. -->

"""


def cmd_ask(a) -> int:
    d = store()
    prune(d)
    f = new_path(d, a.question)
    if not f.exists():
        f.write_text(TEMPLATE.format(
            aid=agent_id(),
            subject=yaml_str(subject_of_text(a.question)),
            project=yaml_str(project()),
            created=time.strftime("%Y-%m-%d %H:%M:%S"),
            q=a.question,
        ))
    elif body := reply_of(f.read_text()):
        f.rename(d / "sent" / f"{f.stem}.answered.md")
        print(body)
        return 0
    if not a.quiet:
        print(f"[agent-inbox] waiting for operator ({f.name})", file=sys.stderr)
    mt = f.stat().st_mtime
    deadline = time.time() + a.timeout if a.timeout else None   # 0 = no timeout
    while deadline is None or time.time() < deadline:
        try:
            cur = f.stat().st_mtime
        except FileNotFoundError:
            print(f"request file vanished: {f.name}", file=sys.stderr)
            return 3
        if cur != mt:
            if body := reply_of(f.read_text()):
                f.rename(d / "sent" / f"{f.stem}.answered.md")
                print(body)
                return 0
            mt = cur
        time.sleep(0.4)
    print(f"TIMEOUT: no operator reply within {a.timeout}s", file=sys.stderr)
    return 2


def tell_dir(d: Path, aid: str) -> Path:
    p = d / "tell" / aid
    p.mkdir(parents=True, exist_ok=True)
    return p


def cmd_tell(a) -> int:
    """Operator -> agent, unprompted. Reaches an agent that is not asking."""
    d = store()
    td = tell_dir(d, a.agent)
    (td / f"{int(time.time() * 1000)}.md").write_text(a.text.rstrip() + "\n")
    print(f"queued for {a.agent}")
    return 0


def cmd_listen(a) -> int:
    """Park until the operator sends this agent a message, print it, exit.

    NO timeout by default: a listener is meant to sit for hours. The harness
    wakes the agent when this command exits (proven in poc020 -- an idle agent
    with a parked background call resumed on exit with no nudge), which is what
    makes an agent reachable while it is not asking anything.
    """
    d = store()
    aid = agent_id()
    td = tell_dir(d, aid)
    if not a.quiet:
        print(f"[agent-inbox] {aid} listening", file=sys.stderr)
    deadline = time.time() + a.timeout if a.timeout else None
    while deadline is None or time.time() < deadline:
        msgs = sorted(td.glob("*.md"))
        if msgs:
            p = msgs[0]
            text = p.read_text().strip()
            p.rename(d / "sent" / f"tell-{aid}-{p.stem}.md")
            print(text)
            return 0
        time.sleep(0.4)
    print(f"TIMEOUT: no message within {a.timeout}s", file=sys.stderr)
    return 2


def cmd_list(a) -> int:
    items = pending(store())
    if not items:
        print("no pending requests")
        return 0
    for p in items:
        fm = frontmatter(p.read_text())
        age = int((time.time() - p.stat().st_mtime) / 60)
        age_s = f"{age // 60}h{age % 60:02d}" if age >= 60 else f"{age}m"
        subject = fm.get("subject") or subject_of_text(question_of(p))
        print(f"{p.stem}\t{fm.get('project', '?')}\t{age_s}\t{subject}")
    return 0


def cmd_show(a) -> int:
    p = store() / f"{a.id}.md"
    if not p.exists():
        print(f"no pending request {a.id}", file=sys.stderr)
        return 1
    print(p.read_text(), end="")
    return 0


def cmd_answer(a) -> int:
    p = store() / f"{a.id}.md"
    if not p.exists():
        print(f"no pending request {a.id}", file=sys.stderr)
        return 1
    with p.open("a") as fh:
        fh.write(a.text + "\n")
    print(f"answered {a.id}")
    return 0


def cmd_reply(a) -> int:
    d = store()
    items = [p for p in pending(d) if not a.id or p.stem == a.id]
    if not items:
        print("no pending requests", file=sys.stderr)
        return 1
    n = 0
    for p in items:
        print(f"\n\033[1m{p.stem}\033[0m\n{question_of(p)}")
        try:
            text = input("reply> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not text:
            print("(skipped)")
            continue
        with p.open("a") as fh:
            fh.write(text + "\n")
        n += 1
        print("sent")
    print(f"\n{n} answered, {len(pending(d))} still pending")
    return 0


def cmd_edit(a) -> int:
    d = store()
    p = d / f"{a.id}.md" if a.id else (pending(d)[0] if pending(d) else None)
    if p is None or not p.exists():
        print("no such pending request", file=sys.stderr)
        return 1
    return subprocess.call([os.environ.get("EDITOR", "nvim"), str(p)])


def cmd_path(a) -> int:
    print(store())
    return 0


def cmd_watch(a) -> int:
    seen = set()
    try:
        while True:
            for p in pending(store()):
                if p.stem not in seen:
                    seen.add(p.stem)
                    print(f"{p.stem}\t{question_of(p).splitlines()[0]}", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="agent-inbox")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ask", help="agent side: ask, park, print the reply")
    s.add_argument("question")
    # Default sits under the Bash tool's 120s DEFAULT timeout so a foreground
    # caller fails cleanly. Background callers should pass something much larger.
    s.add_argument("--timeout", type=int, default=110)
    s.add_argument("--quiet", action="store_true")
    s.set_defaults(fn=cmd_ask)

    for name, fn, h in (("list", cmd_list, "operator: pending requests"),
                        ("watch", cmd_watch, "operator: stream new requests"),
                        ("path", cmd_path, "print the store path")):
        sub.add_parser(name, help=h).set_defaults(fn=fn)

    s = sub.add_parser("show", help="operator: print one request")
    s.add_argument("id")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("edit", help="operator: open a request in $EDITOR")
    s.add_argument("id", nargs="?")
    s.set_defaults(fn=cmd_edit)

    s = sub.add_parser("reply", help="operator: interactive reply, no editor")
    s.add_argument("id", nargs="?")
    s.set_defaults(fn=cmd_reply)

    s = sub.add_parser("answer", help="operator: answer non-interactively")
    s.add_argument("id")
    s.add_argument("text")
    s.set_defaults(fn=cmd_answer)

    s = sub.add_parser("listen", help="agent side: park until the operator tells you something")
    # 0 = no timeout. A listener is meant to sit for hours; it must not expire
    # silently, or the agent becomes unreachable while appearing reachable.
    s.add_argument("--timeout", type=int, default=0)
    s.add_argument("--quiet", action="store_true")
    s.set_defaults(fn=cmd_listen)

    s = sub.add_parser("tell", help="operator: send an agent a message unprompted")
    s.add_argument("agent")
    s.add_argument("text")
    s.set_defaults(fn=cmd_tell)

    a = ap.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
