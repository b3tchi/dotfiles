#!/bin/sh
# Target menu in a fullscreen xterm, forever. No creds stored: xrdp shows
# its own login screen, KRDP (NLA) prompts in the xterm.
xset s off -dpms                 # never blank: the remote session is the screen

while :; do
  xterm -fa Monospace -fs 14 -geometry 120x33+0+0 -e /usr/local/bin/rdp-pick
  sleep 1
done
