#!/bin/bash
# edge-cdp — run Windows-host Edge with a CDP port, drive it from WSL.
# Host Edge carries corporate SSO / device compliance; WSL-side Playwright
# attaches with chromium.connectOverCDP(`edge-cdp endpoint`).
# Needs WSL mirrored networking (host 127.0.0.1 == WSL 127.0.0.1).
set -euo pipefail

PORT="${EDGE_CDP_PORT:-9222}"
PROFILE="${EDGE_CDP_PROFILE:-pw-edge}"   # dir name under %LOCALAPPDATA%
EDGE="/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
PS=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
BASE="http://127.0.0.1:$PORT"

usage() {
  cat <<EOF
usage: edge-cdp <command> [args]

  start [url]   launch host Edge with CDP on :$PORT (no-op if already up)
  stop          close the Edge instance using profile '$PROFILE'
  status        print browser version or 'down' (exit 1 when down)
  endpoint      print CDP http endpoint (for connectOverCDP / --cdp-endpoint)
  ws            print browser websocket debugger url
  open <url>    open url in a new tab (starts Edge if needed)
  tabs          list open tabs (title<TAB>url)
  html [match]  print live DOM (outerHTML) of tab whose url/title contains
                match (default: most recently active tab)
  eval <js> [match]  evaluate js in tab, print result (JSON for non-strings)
  devtools [match]   print Edge DevTools URL for tab (needs a Chromium view)
  inspect [match]    open that DevTools in the preview window
  mcp          print Playwright MCP args for this endpoint

env: EDGE_CDP_PORT (default 9222), EDGE_CDP_PROFILE (default pw-edge)
EOF
}

up() { curl -sf --max-time 1 "$BASE/json/version" >/dev/null; }

profile_dir() {
  local lad
  lad=$("$PS" -NoProfile -Command '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')
  printf '%s\\%s' "$lad" "$PROFILE"
}

start() {
  if up; then return 0; fi
  [ -x "$EDGE" ] || { echo "edge-cdp: msedge.exe not found" >&2; exit 1; }
  # Separate user-data-dir required: Chromium refuses the debug port on the
  # default profile. Sign this profile into the work account once.
  # allow-origins: only Edge's own DevTools page (served from this port) may
  # open the CDP websocket — needed by `edge-cdp devtools`. User-approved.
  "$EDGE" --remote-debugging-port="$PORT" --remote-allow-origins="$BASE" \
    --user-data-dir="$(profile_dir)" \
    --no-first-run --no-default-browser-check "${1:-about:blank}" >/dev/null 2>&1 &
  disown
  for _ in $(seq 1 40); do up && return 0; sleep 0.25; done
  echo "edge-cdp: no CDP on :$PORT after 10s (Edge with same profile already running without the flag?)" >&2
  exit 1
}

stop() {
  # Match only processes whose command line carries our profile dir.
  "$PS" -NoProfile -Command "
    Get-CimInstance Win32_Process -Filter \"Name='msedge.exe'\" |
      Where-Object { \$_.CommandLine -like '*--user-data-dir=*\\$PROFILE*' } |
      ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }
  " | tr -d '\r'
  for _ in $(seq 1 20); do up || { echo stopped; return 0; }; sleep 0.25; done
  echo "edge-cdp: still answering on :$PORT" >&2; exit 1
}

json() { python3 -I -c "import json,sys; $1" ; }

# Runtime.evaluate in one tab over its page websocket (node>=22 WebSocket).
page_eval() {
  up || { echo "edge-cdp: down (run: edge-cdp start)" >&2; exit 1; }
  BASE="$BASE" node - "$1" "${2:-}" <<'JS'
const [expr, match] = process.argv.slice(2);
const tabs = (await (await fetch(process.env.BASE + '/json/list')).json())
  .filter(t => t.type === 'page');
const m = match.toLowerCase();
const tab = tabs.find(t => !m || t.url.toLowerCase().includes(m) || t.title.toLowerCase().includes(m));
if (!tab) { console.error(`edge-cdp: no tab matching '${match}'`); process.exit(1); }
const ws = new WebSocket(tab.webSocketDebuggerUrl);
ws.onerror = () => { console.error('edge-cdp: websocket error'); process.exit(1); };
ws.onopen = () => ws.send(JSON.stringify({ id: 1, method: 'Runtime.evaluate',
  params: { expression: expr, returnByValue: true, awaitPromise: true } }));
ws.onmessage = ev => {
  const msg = JSON.parse(ev.data);
  if (msg.id !== 1) return;
  const r = msg.result ?? {};
  if (msg.error || r.exceptionDetails) {
    console.error('edge-cdp:', JSON.stringify(msg.error ?? r.exceptionDetails.exception?.description ?? r.exceptionDetails));
    process.exit(1);
  }
  const v = r.result?.value;
  process.stdout.write((typeof v === 'string' ? v : JSON.stringify(v, null, 2) ?? '') + '\n');
  ws.close(); process.exit(0);
};
JS
}

# DevTools frontend served by Edge itself, attached to the matching tab.
devtools_url() {
  up || { echo "edge-cdp: down (run: edge-cdp start)" >&2; exit 1; }
  curl -s "$BASE/json/list" | M="$1" BASE="$BASE" json '
import os
m, base = os.environ["M"].lower(), os.environ["BASE"]
tabs = [t for t in json.load(sys.stdin) if t["type"] == "page"
        and (not m or m in t["url"].lower() or m in t["title"].lower())]
if not tabs: sys.exit("edge-cdp: no matching tab")
print(base + "/devtools/inspector.html?ws=" + base.split("//")[1] + "/devtools/page/" + tabs[0]["id"])'
}

case "${1:-}" in
  start)   shift; start "${1:-}"; echo "$BASE" ;;
  stop)     stop ;;
  status)   if up; then curl -s "$BASE/json/version" | json 'print(json.load(sys.stdin)["Browser"])'; else echo down; exit 1; fi ;;
  endpoint) echo "$BASE" ;;
  ws)       up || { echo "edge-cdp: down (run: edge-cdp start)" >&2; exit 1; }
            curl -s "$BASE/json/version" | json 'print(json.load(sys.stdin)["webSocketDebuggerUrl"])' ;;
  open)     [ -n "${2:-}" ] || { usage >&2; exit 2; }
            start; curl -sf -X PUT "$BASE/json/new?$2" >/dev/null ;;
  tabs)     up || { echo "edge-cdp: down" >&2; exit 1; }
            curl -s "$BASE/json/list" | json '[print(t["title"]+"\t"+t["url"]) for t in json.load(sys.stdin) if t["type"]=="page"]' ;;
  html)     page_eval 'document.documentElement.outerHTML' "${2:-}" ;;
  eval)     [ -n "${2:-}" ] || { usage >&2; exit 2; }
            page_eval "$2" "${3:-}" ;;
  devtools) devtools_url "${2:-}" ;;
  inspect)  # preview takes file paths: hand it a redirect page.
            f="${XDG_RUNTIME_DIR:-/tmp}/edge-cdp-devtools.html"
            printf '<!doctype html><meta charset="utf-8"><title>Edge DevTools</title><meta http-equiv="refresh" content="0;url=%s">\n' \
              "$(devtools_url "${2:-}")" > "$f"
            preview show "$f" ;;
  mcp)      echo "npx @playwright/mcp@latest --cdp-endpoint $BASE" ;;
  -h|--help|help|"") usage ;;
  *)        usage >&2; exit 2 ;;
esac
