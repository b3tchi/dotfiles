{ pkgs, ... }:
let
  lens = pkgs.callPackage ./lens-lite.nix { };
  state = "/var/lib/lens-lite";
in {
  # lens-lite (tdpr/server): one Go binary on :3030 that speaks the Ondsel Lens
  # API the FreeCAD addon uses. SQLite + git storage, so no Mongo/FerretDB, no
  # Node backend and no web UI. Replaces the former FerretDB + lens-backend +
  # nginx stack (their state dirs /var/lib/private/{ferretdb,lens} are left in
  # place for manual removal).
  systemd.services.lens-lite = {
    description = "lens-lite (Ondsel Lens-compatible server)";
    wantedBy = [ "multi-user.target" ];
    after = [ "network.target" ];
    path = [ pkgs.git pkgs.openssl ];   # gitstore shells out to git
    environment = {
      LENS_LISTEN = ":3030";
      LENS_DATA_DIR = "${state}/data";
      LENS_PUBLIC_URL = "http://revo.lan:3030";   # base of signed download URLs
      LENS_ADMIN_EMAIL = "admin@local.test";
      LENS_SECRETS_FILE = "${state}/secrets.env";
    };
    script = ''
      # Admin password is made once on this host: never in the store or the
      # NAS share. The JWT and signed-URL secrets are generated by lens-lite
      # itself into the data dir (0600).
      if [ ! -f ${state}/secrets.env ]; then
        umask 077
        echo "LENS_ADMIN_PASSWORD=$(openssl rand -hex 12)" > ${state}/secrets.env
      fi
      exec ${lens}/bin/lens-lite
    '';
    serviceConfig = {
      DynamicUser = true;
      StateDirectory = "lens-lite";
      StateDirectoryMode = "0700";
      WorkingDirectory = state;
      Restart = "on-failure";
      RestartSec = 5;
      NoNewPrivileges = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      PrivateTmp = true;
    };
  };

  networking.firewall.allowedTCPPorts = [ 3030 ];
}
