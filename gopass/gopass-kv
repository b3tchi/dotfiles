#!/usr/bin/env bash
# gopass-kv: back gopass entries up to Azure Key Vault, one KV secret per
# entry, and restore them. Run by hand; needs `az login` and the gopass
# passphrase (GOPASS_AGE_PASSWORD or the dotfiles' password file).
#
#   gopass-kv backup  [prefix]           entries -> KV (unchanged ones skipped)
#   gopass-kv restore [prefix] [--force] KV -> gopass (existing kept unless --force)
#   gopass-kv list    [prefix]           backed-up entries in the vault
#
# Config (env wins): GOPASS_KV_VAULT (required), GOPASS_KV_SUBSCRIPTION
# (optional), read from ${XDG_CONFIG_HOME:-~/.config}/gopass-kv/config
# (shell KEY=value lines, linked by the gopass dot).
#
# Naming: gopass path a/b.c -> KV secret "gopass--a--b-c" (KV allows only
# [0-9A-Za-z-]). The exact path is kept in the tag gopass-path, which restore
# reads; a name already holding a different path is refused, not overwritten.
# The full entry (password line, key: value lines, body) is the secret value.
# Key Vault stores it decrypted: anyone with read access to the vault reads it.
# Entries removed from gopass are not removed from the vault.
set -euo pipefail

die() { echo "gopass-kv: $*" >&2; exit 1; }
case "${1:-}" in
    backup|restore|list) ;;
    *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gopass-kv/config"
if [[ -r "$cfg" ]]; then
    env_vault="${GOPASS_KV_VAULT:-}" env_sub="${GOPASS_KV_SUBSCRIPTION:-}"
    # shellcheck source=/dev/null
    . "$cfg"
    [[ -n "$env_vault" ]] && GOPASS_KV_VAULT="$env_vault"
    [[ -n "$env_sub" ]] && GOPASS_KV_SUBSCRIPTION="$env_sub"
fi
vault="${GOPASS_KV_VAULT:-}"
[[ -n "$vault" ]] || die "no vault: set GOPASS_KV_VAULT (env or $cfg)"
kv=(--vault-name "$vault")
[[ -n "${GOPASS_KV_SUBSCRIPTION:-}" ]] && kv+=(--subscription "$GOPASS_KV_SUBSCRIPTION")

export PYTHONWARNINGS=ignore   # az under Python 3.14 prints SyntaxWarnings
command -v az >/dev/null || die "az not found (rotz install azcli)"
command -v jq >/dev/null || die "jq not found"
command -v gopass >/dev/null || die "gopass not found"

# Same passphrase file as the gopass dot / nushell env.nu.
if [[ -z "${GOPASS_AGE_PASSWORD:-}" ]]; then
    if [[ -d /mnt/c ]]; then pw_file="/mnt/c/Users/jbecka/.gopass-age-password"; else pw_file="$HOME/.gopass-age-password"; fi
    if [[ -s "$pw_file" ]]; then GOPASS_AGE_PASSWORD="$(<"$pw_file")"; export GOPASS_AGE_PASSWORD; fi
fi

# Secret values pass through a private tmpfs file, never argv.
umask 077
tmp="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/gopass-kv.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

kv_name() {   # gopass path -> KV secret name
    local p="${1//\//--}"
    p="$(printf '%s' "$p" | tr -c '0-9A-Za-z-' '-')"
    printf 'gopass--%s' "$p"
}

entries() {   # gopass paths under an optional prefix
    gopass ls --flat | { if [[ -n "${1:-}" ]]; then grep -E "^${1%/}(/|$)" || true; else cat; fi; }
}

backed_up() {   # "name<TAB>path" of KV secrets carrying a gopass-path tag
    az keyvault secret list "${kv[@]}" -o json |
        jq -r '.[] | select(.tags["gopass-path"] != null) | [.name, .tags["gopass-path"]] | @tsv' |
        { if [[ -n "${1:-}" ]]; then awk -F'\t' -v p="${1%/}" '$2 == p || index($2, p "/") == 1' ; else cat; fi; }
}

kv_value() {   # KV secret value, exact bytes, into file $2 ("" when missing)
    if ! az keyvault secret show "${kv[@]}" --name "$1" -o json 2>/dev/null | jq -j '.value' > "$2"; then
        : > "$2"; return 1
    fi
}

cmd_backup() {
    local n=0 same=0 path name tag
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        name="$(kv_name "$path")"
        (( ${#name} <= 127 )) || die "$path: KV name too long ($name)"
        gopass show -n -f "$path" > "$tmp/new"
        [[ -s "$tmp/new" ]] || { echo "skip $path (empty)"; continue; }
        if kv_value "$name" "$tmp/old"; then
            tag="$(az keyvault secret show "${kv[@]}" --name "$name" --query 'tags."gopass-path"' -o tsv)"
            [[ "$tag" == "$path" ]] || die "$name already holds '$tag', not '$path' -- rename one of them"
            if cmp -s "$tmp/new" "$tmp/old"; then same=$((same + 1)); continue; fi
        fi
        az keyvault secret set "${kv[@]}" --name "$name" --file "$tmp/new" --encoding utf-8 \
            --content-type gopass --tags "gopass-path=$path" -o none
        echo "saved $path -> $name"
        n=$((n + 1))
    done < <(entries "${1:-}")
    echo "gopass-kv: $n saved, $same unchanged ($vault)"
}

cmd_restore() {
    local prefix="" force=0 n=0 kept=0 name path
    for a in "$@"; do
        case "$a" in --force) force=1 ;; *) prefix="$a" ;; esac
    done
    while IFS=$'\t' read -r name path; do
        [[ -n "$name" ]] || continue
        if (( ! force )) && gopass show -n -f "$path" > "$tmp/cur" 2>/dev/null; then
            kv_value "$name" "$tmp/kv" || die "cannot read $name"
            cmp -s "$tmp/cur" "$tmp/kv" || echo "kept $path (differs from the vault; --force overwrites)"
            kept=$((kept + 1)); continue
        fi
        kv_value "$name" "$tmp/kv" || die "cannot read $name"
        gopass insert -f "$path" < "$tmp/kv" >/dev/null
        echo "restored $path"
        n=$((n + 1))
    done < <(backed_up "$prefix")
    echo "gopass-kv: $n restored, $kept already present ($vault)"
}

cmd_list() { backed_up "${1:-}" | cut -f2; }

case "${1:-}" in
    backup) shift; cmd_backup "$@" ;;
    restore) shift; cmd_restore "$@" ;;
    list) shift; cmd_list "$@" ;;
esac
