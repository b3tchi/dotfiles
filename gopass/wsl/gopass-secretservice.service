[Unit]
Description=gopass-backed org.freedesktop.secrets provider (MSAL token cache)
Documentation=https://specifications.freedesktop.org/secret-service/latest/
After=dbus.socket
Requires=dbus.socket

[Service]
# Type=dbus, not simple: dbus-broker activates this unit on the first
# org.freedesktop.secrets call (see org.freedesktop.secrets.service), and
# systemd must hold the activating client's call until the name is actually
# owned. A canvas MCP server that starts while nothing owns the name checks
# MSAL cache persistence once, fails, and runs cacheless for its whole
# lifetime — one interactive sign-in per server start.
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=%h/.local/bin/gopass-secretservice
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
