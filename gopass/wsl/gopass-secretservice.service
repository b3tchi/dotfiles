[Unit]
Description=gopass-backed org.freedesktop.secrets provider (MSAL token cache)
Documentation=https://specifications.freedesktop.org/secret-service/latest/
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/gopass-secretservice
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
