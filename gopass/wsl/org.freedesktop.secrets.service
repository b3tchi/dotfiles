[D-BUS Service]
# D-Bus activation for the Secret Service name. Without this, libsecret gets
# "The name is not activatable" whenever the daemon happens to be down, and
# MSAL clients (canvas-authoring MCP server) silently lose token persistence
# for their whole run. SystemdService delegates the start to the user unit so
# there is one owner, not a second stray process.
Name=org.freedesktop.secrets
Exec=/home/jan/.local/bin/gopass-secretservice
SystemdService=gopass-secretservice.service
