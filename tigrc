# preview tig with difftastic (git show --ext-diff runs difft)
bind generic @ @sh -c "\
  ( \
    tmux has-session -t '.{last}' \
    && tmux respawn-pane -t '.{last}' -k 'LESS=R git show --ext-diff %(commit)' \
  ) \
  || tmux split-window -l 80% 'LESS=R git show --ext-diff %(commit)'"

