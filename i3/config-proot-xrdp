# i3 config — PROOT/Android entry point (proot Arch under Termux, i3 over
# Xvnc:2 + xrdp).
#
# Named config-proot-xrdp, not config-xrdp: the old name read as "the xrdp
# config" and invited the assumption that the WSL/desktop xrdp :10 session
# uses it. It does not. That session goes through i3/config plus the
# config.d/ platform overlay (ft003 i3-config-layering) like the native one —
# `xrdp` here describes how the PHONE reaches its proot session, not the
# desktop's :10 display.
#
# Shares all bindings/theme from config.common; drops the desktop-only
# autostarts (quickshell/GPU bar, picom compositor, tray applets, xautolock,
# physical-keyboard xinput remap, xborders) that are broken or pointless
# over RDP.
#
# ONE caller, which passes it with -c:
#   scripts/termux/start-xorg-rdp-proot.sh
# (An earlier comment here named a start-i3-xrdp.sh; no such script exists in
# the tree — it was renamed to the above and this line was left behind.)

# Alt is natively Mod1 in the keymap xrdp programs on every (re)connect, so
# $mod=Mod1 makes Alt the modifier with NO xmodmap and survives reconnects.
# (A stuck Super from the client is harmless - Super stays Mod4, not $mod.)
set $mod Mod1
include ~/.dotfiles/i3/config.common

# Narrow the top gap so windows sit closer under the top bar
# (cancels inner+outer at the top edge; other edges keep 4+2).
# Lives here, not in the base: this is the remote viewport's chin offset —
# the desktop entry point deliberately keeps the default top gap.
gaps top -6

# --- remote-safe autostarts -------------------------------------------------
# Plain background (no nitrogen/picom compositor over RDP).
exec --no-startup-id xsetroot -solid "#152024"

# Keyboard: RDP client supplies the layout. Uncomment for dvorak in-session
# (no -device: the physical AT keyboard doesn't exist over RDP).
# exec --no-startup-id setxkbmap us -variant dvorak


# Audio still works via PULSE_SERVER; use $mod+Ctrl+m (alsamixer) to adjust.

# --- quickshell bar + launcher over RDP (replaces rofi + i3bar) -------------
# QT_QUICK_BACKEND=software is REQUIRED: without it quickshell tries GL and
# SEGFAULTS over RDP (no GPU/GL). QS_RDP=1 disables focus border/dim overlays.
# Set here (not just in the start scripts) so the env is applied at exec time —
# a bare `$mod+Shift+r` reload works, not only a full session restart. Runs
# under the session dbus from `dbus-launch i3` (notifications + tray). The
# for_window rules (qs-launcher / qs-projects / notifications) come from the include.
# QS_BAR_INSET_*: session is viewed on the Razr's own screen — draw the bar
# as an inset pill (window margins are Wayland-only, no-op on X11) so the chin
# doesn't sit on it and the rounded display corners don't crop its ends.
# (QS_PHONE is the sxmo/sway device's flag — real margins, Wayland only.)
# More per-session bar knobs (quickshell/config/Common/Session.qml):
#   QS_BAR_HEIGHT=N   QS_BAR_FONT=N   QS_BAR_DENSITY=full|compact|minimal|auto
# Density defaults to auto — tiered from this session's screen width
# (>=1400 full, >=1000 compact, else minimal: sheds NET/HDD then CPU/RAM).
# QS_BAR_INSET_AUTO: the same session may be viewed from the phone (>=2:1
# tall viewport, needs the chin offset) or a monitor client (flush bar) —
# the inset follows the viewport ratio live across reconnects.
set $qsenv env QT_QUICK_BACKEND=software QS_RDP=1 QS_BAR_INSET_BOTTOM=50 QS_BAR_INSET_AUTO=1
bindsym $mod+Return exec --no-startup-id ~/.local/bin/st
exec_always --no-startup-id $qsenv ~/.dotfiles/quickshell/qs-start.sh
bindsym $mod+d exec --no-startup-id $qsenv ~/.dotfiles/quickshell/qs-overlay.sh launcher
bindsym $mod+p exec --no-startup-id $qsenv ~/.dotfiles/quickshell/qs-overlay.sh projects
bindsym $mod+Shift+d --release exec --no-startup-id $qsenv ~/.dotfiles/quickshell/qs-start.sh
# reload + restart the bar in one bind — i3 runs exec_always on restart only,
# so a bare reload leaves the running quickshell on its old QML (see the same
# note in i3/config).
bindsym $mod+Shift+c reload, exec --no-startup-id $qsenv ~/.dotfiles/quickshell/qs-start.sh

# The overlay group (notification browser, clipboard picker) kept HERE when it
# left config.common for the daemon's bind table — sp020, dotfiles-hwds.43. That
# table is hotkeyd/cmd/hotkeyd/config.go, compiled into the binary since
# dotfiles-ylmp.16 (it was hotkeyd/binds.py when the group moved).
#
# This entry point is proot Arch on Android over Termux:X11, and it starts no
# daemon: `hotkeyd.sh start` is autostarted from `config.d/native.conf` /
# `wsl.conf`, and this file includes no config.d overlay at all. So a bind that
# moves to that table simply VANISHES from this session unless it is restated
# here — which is what happened to the screenshot group at dotfiles-hwds.39 and
# is filed as dotfiles-3qd. Restating them costs nothing: with no daemon there
# is no second owner, so nothing double-fires.
#
# Deliberately WITHOUT the `$qsenv` prefix, unlike the four binds above. Those
# LAUNCH quickshell components and need the software-GL env; these two speak to
# the ALREADY-RUNNING instance over its socket (qs-notif.sh / qs-clip.sh derive
# the session themselves), so the env would be inherited noise.
bindsym $mod+n exec --no-startup-id ~/.dotfiles/quickshell/qs-notif.sh toggle
bindsym $mod+v exec --no-startup-id ~/.dotfiles/quickshell/qs-clip.sh toggle
