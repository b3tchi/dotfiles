# i3 config file (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!
#
# THIS FILE IS THE DESKTOP ENTRY POINT, NOT THE KEYMAP.
# Every platform-neutral bind, mode, workspace, colour and for_window rule
# lives in config.common, included below and shared verbatim with the other
# entry point (config-xrdp). What stays here is only what genuinely differs
# per entry point: the $mod source, the platform overlay, the binds that
# depend on an env var or on which terminal/launcher this desktop uses, and
# the autostart execs (the base never execs — ft003 i3-config-layering).
#
# Until this refactor the two entry points carried hand-synced COPIES of
# ~140 identical binds. They had already drifted — config.common mapped
# $mod+Shift+s to `sticky toggle` and carried no region-screenshot bind or
# mode at all — and the drift was being policed by tests asserting
# byte-parity between the files. The include enforces structurally what
# those tests were checking by hand.

# Set mod key (Mod1=<Alt>, Mod4=<Super>) via X resource with fallback —
# i3 include limitation: vars set in included overlays are invisible to
# this main file, so platform mod comes from xrdb (xrdp xinitrc merges
# "i3wm.mod: Mod1"; native loads nothing → Mod4 fallback)
set_from_resource $mod i3wm.mod Mod4

# Platform overlay (ft003 i3-config-layering): rotz links exactly one of
# i3/config.d/{native,wsl}.conf here. Overlay owns all autostart execs + bar;
# base owns keybinds/workspaces/modes/colors and never execs.
#
# An overlay CANNOT hand this file a variable. MEASURED: `set $v ...` in an
# included file then `gaps top $v` here fails byte-identically to a genuinely
# undefined var — i3 scopes variables per file, and include position does not
# change that. (This is the same limitation the $mod note above describes, which
# is why $mod comes from xrdb and not from the overlay.) An earlier version of
# this comment claimed the opposite — that the include sits at top "so overlay
# vars ($term) resolve before binds below" — and planning against it is how the
# entry-point cutover (dotfiles-hwds.33) nearly forked four binds three ways.
# Nothing ever relied on it: $term is set by no file and read by no file.
include ~/.i3/config.d/*.conf

# Shared keymap + look. $mod being set above is the whole requirement:
# config.common uses $mod plus variables it defines itself, and references
# nothing from this file or from the overlay.
include ~/.dotfiles/i3/config.common

# --- entry-point-specific binds ----------------------------------------------
# $mod+Return, $mod+d, $mod+p and $mod+Shift+d USED TO LIVE HERE and are now
# owned by hotkeyd/binds.py (dotfiles-hwds.33). They sat in the entry point
# because their COMMAND differs per session type, and an entry point was the
# only i3 scope that could express that; the daemon expresses it better, since
# it resolves $mod per display and one table then serves :0 and :10 alike.
#
# Do NOT re-add them here. A chord live in both engines double-fires (the X
# server keeps core and XI2 passive grabs in separate conflict domains, so
# nothing raises BadAccess to warn you) — hotkeyd/test_binds.py fails instead.
# Their i3 spelling lives in config.d/zz-fallback-binds.conf, which
# `hotkeyd-panic.sh panic` links in when the daemon has to be stopped.
#
# $mod+Shift+c stays below, deliberately: `reload` is the way back from a bad
# config and must not sit behind the daemon.

# qs bar env. MUST precede every use: i3 substitutes a variable only in lines
# parsed AFTER its `set`, and leaves an earlier `$qsbarenv` in the string
# verbatim — which `sh` then expands to nothing, silently dropping the env
# rather than failing. Used by the exec_always further down, which documents
# the knobs; the values are documented in quickshell/config/Common/Session.qml.
set $qsbarenv env QS_BAR_INSET_BOTTOM=50 QS_BAR_INSET_AUTO=1

# Plain i3 restart — re-execs i3 in place, preserving the layout, which is the
# one thing `reload` cannot do.
#
# This chord used to be `reload, exec ... qs-start.sh`. Both halves of that are
# now in the $mod+Shift+r hammer (config.common), which reloads AND restarts
# the bar AND the daemon, so keeping a second partial version of it here would
# be a chord that does almost the same thing for no reason. Plain `restart` had
# been on $mod+Ctrl+Shift+r, which panic now holds.
#
# i3 runs exec_always on RESTART only — a plain `reload` re-reads the config and
# leaves every exec_always process untouched (verified empirically: exec_always
# ran once at start, still once after reload, twice after restart). That is why
# the hammer restarts the bar explicitly rather than trusting `reload` to.
bindsym $mod+Shift+c restart

# --- autostarts (the base never execs) ---------------------------------------

# PrusaSlicer: trim version from title ("*file - PrusaSlicer-2.8.1 based on Slic3r" → "*file - PrusaSlicer")
exec_always --no-startup-id pkill -f qs-title-trim; ~/.i3/scripts/qs-title-trim.sh &

# quickshell bar + overlay — all platforms (kill+restart on every reload).
# This config also serves xrdp sessions (same machine, DISPLAY :10+); the
# INSET_AUTO pair draws the chin-offset pill only while the viewport is
# phone-shaped (>=2:1 tall, e.g. Razr client), flush bar otherwise —
# reactive across reconnects. ($qsbarenv defined just above; knobs
# documented in quickshell/config/Common/Session.qml.)
exec_always --no-startup-id $qsbarenv ~/.dotfiles/quickshell/qs-start.sh
# Focus border handled by quickshell (config/FocusBorder.qml);
# clean up legacy xborders fallback
exec_always pkill -f xborders-patched; pkill -x xborders

# Clipboard sync — bridge PRIMARY (mouse-select) <-> CLIPBOARD so terminal
# selections paste into apps that read CLIPBOARD (Claude Code, Ctrl+Shift+V).
# All X11 i3 platforms (native, proot, WSL-i3).
exec_always --no-startup-id pkill -x autocutsel; autocutsel -fork
exec_always --no-startup-id autocutsel -selection PRIMARY -fork

# Other autostarts (wallpaper, compositor, tray apps, lockscreen, keyboard
# layout) live in the platform overlay → config.d/native.conf
# (quickshell task-switcher nop grabs live in overlays — $mod differs)
