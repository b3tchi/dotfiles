#!/bin/sh
# newspaper: launcher shim on PATH (~/.local/bin/newspaper, linked by rotz).
# Sets the gopass prefix of the Inoreader credentials, then runs the app's own
# launcher from the release checkout the dot installs. Any launcher (WM key,
# quickshell overlay, .desktop entry, shell) gets the same environment.
#   NEWSPAPER_GOPASS  gopass dir holding client-id, client-secret,
#                     redirect-uri, refresh-token (default: nextcloud)
: "${NEWSPAPER_GOPASS:=nextcloud}"
export NEWSPAPER_GOPASS
app="$HOME/.local/src/newspaper/newspaper"
if [ ! -x "$app" ]; then
    echo "newspaper: $app missing -- run 'rotz install newspaper'." >&2
    exit 1
fi
exec "$app" "$@"
