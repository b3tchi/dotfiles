#!/bin/sh
# spreadsheet - THE LibreOffice entry point: no args opens Calc ($mod+d lists
# $PATH bins), args (files, --writer, ...) go to LibreOffice as given.
# Everything funnels here: ~/.local/bin/{libreoffice,soffice} shims,
# spreadsheet.desktop (default app for every LibreOffice MIME type) and the
# WSL xdg-open bridge - so every document gets the env below.
# WSL: force X11 so GTK does not auto-connect to WSLg's wayland-0 symlink in
# $XDG_RUNTIME_DIR and open on the Windows desktop instead of the xrdp
# session (same fix as xrdp/xinitrc; repeated here because the launcher runs
# bins with quickshell's env, which may predate that export).
if [ -d /mnt/wslg ] && [ -n "$DISPLAY" ]; then
    unset WAYLAND_DISPLAY
    export GDK_BACKEND=x11
fi
# LibreOffice-only GTK theme (dark, kwi3 font) written by kwi3-theme.
if [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/themes/kwi3-libreoffice/gtk-3.0/gtk.css" ]; then
    export GTK_THEME=kwi3-libreoffice
fi
# kwi3 text-size env (SAL_FORCEDPI: 10pt document text = kwi3 px, same as
# the UI) written by kwi3-theme.
lo_env="${XDG_CONFIG_HOME:-$HOME/.config}/libreoffice/kwi3.env"
if [ -f "$lo_env" ]; then
    set -a; . "$lo_env"; set +a
fi
# Absolute path: ~/.local/bin/libreoffice is a shim back to this script.
if [ $# -eq 0 ]; then
    exec /usr/bin/libreoffice --calc
fi
exec /usr/bin/libreoffice "$@"
