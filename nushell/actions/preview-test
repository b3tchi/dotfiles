    # Dependency-free stand-in for preview-d: the websocket priming frame
    # PreviewView needs to show anything at all, plus /file/<name>.
    let stub_src = r#'
import base64, hashlib, socket, sys, threading, time

GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

def text_frame(payload):
    b = payload.encode()
    return bytes([0x81, len(b)]) + b

def serve(conn, svg, path):
    try:
        conn.settimeout(15)
        data = b""
        while b"\r\n\r\n" not in data:
            chunk = conn.recv(4096)
            if not chunk:
                return
            data += chunk
        head = data.split(b"\r\n\r\n", 1)[0].decode("latin1")
        lines = head.split("\r\n")
        target = lines[0].split(" ")[1] if " " in lines[0] else "/"
        hdrs = {}
        for ln in lines[1:]:
            if ":" in ln:
                k, v = ln.split(":", 1)
                hdrs[k.strip().lower()] = v.strip()
        if "websocket" in hdrs.get("upgrade", "").lower():
            key = hdrs.get("sec-websocket-key", "").encode()
            acc = base64.b64encode(hashlib.sha1(key + GUID).digest())
            conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n"
                         b"Connection: Upgrade\r\nSec-WebSocket-Accept: " + acc + b"\r\n\r\n")
            conn.sendall(text_frame('{"path":"%s","type":"svg"}' % path))
            conn.settimeout(None)
            while conn.recv(4096):
                pass
            return
        # The Image fetch carries the cache-busting token, the viewBox XHR
        # does not. Delaying only the XHR pins the bootstrap race so an
        # ungated Image is guaranteed to have decoded at the declared size
        # by the time the natural size lands.
        if target.startswith("/file/") and "v=" not in target:
            time.sleep(0.4)
        ok = target.startswith("/file/")
        body = svg if ok else b"not found"
        status = b"200 OK" if ok else b"404 Not Found"
        conn.sendall(b"HTTP/1.1 " + status + b"\r\nContent-Type: image/svg+xml\r\nContent-Length: "
                     + str(len(body)).encode() + b"\r\nConnection: close\r\n\r\n" + body)
    except Exception:
        pass
    finally:
        try:
            conn.close()
        except Exception:
            pass

port = int(sys.argv[1])
svg = open(sys.argv[2], "rb").read()
path = sys.argv[3]
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", port))
s.listen(16)
print("ready", flush=True)
while True:
    c, _ = s.accept()
    threading.Thread(target=serve, args=(c, svg, path), daemon=True).start()
'#
