    if ($texts.other | str contains "QTWEBENGINE_CHROMIUM_FLAGS") {
        print $"FAIL: test 33: a non-OOM give-up must NOT blame the memory ceiling — got: ($texts.other)"
        exit 1
    }
    print $"PASS: crash policy table-tested against the real CrashPolicy.js \(($policy_cases | length) cases, pure\)"
    $policy_tested = true
} else {
    print "SKIP: test 33 (web tier crash policy) needs a real qml6 — the reducer is pure, but faking the engine that runs it would test nothing."
}

^rm -rf $tmp
print ""
let skipped = ([
    (if $svg_decode_tested { null } else { "32 needs qml6 + python3" })
    (if $policy_tested { null } else { "33 needs qml6" })
] | compact)
if ($skipped | is-empty) {
    print "PASS: 33 tests passed"
} else {
    print $"PASS: (33 - ($skipped | length)) tests passed \(($skipped | length) skipped: ($skipped | str join '; ')\)"
}

