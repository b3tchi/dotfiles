# ── test 31: spawn-env-prefix — swiftshader WebGL + the memory ceiling ─────
#
# dotfiles-14kr. Measured on a real xorgxrdp session: the Qt software-GL pair
# alone is NOT enough for the web tier — QtWebEngine's Chromium GPU stack
# blocklists WebGL independently, so the stl tier fails ("WebGL1/WebGL2
# blocklisted") both with and without that pair. Only the Chromium
# swiftshader flags fix it. This asserts the prefix carries all three on
# xorgxrdp, and defers to a caller who already set
# QTWEBENGINE_CHROMIUM_FLAGS.
#
# dotfiles-j5kq / sp022 T10 adds the second half: the Chromium memory
# ceiling (--js-flags=--max-old-space-size=...) must reach EVERY display, not
# just xorgxrdp, because V8 derives its old-space limit from host RAM and not
# from the display server. So a native display no longer gets an empty prefix
# — it gets the ceiling and nothing else. want_flags/forbid_flags per case is
# what keeps the two concerns from being conflated again.

let env_prefix_cases = [
    {desc: "native display gets the memory ceiling and no GL overrides",
     xrdp: false, caller: "", want_qt: false, want_chromium: true,
     want_flags: ["--js-flags=--max-old-space-size="],
     forbid_flags: ["--use-angle=swiftshader" "--enable-unsafe-swiftshader"],
     want_non_js_tokens: []},
    {desc: "native display ignores a caller's chromium flags",
     xrdp: false, caller: "--use-gl=egl", want_qt: false, want_chromium: false,
     want_flags: [], forbid_flags: [], want_non_js_tokens: []},
    {desc: "xorgxrdp gets the Qt software-GL pair, the swiftshader flags AND the ceiling",
     xrdp: true, caller: "", want_qt: true, want_chromium: true,
     want_flags: ["--enable-unsafe-swiftshader" "--use-gl=angle" "--use-angle=swiftshader"
                  "--disable-gpu-compositing" "--js-flags=--max-old-space-size="],
     forbid_flags: [],
     want_non_js_tokens: ["--enable-unsafe-swiftshader" "--use-gl=angle"
                          "--use-angle=swiftshader" "--disable-gpu-compositing"]},
    {desc: "xorgxrdp defers to a caller-set QTWEBENGINE_CHROMIUM_FLAGS (ceiling included)",
     xrdp: true, caller: "--use-gl=egl", want_qt: true, want_chromium: false,
     want_flags: [], forbid_flags: [], want_non_js_tokens: []},
]

for case in $env_prefix_cases {
    let got = (spawn-env-prefix $case.xrdp $case.caller)
    let has_backend = ($got | str contains "QT_QUICK_BACKEND=software")
    let has_libgl = ($got | str contains "LIBGL_ALWAYS_SOFTWARE=1")
    if $has_backend != $case.want_qt or $has_libgl != $case.want_qt {
        print $"FAIL: spawn-env-prefix \(($case.desc)\): Qt software-GL pair present=($has_backend)/($has_libgl), want ($case.want_qt) — got: ($got)"
        exit 1
    }
    let has_chromium = ($got | str contains "QTWEBENGINE_CHROMIUM_FLAGS=")
    if $has_chromium != $case.want_chromium {
        print $"FAIL: spawn-env-prefix \(($case.desc)\): QTWEBENGINE_CHROMIUM_FLAGS present=($has_chromium), want ($case.want_chromium) — got: ($got)"
        exit 1
    }
    for flag in $case.want_flags {
        if not ($got | str contains $flag) {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): missing chromium flag ($flag) — got: ($got)"
            exit 1
        }
    }
    for flag in $case.forbid_flags {
        if ($got | str contains $flag) {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): must NOT carry ($flag) — got: ($got)"
            exit 1
        }
    }
    if $has_chromium {
        # Quoting that survives interpolation into window-spawn's `bash -c`
        # line (the xrdp value has spaces — unquoted, bash would read the
        # flags after the first as a command, not as part of the assignment).
        if not ($got | str contains "QTWEBENGINE_CHROMIUM_FLAGS='") {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): multi-word flag value must be quoted for `bash -c` — got: ($got)"
            exit 1
        }
        # QtWebEngine splits QTWEBENGINE_CHROMIUM_FLAGS on whitespace with no
        # quote handling, so whatever V8 gets is ONE whitespace-delimited
        # token and nothing more (dotfiles-j5kq). Asserting "exactly one
        # token starts with --js-flags=" does NOT test that — a value written
        # `--js-flags=--max-old-space-size=256 --trace-gc` still has exactly
        # one such token while V8 silently receives only the first flag
        # (mutation-verified: that assertion accepted it).
        #
        # What does test it is decomposing the value the way QtWebEngine
        # will and demanding the token multiset be EXACTLY what this case
        # expects: any word the author meant to be part of the --js-flags
        # value but wrote after a space shows up here as a stray token with
        # nowhere to belong.
        let value = ($got | parse --regex "QTWEBENGINE_CHROMIUM_FLAGS='(?<v>[^']*)'" | get v.0)
        let tokens = ($value | split row " " | where {|t| $t | is-not-empty })
        let js_tokens = ($tokens | where {|t| $t | str starts-with "--js-flags=" })
        let non_js_tokens = ($tokens | where {|t| not ($t | str starts-with "--js-flags=") })
        if ($js_tokens | length) != 1 {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): want exactly one --js-flags token, got ($js_tokens | length) — value: ($value)"
            exit 1
        }
        # The one token V8 actually receives must be a complete V8 flag on
        # its own — not a truncated head of a longer intended value.
        if not ($js_tokens.0 =~ '^--js-flags=--max-old-space-size=[0-9]+$') {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): the single --js-flags token V8 receives must be a complete --max-old-space-size=<N> flag, got ($js_tokens.0) — value: ($value)"
            exit 1
        }
        if ($non_js_tokens | sort) != ($case.want_non_js_tokens | sort) {
            print $"FAIL: spawn-env-prefix \(($case.desc)\): chromium flag tokens are not exactly the expected set — got ($non_js_tokens | sort), want ($case.want_non_js_tokens | sort). A stray token here usually means a whitespace crept into the --js-flags value, which QtWebEngine's whitespace split silently drops. value: ($value)"
            exit 1
        }
    }
    # The prefix is concatenated straight onto the launch line, so a
    # non-empty prefix must end in a separator.
    if ($got | is-not-empty) and not ($got | str ends-with " ") {
        print $"FAIL: spawn-env-prefix \(($case.desc)\): non-empty prefix must end with a space — got: ($got)"
        exit 1
    }
}
print $"PASS: spawn-env-prefix table-tested \(($env_prefix_cases | length) cases\)"

# ── test 32: the svg tier never decodes at the document's declared size ─────
#
# dotfiles-63rd (sp022 T11). PreviewView's svg delegate learns the diagram's
# natural size from the document's own viewBox, fetched by an XHR that races
# the PannableStage Image's own fetch of the same url. Lose that race and the
# Image goes out with sourceSize 0 — "no override", i.e. the size the svg
# document declares — and the resulting full-resolution ARGB raster is
# RETAINED for the life of the process. Measured on a real xorgxrdp session
# (own :31, i3 4.25.1, web tier never instantiated, nchild=0 at all 120
# checkpoints): pic.png <-> diagram.d2 x60 grew the qml6 process
# 101,992 kB -> 579,234 kB, entirely in anonymous mmap, in units of exactly
# 21,504 kB = one 728x7561x4 B raster, one per full-resolution decode.
#
# This is the unit-scale guard for that: run the REAL PreviewView.qml
# offscreen against a stub daemon serving a tall svg, and assert Qt's own
# qt.quick.image log never reports a decode at the document's declared size.
#
# Three things make it a test rather than a coin flip:
#   * the stub DELAYS the viewBox XHR (the bare `?native` GET) while
#     answering the Image's `?native&v=<token>` GET immediately, so the
#     losing side of the race is deterministic. Verified against the
#     pre-fix file: it logs `-> scSize QSize(1000, 9000)` and this test
#     fails; the fixed file logs only `-> scSize QSize(93, 834)`. Without
#     the delay BOTH files pass — checked, and that is the tautology this
#     paragraph exists to stop anyone reintroducing.
#   * it demands at least one decode line, so a client that rendered
#     nothing at all (a 404ing tier, a crashed engine) fails instead of
#     vacuously passing.
#   * it drives the real file, not a copy — no assertion about source text.
#
# Requires a real qml6 and python3. Both absent is a SKIP, printed loudly
# and subtracted from the final count — never a silent pass.
let qml6_bin = (do { ^bash -c "command -v qml6" } | complete)
let py_bin = (do { ^bash -c "command -v python3" } | complete)
mut svg_decode_tested = false

if $qml6_bin.exit_code == 0 and $py_bin.exit_code == 0 {
    let qml_view = $QML_VIEW
    if not ($qml_view | path exists) {
        print $"FAIL: test 32 cannot find the real PreviewView.qml at ($qml_view)"
        exit 1
    }

    # A tall svg with an unambiguous declared size. 1000x9000 is far larger
    # than any on-screen fit, so "decoded at the declared size" and "decoded
    # at the on-screen size" can never be confused for one another.
    let decl_w = 1000
    let decl_h = 9000
    let svg_body = (1..60 | each {|i|
        let y = (20 + $i * 150)
        $'<rect x="60" y="($y)" width="880" height="100" fill="#dde6ff" stroke="#334466" stroke-width="3"/><text x="500" y="($y + 60)" font-size="40" fill="#112233">node ($i)</text>'
    } | str join "")
    let svg_file = $"($tmp)/tall-fixture.svg"
    ($'<?xml version="1.0" encoding="utf-8"?><svg width="($decl_w)" height="($decl_h)" viewBox="0 0 ($decl_w) ($decl_h)" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="($decl_w)" height="($decl_h)" fill="#ffffff"/>($svg_body)</svg>'
