#!/usr/bin/env nu
# preview-test — scripted test for the preview wrapper (akm-graph-test /
# d2-router-test pattern)
#
# Tests:
#   1. Idempotent lifecycle: start → start (no-op) → status → stop → status,
#      against a fake preview-d that serves a minimal /status + /stop.
#   2. Stale pidfile: bogus dead pid → cleaned + relaunch.
#   3. Missing binary → error names "rotz install preview".
#   4. `preview status` against a stopped daemon returns a clean
#      "not running" message (not a stack trace) — sp008 Task 1 test_plan.
#   5. `preview send <path> --window N` POSTs {"path": <path>} to
#      /preview<N> — sp008 Task 5 test_plan.
#   6. `preview send <path>` with no --window defaults to window 1 (sp008
#      Task 5 success criteria: "pick a sane default").
#   7. `preview register <addr>` POSTs {"nvim": <addr>} to /register and
#      prints the slot parsed from the daemon's {"slot": N} response —
#      sp009 Task 3 test_plan ("wrapper test: `preview register` posts the
#      addr and parses `slot` from the response").
#   8. `preview register <addr> --slot N` includes {"slot": N} in the
#      request body (the plugin's idempotent-rebind path, sp009 Task 3).
#   9. `preview start` blocks until the daemon answers /status, so a
#      register fired immediately after start (nvim :PreviewStart's exact
#      sequence) cannot hit connection-refused (dotfiles-nbt).
#
# sp013 Task 2 (wrapper `window` verb + stop integration), against a fake
# qml6 (sleep stub on the same temp PATH as the fake preview-d — sp022 T6
# replaced the preview-wv engine with `qml6 PreviewView.qml -- <N> <port>`,
# so the stub now stands in for qml6, not preview-wv):
#  10. `preview window` (default N=1) spawns the stub detached, passing
#      `<qml-path> -- 1 <port>`, and writes wv-1.pid.
#  11. A second `preview window` call is an idempotent no-op (same pid).
#  12. A stale pidfile (dead pid) is cleaned up and the window respawned.
#  13. A recycled pid (alive, but /proc/<pid>/cmdline carries no
#      PreviewView.qml argument) is treated as stale and respawned WITHOUT
#      ever signaling the foreign process (asserted alive after the call)
#      — the sp013 plan's ship-blocker anti-pattern, now enforced by the
#      sp022 T6 exact-argument check.
#  14. `preview window --close` SIGTERMs the cmdline-verified stub and
#      removes the pidfile.
#  15. A second `--close` is an idempotent clean no-op message.
#  16. `--close` on a window that was never opened is a clean message,
#      exit 0.
#  17. `preview stop` closes every open wv-*.pid window before it touches
#      the daemon.
#  18. Missing qml6 binary → error names the qt packages.
#  19. Daemon not answering /status → error names "preview start".
#  20. register captures the focused workspace and does not leak I3SOCK
#      (dotfiles-816) — carried over unchanged.
#  21. window places the spawned window on its slot's recorded workspace,
#      now via a pid-resolved `[id=…]` i3 criterion (sp022 T6 success
#      criteria: window resolution is pid-based everywhere class matching
#      lived; no `class="preview-wv"` reference remains).
#  22. NEEDLE (## problem regression): a live slot-2 qml6 process (cmdline
#      `... -- 2 <port>`) does NOT validate slot 1's pidfile (mismatched
#      slot number) — slot 1 is treated as stale and respawned — but DOES
#      validate slot 2's own pidfile as a no-op. Proves the identity check
#      keys on the exact slot argument, not the shared daemon port (every
#      slot's cmdline carries the same port).
#  23. `is-xrdp-display` table-tested directly (module `use`, no /proc) —
#      xrdp Xorg on the exact display token, native display alongside an
#      xrdp one, no Xorg at all (sway), empty DISPLAY, and the ":10" vs
#      ":100" token-boundary case (mirrors preview-webview's own
#      is_xrdp_display unit tests).
#
# sp022 T7 (docking collapse + live re-dock, dotfiles-zw0d.7) — the OLD
# prepare-split/wait-preview-mapped/finalize-dock choreography is replaced by
# a mark+move-to-mark recipe run on the PREVIEW window itself, which now
# survives being moved after it maps ([[poc016]]):
#  24. The deleted helpers (prepare-split, wait-preview-mapped, finalize-dock,
#      window-open) are actually gone from the wrapper source, not just
#      unreferenced.
#  25. `show` docks a FRESH landscape image TOP: `[id=<orig>] mark <mark>`
#      then `[id=<preview-xid>] move container to mark <mark>` + `move up`.
#  26. `show` RE-DOCKS the SAME live window (identical pid, identical
#      resolved criterion) from a second call with portrait dims — LEFT
#      instead of top — the "docks only on first open" limitation removed.
#  27. `window` docks a FRESH window to the right via the same mechanism,
#      with no `move left`/`move up` reorder (right/below's default
#      insertion order is already correct).
#  28. No WM on PATH at all -> `window` still spawns, no error, dock
#      silently skipped (Termux/headless stance).
#  29. WM present but no xdotool on PATH -> same spawn-only degrade, with a
#      clear "skipping dock" log line.
#  30. A window that never maps (crashed qml6, simulated via a poisoned
#      `xdotool search --pid`) leaves a clear "never mapped" log line within
#      the bounded poll, and never touches the launching frame at all.
#
# dotfiles-14kr (xorgxrdp web-tier WebGL):
#  31. `spawn-env-prefix` table-tested directly (module `use`, no real Xorg)
#      — a native display gets the Chromium memory ceiling but no GL
#      overrides; xorgxrdp gets the Qt software-GL pair AND the Chromium
#      swiftshader flags the web tier needs for WebGL there AND the same
#      ceiling; a caller-set QTWEBENGINE_CHROMIUM_FLAGS is left alone; the
#      multi-word flag value stays quoted for the `bash -c` launch line and
#      --js-flags stays a single whitespace-free token.
#
# dotfiles-63rd (sp022 T11, the svg tier's retained rasters):
#  32. The REAL PreviewView.qml, run offscreen against a stub daemon that
#      pins the viewBox-vs-Image race, never decodes a tall svg at the size
#      the document itself declares — the decode whose raster the qml6
#      process retains forever. Needs a real qml6 + python3; skips loudly
#      (and says so in the final count) when they are absent.
#
# dotfiles-f532 (the web tier's crash guard):
#  33. The REAL preview/qml/CrashPolicy.js — the pure reducer WebTier.qml
#      delegates its "renderer died, now what?" decision to — table-tested
#      through qml6 over event sequences no wall-clock test could produce
#      cheaply: a slow OOM loop that satisfies probation before every crash,
#      four external kills 14 s apart that must ALL recover, the lifetime cap
#      that bounds a loop even if the OOM classification stops matching.
#      Needs a real qml6; skips loudly (and says so in the final count).
#
# Run:  nu nushell/actions/preview-test
# Pass: exits 0 and prints "PASS: N tests passed"
# Fail: exits 1 and prints "FAIL: <description>"

# Self-locate the wrapper relative to this test so it survives merging out
# of the author's worktree (no hardcoded paths).
const WRAPPER = (path self | path dirname | path join "preview")
# The real QML client, resolved the same self-locating way (test 32 drives
# it for real). `path self` is parse-time only, hence a const up here rather
# than a let at the point of use.
const QML_VIEW = (path self | path dirname | path dirname | path dirname
    | path join "preview" "qml" "PreviewView.qml")
# The web tier's crash-decision seam (test 33 drives this exact file, not a
# copy of it — dotfiles-f532).
const CRASH_POLICY = (path self | path dirname | path dirname | path dirname
    | path join "preview" "qml" "CrashPolicy.js")

# sp022 T6 test_plan: "factor detection into a testable helper taking the
# cmdline list ... and table-test it" — is-xrdp-display is exported from
# the wrapper (a plain `.nu` file, `use`able for its non-main defs) so it
# can be called directly here with fabricated /proc-style cmdline lists,
# no real Xorg or /proc required.
use $WRAPPER is-xrdp-display
# dotfiles-14kr: the launch-line env prefix is factored out for the same
# reason — table-testable without a real xorgxrdp Xorg.
use $WRAPPER spawn-env-prefix

# ── setup ─────────────────────────────────────────────────────────────────────

let tmp = (^mktemp -d | str trim)
let fake_bin_dir = $"($tmp)/bin"
let cache_dir = $"($tmp)/.cache/preview"
let pid_file = $"($cache_dir)/pid"
let fake_daemon = $"($fake_bin_dir)/preview-d"
let launched_marker = $"($tmp)/daemon_launched"

^mkdir -p $fake_bin_dir
^mkdir -p $cache_dir

# window-spawn resolves the QML view via akm-root, falling back to
# ~/.dotfiles. The test's isolated PATH carries no akm-root, and HOME is
# pinned to $tmp below, so every window-spawn call in this file resolves
# through the ~/.dotfiles fallback to this fake repo layout — exercising
# that fallback path for free on every test, plus the two tests below that
# specifically assert the "missing QML file" and "akm-root present" shapes.
let fake_dotfiles_qml_dir = $"($tmp)/.dotfiles/preview/qml"
let fake_qml_file = $"($fake_dotfiles_qml_dir)/PreviewView.qml"
^mkdir -p $fake_dotfiles_qml_dir
"// fake PreviewView.qml for preview-test" | save --force $fake_qml_file

# Test port far from the 4200 default and common services.
let test_port = "58920"
let test_path = ([$fake_bin_dir "/usr/local/bin" "/usr/bin" "/bin" "/sbin"] | str join ":")

# Fake preview-d: a tiny python HTTP server answering GET /status and
# POST /stop (exits on stop), plus POST /preview<N> which captures the
# request path + body to $CAPTURE_FILE (sp008 Task 5 test_plan: assert the
# `send` verb's POST against a stub server capturing the body). Records
# that it was launched.
let fake_src = "#!/bin/bash
touch " + $launched_marker + "
exec python3 - \"$@\" <<'PY'
import sys, os, json, time
from http.server import BaseHTTPRequestHandler, HTTPServer
time.sleep(float(os.environ.get('STARTUP_DELAY', '0')))
port = int(os.environ.get('PREVIEW_PORT', '4200'))
capture_file = os.environ.get('CAPTURE_FILE', '')
# Echo the daemon's OWN --root argument in /status (sp022 T7: main-show's
# ensure-daemon-slash restarts the daemon whenever the reported root isn't
# "/" — a hardcoded '/fake' here would make EVERY `show` call restart the
# daemon and close-all-windows, killing the very window a redock test is
# trying to keep alive across two calls). Falls back to '/fake' if --root
# is somehow absent, matching the old constant for any caller that never
# passes it.
root = '/fake'
argv = sys.argv[1:]
if '--root' in argv:
    i = argv.index('--root')
    if i + 1 < len(argv):
        root = argv[i + 1]
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        if self.path == '/slots':
            body = json.dumps([{'slot': 1, 'nvim': '/tmp/nvim.fake.sock',
                                'workspace': 'editor-ws', 'path': ''}]).encode()
            self.send_response(200); self.send_header('Content-Type','application/json')
            self.send_header('Content-Length', str(len(body))); self.end_headers()
            self.wfile.write(body)
        elif self.path == '/status':
            body = json.dumps({'pid': os.getpid(), 'root': root,
                               'port': str(port),
                               'started_at': '2026-01-01T00:00:00Z'}).encode()
            self.send_response(200); self.send_header('Content-Type','application/json')
            self.send_header('Content-Length', str(len(body))); self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404); self.end_headers()
    def do_POST(self):
        if self.path == '/stop':
            self.send_response(200); self.send_header('Content-Length','0'); self.end_headers()
            def die(): os._exit(0)
            import threading; threading.Timer(0.1, die).start()
        elif self.path.startswith('/preview') and capture_file:
            length = int(self.headers.get('Content-Length', 0))
            raw = self.rfile.read(length)
            with open(capture_file, 'w') as f:
                f.write(self.path + '\\n' + raw.decode())
            resp = raw if raw else b'{}'
            self.send_response(200); self.send_header('Content-Type','application/json')
            self.send_header('Content-Length', str(len(resp))); self.end_headers()
            self.wfile.write(resp)
        elif self.path == '/register':
            length = int(self.headers.get('Content-Length', 0))
            raw = self.rfile.read(length)
            if capture_file:
                with open(capture_file, 'w') as f:
                    f.write(self.path + '\\n' + raw.decode())
            data = json.loads(raw.decode()) if raw else {}
            slot = data.get('slot', 7)
            body = json.dumps({'slot': slot}).encode()
            self.send_response(200); self.send_header('Content-Type','application/json')
            self.send_header('Content-Length', str(len(body))); self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404); self.end_headers()
HTTPServer(('127.0.0.1', port), H).serve_forever()
PY
"
$fake_src | save --force $fake_daemon
^chmod +x $fake_daemon

# Fake qml6 (sp022 T6 test_plan: "fake qml6, sleep stub echoing its args to
# a file, temp-PATH pattern" — replaces the sp013 fake preview-wv now that
# window-spawn launches `qml6 <qml-path> -- <N> <port>`). Records every
# invocation's args (so spawn tests can assert the qml path + N/port it was
# launched with) and then sleeps until it's SIGTERMed — no `exec`, so the
# recorded pid stays the pid of *this bash script*, not of the `sleep` it
# spawns as a plain child. Verified empirically (poc016's setsid/backgrounding
# trap): the kernel's #!/bin/bash shebang rewrite makes this script's own
# /proc/<pid>/cmdline read `/bin/bash <resolved-script-path> <qml-path> -- <N>
# <port>` — the qml-path and N/port arguments survive as distinct cmdline
# elements exactly as if a real qml6 had received them, which is what makes
# the exact-argument identity check (window-cmdline-matches) testable against
# this stub at all.
let fake_qml6 = $"($fake_bin_dir)/qml6"
let qml6_calls_file = $"($tmp)/qml6_calls"
let fake_qml6_src = "#!/bin/bash
echo \"$@\" >> " + $qml6_calls_file + "
trap 'kill $! 2>/dev/null; exit 0' TERM
sleep 3600 &
wait
"
$fake_qml6_src | save --force $fake_qml6
^chmod +x $fake_qml6

# Fake i3-msg (dotfiles-816): answers `-t get_workspaces` with a focused
# workspace and records every other invocation's argv, so tests can assert
# BOTH halves of the placement path — that `register` captured the focused
# workspace, and that `window` issued the move command for the right slot.
# It also asserts the wrapper unset I3SOCK before calling: a stale inherited
# I3SOCK points at another session's WM and would paint the window on the
# wrong screen (see the quickshell-session-model memory).
let fake_i3 = $"($fake_bin_dir)/i3-msg"
let i3_calls_file = $"($tmp)/i3_calls"
let fake_i3_src = "#!/bin/bash
if [ -n \"$I3SOCK\" ]; then echo \"LEAKED_I3SOCK=$I3SOCK\" >> " + $i3_calls_file + "; fi
if [ \"$1\" = \"-t\" ] && [ \"$2\" = \"get_workspaces\" ]; then
  echo '[{\"name\":\"other\",\"focused\":false},{\"name\":\"dotfiles\",\"focused\":true}]'
  exit 0
fi
echo \"$@\" >> " + $i3_calls_file + "
# Real i3-msg answers a move with a JSON body carrying success. The wrapper
# MUST read this, not the exit code: i3-msg exits 0 even when the criteria
# matched nothing (\"success\": false, \"Nothing to move\"), which is how
# placement first shipped silently broken. A stub that only exits 0 cannot
# tell a landed move from a no-op — so it answers success only once the
# window's pidfile exists, standing in for the window being mapped.
echo '[{\"success\":true}]'
exit 0
"
$fake_i3_src | save --force $fake_i3
^chmod +x $fake_i3

# Fake xdotool (sp022 T6/T7): place-window's and window-criteria's i3 path
# resolve a window's X11 id via `xdotool search --pid <pid>` before building
# `[id=…]` criteria (i3 has no native pid-match criteria — verified directly
# against real i3 4.25.1 in dotfiles-zw0d.7's task notes: `[pid=N]` is a
# parse error there — unlike sway's native `[pid=…]`). This sandbox has no
# real X session behind the fake i3-msg, so `search --pid` is stubbed to
# deterministically derive a fake numeric xid from the pid (prefixed "9" so
# it's never empty/zero) — anything else exits nonzero, degrading exactly
# like the real binary would with no display (best-effort, never fatal).
#
# T7 adds two MORE branches, both gated behind env vars that default absent
# — existing tests never set them, so their xdotool behavior (and therefore
# every pre-T7 test's assertions) is completely unchanged:
#   - `getactivewindow` (active-window-id, the "launching frame" `show`/
#     `window` dock against) answers with $FAKE_ACTIVE_WINDOW if set, else
#     exits 1 — the same "no X session" degrade every other test already
#     relies on.
#   - `search --pid` exits 1 unconditionally when $FAKE_NEVER_MAP is set —
#     simulates a window that spawned but never mapped (crashed qml6),
#     regardless of which pid is being searched for, so the test doesn't
#     need to predict a not-yet-spawned pid up front.
let fake_xdotool = $"($fake_bin_dir)/xdotool"
let fake_xdotool_src = "#!/bin/bash
if [ \"$1\" = \"search\" ] && [ \"$2\" = \"--pid\" ]; then
  if [ -n \"$FAKE_NEVER_MAP\" ]; then exit 1; fi
  echo \"9$3\"
  exit 0
fi
if [ \"$1\" = \"getactivewindow\" ]; then
  if [ -n \"$FAKE_ACTIVE_WINDOW\" ]; then echo \"$FAKE_ACTIVE_WINDOW\"; exit 0; fi
  exit 1
fi
exit 1
"
$fake_xdotool_src | save --force $fake_xdotool
^chmod +x $fake_xdotool

# Fake identify (sp022 T7): image-dims prefers ImageMagick `identify -format
# "%w %h" <path>` to learn the shape `show` docks by. Gated behind
# $FAKE_IMG_W/$FAKE_IMG_H exactly like the xdotool additions above — absent
# (every pre-T7 test), it exits 1 so image-dims falls through to `file`
# (also absent from the test PATH), landing on the same "no dims, no dock"
# degrade those tests already exercise.
let fake_identify = $"($fake_bin_dir)/identify"
let fake_identify_src = "#!/bin/bash
if [ -n \"$FAKE_IMG_W\" ] && [ -n \"$FAKE_IMG_H\" ]; then
  echo \"$FAKE_IMG_W $FAKE_IMG_H\"
  exit 0
fi
exit 1
"
$fake_identify_src | save --force $fake_identify
^chmod +x $fake_identify

# Isolated system-utility dir for the "no WM at all" / "no xdotool" edge-case
# tests below (sp022 T7 edge_cases: crashed qml6 / closed frame / headless
# degrade must never hang or error). This host merges /bin, /usr/bin, /sbin
# into ONE directory that ALSO contains the REAL i3-msg/swaymsg/xdotool — a
# test PATH built from any of those merged dirs would fall through to the
# REAL window manager controlling the REAL desktop the moment the fake dir
# doesn't shadow a binary, which is exactly the live-session disruption this
# suite must never risk. So these two tests get their OWN minimal PATH: only
# copies of the specific real binaries the wrapper actually needs (bash for
# its `^bash -c` detached spawns, kill, env, python3 for the fake daemon,
# sleep for the fake qml6 stub) — never a directory that might also contain
# a WM control binary.
let safe_sys_dir = $"($tmp)/safe-sys"
^mkdir -p $safe_sys_dir
for bin in ["bash" "kill" "env" "python3" "sleep" "nohup"] {
    # `type -P` (bash, not nu's own `which`) forces external-binary
    # resolution — nu's `which` reports `kill`/`sleep` as its OWN built-ins
    # with an empty path, since those are also nu commands; bash's `-P`
    # ignores builtins/functions/aliases and searches PATH only.
    let src = ((do { ^bash -c $"type -P ($bin)" } | complete).stdout | str trim)
    if ($src | is-empty) {
        print $"FAIL: could not resolve a real '($bin)' binary to seed the safe-sys test dir"
        exit 1
    }
    ^cp $src $"($safe_sys_dir)/($bin)"
}

# PATH for "no WM at all": fake preview-d/qml6/xdotool/identify (everything
# the spawn path needs) but NO i3-msg/swaymsg anywhere on PATH.
let bin_no_wm = $"($tmp)/bin-no-wm"
^mkdir -p $bin_no_wm
for f in ["preview-d" "qml6" "xdotool" "identify"] {
    ^cp $"($fake_bin_dir)/($f)" $"($bin_no_wm)/($f)"
}
let no_wm_path = $"($bin_no_wm):($safe_sys_dir)"

# PATH for "WM present, no xdotool": fake preview-d/qml6/i3-msg/identify but
# no xdotool anywhere on PATH.
let bin_no_xdotool = $"($tmp)/bin-no-xdotool"
^mkdir -p $bin_no_xdotool
for f in ["preview-d" "qml6" "i3-msg" "identify"] {
    ^cp $"($fake_bin_dir)/($f)" $"($bin_no_xdotool)/($f)"
}
let no_xdotool_path = $"($bin_no_xdotool):($safe_sys_dir)"

# Path to window N's pidfile under the isolated cache dir (mirrors the
# wrapper's own window-pid-file, but computed independently here so the
# test doesn't depend on the wrapper's internals).
def wv-pid-file [cache: string, n: int] {
    $"($cache)/wv-($n).pid"
}

# Spawn a bystander process that is deliberately NOT preview-wv — used to
# simulate a recycled pid (alive, but /proc/<pid>/cmdline doesn't match).
# Returns its pid.
def spawn-bystander [] {
    # Redirect the backgrounded sleep's stdout/stderr away from the parent
    # bash -c's own streams — otherwise the child keeps nu's `complete`
    # capture pipe open for as long as it lives (3600s), hanging this call
    # instead of returning as soon as `echo $!` completes.
    let r = (do { ^bash -c "sleep 3600 >/dev/null 2>&1 & echo $!" } | complete)
    ($r.stdout | str trim | into int)
}

def pid-is-alive [pid: int] {
    (do { ^kill -0 $pid } | complete | get exit_code) == 0
}

def wait-pid-dead [pid: int] {
    for _ in 1..30 {
        if not (pid-is-alive $pid) { return true }
        sleep 100ms
    }
    false
}

def wait-pid-alive [pid: int] {
    for _ in 1..30 {
        if (pid-is-alive $pid) { return true }
        sleep 100ms
    }
    false
}

# Track every real preview-wv stub pid we spawn during the window tests so
# leftovers (e.g. deliberately orphaned by overwriting a pidfile to
# simulate stale/recycled scenarios) get reaped in cleanup instead of
# lingering as `sleep 3600` processes.
mut spawned_pids = []

# Helper: run the wrapper with a clean env (isolated HOME/PATH/port).
def run-wrapper [tmp: string, port: string, path: string, verb: string, extra_args: string = ""] {
    do {
        ^bash -c $"HOME=($tmp) PREVIEW_PORT=($port) PREVIEW_ROOT=($tmp) PATH=($path) /usr/bin/nu ($WRAPPER) ($verb) ($extra_args)"
    } | complete
}

# Like run-wrapper, but with extra literal env assignments spliced in
# (sp022 T7 docking tests: FAKE_ACTIVE_WINDOW / FAKE_IMG_W / FAKE_IMG_H /
# FAKE_NEVER_MAP steer the fake xdotool/identify stubs above).
def run-wrapper-env [tmp: string, port: string, path: string, extra_env: string, verb: string, extra_args: string = ""] {
    do {
        ^bash -c $"HOME=($tmp) PREVIEW_PORT=($port) PREVIEW_ROOT=($tmp) PATH=($path) ($extra_env) /usr/bin/nu ($WRAPPER) ($verb) ($extra_args)"
    } | complete
}

# Helper: start the fake daemon with CAPTURE_FILE set so POST /preview<N>
# bodies land in $capture_file, and wait for it to come up.
def start-with-capture [tmp: string, port: string, path: string, capture_file: string] {
    let r = (do {
        ^bash -c $"HOME=($tmp) PREVIEW_PORT=($port) PREVIEW_ROOT=($tmp) PATH=($path) CAPTURE_FILE=($capture_file) /usr/bin/nu ($WRAPPER) start"
    } | complete)
    if $r.exit_code != 0 {
        print $"FAIL: capture-mode start exited ($r.exit_code)\n($r.stdout)($r.stderr)"
        exit 1
    }
    for _ in 1..30 {
        let up = (do { ^bash -c $"curl -sf --max-time 1 http://127.0.0.1:($port)/status" } | complete)
        if $up.exit_code == 0 { return }
        sleep 100ms
    }
}

def wait-port-free [port: string] {
    for _ in 1..30 {
        let up = (do { ^bash -c $"curl -sf --max-time 1 http://127.0.0.1:($port)/status" } | complete)
        if $up.exit_code != 0 { return }
        sleep 100ms
    }
}

