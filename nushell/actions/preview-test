# ── test 33: the web tier's crash policy — the decision, table-tested ───────
#
# dotfiles-f532. WebTier.qml's guard is a state machine over three events
# (renderer terminated / a load survived its probation / a new sourceUrl),
# and every interesting case takes tens of seconds of real renderer to
# produce: the bug that reopened this was a page that loads, idles PAST the
# 10 s probation, and only then exhausts the heap — measured at 11
# terminations in 200 s, dead periodic at 17.8 s, fallback never shown.
# Reproducing that end-to-end costs 200 s and a Chromium; reproducing the
# decision costs nothing, so the decision is factored into CrashPolicy.js and
# this table drives it.
#
# The two halves of the problem look alike ON PURPOSE and that is why the
# table matters: case "slow OOM loop" and case "R4 four external kills" have
# the SAME event timing (a crash, a satisfied probation, another crash) and
# must come out differently — the first must give up, the second must
# recover every time. Only the termination status separates them, and the
# statuses below are measured on Qt 6.11.1, not read off the enum docs:
# a V8 OOM is status=3 code=5, an external SIGKILL is status=2 code=9,
# SIGTERM status=2 code=61696, SIGABRT status=1 code=64000.
#
# Three things keep this from being decoration:
#   * it drives the real preview/qml/CrashPolicy.js by absolute URL — no
#     copy, no assertion about source text;
#   * every case pins the full ACTION SEQUENCE including backoff delays and
#     the final counter triple, so a policy that reaches the right verdict by
#     the wrong route still fails;
#   * it asserts the reducer is pure (same input state -> same decision, and
#     the input is not mutated), which is the property that makes the table
#     equivalent to the real thing.
#
# Needs a real qml6 (the same one the client runs under). Absent is a loud
# SKIP subtracted from the final count — never a silent pass.

let policy_cases = [
    {desc: "a single external kill reloads immediately",
     events: ["term:2:9"],
     want: ["reload:0"],
     want_state: {transient: 1, oom: 0, lifetime: 1}},

    {desc: "two crashes inside ONE probation window trip the fallback (sp022 T5's bound, preserved)",
     events: ["term:2:9" "term:2:9"],
     want: ["reload:0" "fail:transient"],
     want_state: {transient: 2, oom: 0, lifetime: 2}},

    {desc: "R3: a kill, then a load that stands its probation, leaves a clean transient budget",
     events: ["term:2:9" "probation"],
     want: ["reload:0" "probation"],
     want_state: {transient: 0, oom: 0, lifetime: 1}},

    {desc: "R4: four external kills, each after a completed probation, ALL recover",
     events: ["term:2:9" "probation" "term:2:9" "probation" "term:2:9" "probation" "term:2:9"],
     want: ["reload:0" "probation" "reload:1000" "probation" "reload:2000" "probation" "reload:4000"],
     want_state: {transient: 1, oom: 0, lifetime: 4}},

    {desc: "THE BUG: the slow OOM loop satisfies probation before every crash and still stops at the second OOM",
     events: ["term:3:5" "probation" "term:3:5"],
     want: ["reload:0" "probation" "fail:oom"],
     want_state: {transient: 1, oom: 2, lifetime: 2}},

    {desc: "the fast OOM loop still stops at the second termination (sp022 T10's result)",
     events: ["term:3:5" "term:3:5"],
     want: ["reload:0" "fail:oom"],
     want_state: {transient: 2, oom: 2, lifetime: 2}},

    {desc: "R1: a new sourceUrl clears every budget, the OOM one included",
     events: ["term:3:5" "probation" "term:3:5" "nav" "term:3:5"],
     want: ["reload:0" "probation" "fail:oom" "reset" "reload:0"],
     want_state: {transient: 1, oom: 1, lifetime: 1}},

    {desc: "an external kill never spends the OOM budget, however many times it lands",
     events: ["term:2:9" "probation" "term:2:9" "probation" "term:2:9" "probation" "term:2:9" "probation" "term:2:9"],
     want: ["reload:0" "probation" "reload:1000" "probation" "reload:2000" "probation" "reload:4000" "probation" "reload:8000"],
     want_state: {transient: 1, oom: 0, lifetime: 5}},

    {desc: "the lifetime cap bounds the loop even if the OOM classification stops matching entirely",
     events: ["term:1:64000" "probation" "term:1:64000" "probation" "term:1:64000" "probation"
              "term:1:64000" "probation" "term:1:64000" "probation" "term:1:64000" "probation"
              "term:1:64000" "probation" "term:1:64000" "probation" "term:1:64000"],
     want: ["reload:0" "probation" "reload:1000" "probation" "reload:2000" "probation"
            "reload:4000" "probation" "reload:8000" "probation" "reload:16000" "probation"
            "reload:30000" "probation" "reload:30000" "probation" "fail:lifetime"],
     want_state: {transient: 1, oom: 0, lifetime: 9}},

    {desc: "the STATUS is the discriminator, not the exit code — any Killed status is self-inflicted",
     events: ["term:3:999" "probation" "term:3:0"],
     want: ["reload:0" "probation" "fail:oom"],
     want_state: {transient: 1, oom: 2, lifetime: 2}},

    {desc: "a non-Killed status is external however alarming its exit code (SIGABRT then SIGTERM)",
     events: ["term:1:64000" "probation" "term:2:61696"],
     want: ["reload:0" "probation" "reload:1000"],
     want_state: {transient: 1, oom: 0, lifetime: 2}},
