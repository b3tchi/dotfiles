    let qml_pid = (^bash -c $"cd ($tmp); QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 QT_FORCE_STDERR_LOGGING=1 QT_LOGGING_RULES='qt.quick.image=true' nohup qml6 ($qml_view) -- 1 ($svg_port) >($qml_log) 2>&1 & echo $!" | str trim)

