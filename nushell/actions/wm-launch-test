#!/usr/bin/env nu
# wm-launch-test - scripted test for the sp038 session launchers, in the
# wm-ipc-test / d2-router-test pattern. Headless: every case runs the real
# script under `env -i` with a sandbox HOME and XDG_RUNTIME_DIR in mktemp
# dirs. Never touches :10, a live i3, Jan's tmux server or his real
# $XDG_RUNTIME_DIR.
#
#   nu nushell/actions/wm-launch-test
#
# Task 1 (wm-session-env-snapshot):
#   1a snapshot-written       1b drop-list-absent (one assertion per name)
#   1c atomic-replace         1d no-runtime-dir-78     1e no-display-78
#   1f per-display-files      1g newline-value-roundtrip
#   1h display-normalised (:N == :N.S, host:N kept distinct)
#
# Task 2 (wm-launch-detach; probes are `sleep`-ing children killed by exact pid):
#   2a identical-children     2b fd-closer-has-teeth   2c set-passes-only-named
#   2d dry-run-x11            2e dry-run-systemd       2f dry-run-windows
#   2g no-backend-78          2h argv-verbatim         2i corrupt-snapshot-78
#   2j display-not-cross-used 2k missing-command
#   2l screen-suffix-resolves 2m x11-display-never-systemd
#   2n capture-returns-while-child-runs (live pipes; kwi3 et3u.10)
#
# Task 3 (wm-launch-terminal flags, wm-launch-gui; stubs in sandbox
# HOME/.local/bin come first - the real tmux server is never reached):
#   3a no-flags-focused  3b callers-unchanged  3c workspace-flag
#   3d session-flag-no-resolve  3e workspace-session-exclusive
#   3f class-per-terminal  3g class-unknown-term-2  3h gui-argv
#   3i gui-empty-2  3j ssh-entry  3k tmux-start-fails  3l dry-run-real-detach

const here = (path self | path dirname)
const DROPPED = [TMUX TMUX_PANE I3SOCK HOTKEYD_I3SOCK OLDPWD PWD SHLVL _ CURRENT_FILE FILE_PWD LAST_EXIT_CODE NU_VERSION CMD_DURATION_MS PROCESS_PATH]


def sandbox [] {
    let d = (^mktemp -d | str trim)
    ^mkdir -p $"($d)/home" $"($d)/run"
    $d
}

# Run a script under env -i. `extra` is a list of "K=V" words.
def run-under [script: string, extra: list<string>] {
    ^env -i ...$extra $nu.current-exe $script | complete
}

def read-snapshot [file: string] {
    if not ($file | path exists) { return [] }
    open --raw $file | split row (char -i 0) | where {|e| $e != "" }
}

def names-of [entries: list<string>] {
    $entries | each {|e| $e | split row "=" | first }
}

def check [ok: bool, label: string] {
    if $ok { print $"  ok   ($label)" } else { print $"  FAIL ($label)" }
    $ok
}

# ---- Task 2 helpers -------------------------------------------------------

const PROBE = '#!/bin/bash
# probe: report what /proc says about this process, then sleep.
out=$1; fifo=$2; shift 2
echo $$ >> "$(dirname "$out")/pids"
std="$(readlink /proc/$$/fd/0) $(readlink /proc/$$/fd/1) $(readlink /proc/$$/fd/2)"
set -- "$@" ; args=("$@")
read -r _ ppid pgrp sid _ < <(sed "s/^.*) //" /proc/$$/stat)
{
  echo "pid $$"; echo "ppid $ppid"; echo "pgrp $pgrp"; echo "sid $sid"
  echo "cwd $(readlink /proc/$$/cwd)"
  echo "fds $(for f in /proc/$$/fd/*; do echo ${f##*/}; done | sort -n | tr "\n" " ")"
  echo "std $std"
  tr "\0" "\n" < /proc/$$/environ | sort | sed -e "/^_=/d" -e "s/^/env /"
} > "$out"
if [ ${#args[@]} -gt 0 ]; then printf "%s\0" "${args[@]}" > "$out.args"; fi
echo done > "$fifo"
exec sleep 30
'

# Directory of just the tools the launcher and probes need - notably NO
# systemctl, so "no systemd user manager" is a fact, not a hope.
def toolbin [sb: string] {
    let d = $"($sb)/toolbin"
    ^mkdir -p $d
    for t in [env setsid timeout sh bash sleep cat sed cut sort tr diff dirname readlink install mv] {
        let w = (^sh -c $"command -v ($t)" | complete | get stdout | str trim)
        if $w != "" { ^ln -sf $w $"($d)/($t)" }
    }
    $d
}

# A sandbox with a snapshot for display :977 written by the real tool.
def session [] {
    let sb = (sandbox)
    let tb = (toolbin $sb)
    ^mkdir -p $"($sb)/home" $"($sb)/run"
    $PROBE | save --raw $"($sb)/probe"
    ^chmod +x $"($sb)/probe"
    let base = [$"HOME=($sb)/home" $"XDG_RUNTIME_DIR=($sb)/run" $"PATH=($tb)" "DISPLAY=:977" "SESSIONVAR=kept"]
    ^env -i ...$base $nu.current-exe $"($here)/wm-session-env-snapshot" | complete | ignore
    {sb: $sb, tb: $tb, base: $base, snap: $"($sb)/run/wm-session-env-_977"}
}

const NOISE = ["TMUX=/tmp/tmux-1/default,1,0" "TMUX_PANE=%3" "PWD=/tmp" "SHLVL=4" "NU_VERSION=9" "OLDPWD=/x" "KEEPME=leak" "I3SOCK=/x/i3"]

# Run the detacher from a caller shape and return the probe's report.
#   hotkeyd: env -i <session env> setsid sh -c "nu detach ..." (proc.Run shape)
#   tmux:    noisy env, cwd /tmp, non-CLOEXEC fds 7 and 9 open
#   bare:    the probe itself, no launcher (the fd/env reference)
def launch [s: record, tag: string, shape: string, extra_env: list<string>, flags: list<string>, probe_args: list<string> = []] {
    let out = $"($s.sb)/out-($tag)"
    let fifo = $"($s.sb)/fifo-($tag)"
    ^mkfifo $fifo
    let probe = $"($s.sb)/probe"
    let detach = $"($here)/wm-launch-detach"
    let nuexe = $nu.current-exe
    let pa = ($probe_args | each {|a| $"'($a)'" } | str join " ")
    let r = match $shape {
        "hotkeyd-pipe" => {
            # LIVE pipes: bash's $(...) and 2>&1 capture, as nushell `complete` does
            ^env -i ...$s.base ...$extra_env setsid timeout 5 bash -c $"exec >/dev/null 2>&1 </dev/null; x=$\(($nuexe) ($detach) ($flags | str join " ") -- ($probe) ($out) ($fifo) ($pa) 2>&1\); echo rc=$? > ($out).rc" | complete
        }
        "tmux-pipe" => {
            ^env -i ...$s.base ...$NOISE ...$extra_env timeout 5 bash -c $"exec 7>($s.sb)/f7; exec 9<($s.sb)/probe; exec >/dev/null 2>&1 </dev/null; cd /tmp; x=$\(($nuexe) ($detach) ($flags | str join " ") -- ($probe) ($out) ($fifo) ($pa) 2>&1\); echo rc=$? > ($out).rc" | complete
        }
        "bare" => { ^env -i ...$s.base ...$extra_env bash -c $"($probe) ($out) ($fifo) >/dev/null 2>&1 </dev/null &" | complete }
        "hotkeyd" => {
            ^env -i ...$s.base ...$extra_env setsid bash -c $"($nuexe) ($detach) ($flags | str join " ") -- ($probe) ($out) ($fifo) ($pa) >/dev/null 2>&1 </dev/null" | complete
        }
        _ => {
            ^env -i ...$s.base ...$NOISE ...$extra_env bash -c $"exec 7>($s.sb)/f7; exec 9<($s.sb)/probe; cd /tmp; ($nuexe) ($detach) ($flags | str join " ") -- ($probe) ($out) ($fifo) ($pa) >/dev/null 2>&1 </dev/null" | complete
        }
    }
    let got = (^timeout 10 cat $fifo | complete)
    {exit: $r.exit_code, stderr: $r.stderr, started: ($got.exit_code == 0), out: $out, report: (if ($out | path exists) { open --raw $out | lines } else { [] })}
}

def field [rep: record, k: string] {
    $rep.report | where {|l| $l | str starts-with $"($k) " } | each {|l| $l | str substring (($k | str length) + 1).. } | first
}
def envs-of [rep: record] { $rep.report | where {|l| $l | str starts-with "env " } }

# Run the detacher where NOTHING may start: returns exit/stdout/stderr and
# whether a probe wrote its fifo within 1s.
def run-detach [s: record, tag: string, envl: list<string>, flags: list<string>] {
    let out = $"($s.sb)/out-($tag)"
    let fifo = $"($s.sb)/fifo-($tag)"
    ^mkfifo $fifo
    let r = (^env -i ...$envl $nu.current-exe $"($here)/wm-launch-detach" ...$flags -- $"($s.sb)/probe" $out $fifo | complete)
    let got = (^timeout 1 cat $fifo | complete)
    $r | merge {started: ($got.exit_code == 0 and ($got.stdout | str trim) == "done"), wrote: ($out | path exists)}
}

def kill-probes [sb: string] {
    let f = $"($sb)/pids"
    if ($f | path exists) { for p in (open --raw $f | lines | where {|l| $l != "" }) { try { ^kill $p } } }
}

# ---- Task 3 helpers -------------------------------------------------------

# Sandbox HOME with stub launchers. Every stub appends its argv (one word per
# line, then a "--" line) to $sb/log-<name>. detach is a stub too, so no test
# depends on a display, a terminal or a backend.
def stub-home [] {
    let sb = (sandbox)
    let bin = $"($sb)/home/.local/bin"
    ^mkdir -p $bin $"($sb)/home/.config/nushell/scripts/project"
    let rec = {|name| r#'printf '%s\n' "$@" >> "@SB@/log-@N@"; echo @@END@@ >> "@SB@/log-@N@"'# | str replace --all "@SB@" $sb | str replace --all "@N@" $name }
    $"#!/bin/sh\necho \"${STUB_WS:-focusedws}\"\n" | save --raw $"($bin)/wm-current-workspace"
    # tmux-start: log argv, print a session name derived from the ws (arg 3)
    $"#!/bin/sh\n(do $rec tmux-start)\nif [ -n \"$STUB_TS_FAIL\" ]; then echo 'tmux-start boom' >&2; exit 7; fi\necho \"sess-$3\"\n" | save --raw $"($bin)/tmux-start"
    $"#!/bin/sh\n(do $rec tmux-to-workstation)\necho thin_remote\n" | save --raw $"($bin)/tmux-to-workstation"
    $"#!/bin/sh\n(do $rec detach)\n" | save --raw $"($bin)/wm-launch-detach"
    r#'export def lookup [name: string] {
  if $name == "sshws" { {ssh: "myhost", path: "/srv/p"} } else { null }
}
'# | save --raw $"($sb)/home/.config/nushell/scripts/project/mod.nu"
    for f in (glob $"($bin)/*") { ^chmod +x $f }
    $sb
}

def t3-run [sb: string, script: string, args: list<string>, extra: list<string> = []] {
    let tb = (toolbin $sb)
    ^env -i $"HOME=($sb)/home" $"PATH=($tb)" ...$extra $nu.current-exe $"($here)/($script)" ...$args | complete
}

def logw [sb: string, name: string] {
    let f = $"($sb)/log-($name)"
    if ($f | path exists) { open --raw $f | lines } else { [] }
}

# The argv a stub recorded for call number n (0-based), without the end marker.
def calls [lines: list<string>] {
    mut out = []
    mut cur = []
    for l in $lines {
        if $l == "@@END@@" { $out = ($out | append [$cur]); $cur = [] } else { $cur = ($cur | append $l) }
    }
    $out
}

def main [] {
    let snap = $"($here)/wm-session-env-snapshot"
    mut oks = []

    print "-- 1. wm-session-env-snapshot"
    let sb = (sandbox)
    let run = $"($sb)/run"
    let base = [$"HOME=($sb)/home" $"XDG_RUNTIME_DIR=($run)" "PATH=/usr/bin:/bin" "DISPLAY=:977"]
    let noise = ["TMUX=/tmp/tmux-1/default,1,0" "TMUX_PANE=%3" "I3SOCK=/x/i3" "HOTKEYD_I3SOCK=/x/i3" "OLDPWD=/elsewhere" "SHLVL=4" "CURRENT_FILE=/f" "FILE_PWD=/p" "LAST_EXIT_CODE=3" "NU_VERSION=0.1" "CMD_DURATION_MS=12" "PROCESS_PATH=/pp" "KEEPME=yes"]

    # 1a
    let r = (run-under $snap [...$base ...$noise])
    let f = $"($run)/wm-session-env-_977"
    let exists = ($f | path exists)
    $oks = ($oks | append (check ($r.exit_code == 0 and $exists) "1a snapshot-written: exit 0 and $XDG_RUNTIME_DIR/wm-session-env-_977 exists"))
    let mode = if $exists { ^stat -c %a $f | str trim } else { "" }
    $oks = ($oks | append (check ($mode == "600") $"1a mode 0600 \(got '($mode)'\)"))
    let entries = if $exists { read-snapshot $f } else { [] }
    let have = ($entries | where {|e| $e | str starts-with "KEEPME=yes" } | length)
    $oks = ($oks | append (check (($entries | any {|e| $e == $"HOME=($sb)/home" }) and ($entries | any {|e| $e == "DISPLAY=:977" }) and ($entries | any {|e| $e | str starts-with "PATH=" }) and $have == 1) "1a NUL-separated, holds HOME/DISPLAY/PATH and an ordinary var"))

    # 1b
    let names = (names-of $entries)
    $oks = ($oks | append (check (($names | length) > 3) "1b snapshot is non-empty (so absence below means something)"))
    for n in $DROPPED {
        $oks = ($oks | append (check (not ($n in $names)) $"1b drop-list-absent: ($n)"))
    }
    # 1b audit: every var nushell itself injects into a script's children
    # (measured now, under env -i, not remembered) is on the drop list.
    let audit = $"($sb)/audit"
    "#!/usr/bin/env nu\ndef main [] { ^env -0 | decode utf-8 | split row (char -i 0) | where {|e| $e != \"\" } | each {|e| $e | split row \"=\" | first } | str join \" \" | print }\n" | save --raw $audit
    let injected = (^env -i "PATH=/usr/bin:/bin" $nu.current-exe $audit | str trim | split row " " | where {|n| $n != "" and $n != "PATH" })
    let unlisted = ($injected | where {|n| not ($n in $DROPPED) })
    let leaked = ($injected | where {|n| $n in $names })
    $oks = ($oks | append (check (($injected | length) > 0 and ($unlisted | is-empty) and ($leaked | is-empty)) $"1b nushell-injected vars all dropped \(injected [($injected | str join ' ')], not on this test's list [($unlisted | str join ' ')], in the snapshot [($leaked | str join ' ')]\)"))

    # 1c
    let r2 = (run-under $snap [...$base "KEEPME=second" "NEWVAR=1"])
    let entries2 = (read-snapshot $f)
    let tmps = (glob $"($run)/*tmp*" | length)
    $oks = ($oks | append (check ($r2.exit_code == 0 and ($entries2 | any {|e| $e == "KEEPME=second" }) and not ($entries2 | any {|e| $e == "KEEPME=yes" }) and $tmps == 0) "1c atomic-replace: new content, no tmp left behind"))

    # 1d
    let sb2 = (sandbox)
    let r = (run-under $snap [$"HOME=($sb2)/home" "PATH=/usr/bin:/bin" "DISPLAY=:977"])
    let nothing = ((^find $sb2 -type f | lines | length) == 0)
    $oks = ($oks | append (check ($r.exit_code == 78 and ($r.stderr | str contains "XDG_RUNTIME_DIR") and $nothing) "1d no-runtime-dir-78: names XDG_RUNTIME_DIR, writes nothing"))

    # 1e
    let sb3 = (sandbox)
    let r = (run-under $snap [$"HOME=($sb3)/home" $"XDG_RUNTIME_DIR=($sb3)/run" "PATH=/usr/bin:/bin"])
    let nothing = ((^find $"($sb3)/run" -type f | lines | length) == 0)
    $oks = ($oks | append (check ($r.exit_code == 78 and ($r.stderr | str contains "DISPLAY") and $nothing) "1e no-display-78: names DISPLAY, writes nothing"))

    # 1f
    let sb4 = (sandbox)
    let b4 = [$"HOME=($sb4)/home" $"XDG_RUNTIME_DIR=($sb4)/run" "PATH=/usr/bin:/bin"]
    run-under $snap [...$b4 "DISPLAY=:10" "WHO=ten"] | ignore
    run-under $snap [...$b4 "DISPLAY=:40.1" "WHO=forty"] | ignore
    let f10 = $"($sb4)/run/wm-session-env-_10"
    let f40 = $"($sb4)/run/wm-session-env-_40"
    $oks = ($oks | append (check (($f10 | path exists) and ($f40 | path exists) and ((read-snapshot $f10) | any {|e| $e == "WHO=ten" }) and ((read-snapshot $f40) | any {|e| $e == "WHO=forty" })) "1f per-display-files: :10 and :40.1 -> two files, neither overwrites"))

    # 1h: one file per X server - the screen suffix is not part of the name
    let sb6 = (sandbox)
    let b6 = [$"HOME=($sb6)/home" $"XDG_RUNTIME_DIR=($sb6)/run" "PATH=/usr/bin:/bin"]
    let pth = {|d| ^env -i ...$b6 $nu.current-exe $snap path $d | complete | get stdout | str trim }
    run-under $snap [...$b6 "DISPLAY=:60.0"] | ignore
    let f60 = $"($sb6)/run/wm-session-env-_60"
    $oks = ($oks | append (check (($f60 | path exists) and (do $pth ":60") == $f60 and (do $pth ":60.0") == $f60) $"1h display-normalised: written with :60.0, `path :60` and `path :60.0` both name ($f60)"))
    run-under $snap [...$b6 "DISPLAY=:61"] | ignore
    $oks = ($oks | append (check ((do $pth ":61.0") == $"($sb6)/run/wm-session-env-_61" and ($"($sb6)/run/wm-session-env-_61" | path exists)) "1h display-normalised: written with :61, `path :61.0` resolves it"))
    let lh = (do $pth "localhost:10.0")
    $oks = ($oks | append (check ($lh == $"($sb6)/run/wm-session-env-localhost_10" and (do $pth "localhost:10") == $lh and $lh != (do $pth ":10")) $"1h host:N kept distinct from :N \(ssh -X's localhost:10.0 is not the local :10\), screen still stripped \(got ($lh)\)"))

    # 1g
    let sb5 = (sandbox)
    let b5 = [$"HOME=($sb5)/home" $"XDG_RUNTIME_DIR=($sb5)/run" "PATH=/usr/bin:/bin" "DISPLAY=:977"]
    let tricky = "line1\nline2=x\n\u{e9}\u{4e2d}"
    run-under $snap [...$b5 $"MULTI=($tricky)"] | ignore
    let got = (read-snapshot $"($sb5)/run/wm-session-env-_977" | where {|e| $e | str starts-with "MULTI=" })
    $oks = ($oks | append (check ($got == [$"MULTI=($tricky)"]) "1g newline-value-roundtrip: newline, = and unicode survive NUL framing"))

    for d in [$sb $sb2 $sb3 $sb4 $sb5 $sb6] { ^rm -rf $d }

    print "-- 2. wm-launch-detach"
    let s = (session)
    let dsb = [$s.sb]
    try {
        let det = $"($here)/wm-launch-detach"
        let snapnames = (read-snapshot $s.snap | each {|e| $e | split row "=" | first })
        let volatile = ["_" "PWD" "SHLVL"]   # bash (the sh) adds these itself

        # 2a
        let bare = (launch $s a0 bare [] [])
        let A = (launch $s a1 hotkeyd [] [])
        let B = (launch $s a2 tmux [] [])
        let home = $"($s.sb)/home"
        let ok_a = ($A.started and $B.started and $bare.started)
        $oks = ($oks | append (check ($ok_a and (field $A ppid) == (field $B ppid)) "2a identical-children: ppid equal"))
        $oks = ($oks | append (check ($ok_a and (field $A sid) == (field $A pgrp) and (field $A sid) == (field $A pid) and (field $B sid) == (field $B pgrp) and (field $B sid) == (field $B pid)) "2a sid == pgid == pid for both"))
        $oks = ($oks | append (check ($ok_a and (field $A fds) == (field $bare fds) and (field $B fds) == (field $bare fds)) $"2a fds equal a bare probe's \(A '(field $A fds)', B '(field $B fds)', bare '(field $bare fds)'\)"))
        $oks = ($oks | append (check ($ok_a and (envs-of $A) == (envs-of $B) and ((envs-of $A) | length) > 3) "2a environ diff empty"))
        $oks = ($oks | append (check ($ok_a and (field $A cwd) == $home and (field $B cwd) == $home) "2a cwd == snapshot HOME for both"))
        $oks = ($oks | append (check ($ok_a and not ((envs-of $B) | any {|e| ($e | str contains "TMUX") or ($e | str contains "KEEPME") or ($e | str contains "NU_VERSION") })) "2a tmux-shaped caller's TMUX/KEEPME/NU_VERSION did not reach the child"))

        # 2a (live pipes): the caller CAPTURES the launcher's output (bash $(...)
        # and 2>&1, what nushell `complete` does) instead of redirecting it to
        # /dev/null. The child's fds 0,1,2 must be /dev/null for both callers
        # and for the bare reference - never the caller's capture pipe.
        let AP = (launch $s a3 hotkeyd-pipe [] [])
        let BP = (launch $s a4 tmux-pipe [] [])
        let want_std = "/dev/null /dev/null /dev/null"
        $oks = ($oks | append (check ($AP.started and $BP.started and $bare.started and (field $bare std) == $want_std and (field $A std) == $want_std and (field $B std) == $want_std and (field $AP std) == $want_std and (field $BP std) == $want_std) $"2a std-is-devnull: fds 0,1,2 -> /dev/null for redirected AND live-pipe callers \(hotkeyd-pipe '(if $AP.started { field $AP std } else { '?' })', tmux-pipe '(if $BP.started { field $BP std } else { '?' })'\)"))
        $oks = ($oks | append (check ($AP.started and $BP.started and (field $AP fds) == (field $bare fds) and (field $BP fds) == (field $bare fds)) "2a fds equal a bare probe's for the live-pipe callers too"))

        # 2n: a caller that captures output must get control back while the
        # detached program keeps running (wm-state restore hung here: the st
        # held restore's `complete` pipe as its fd 1). Real nushell `complete`
        # in a nu child bounded by `timeout`, so a regression fails fast.
        let nsb = $s.sb
        let nout = $"($nsb)/out-n1"
        let nfifo = $"($nsb)/fifo-n1"
        ^mkfifo $nfifo
        let nscript = $"($nsb)/n1.nu"
        let base_words = ($s.base | each {|e| $"\"($e)\"" } | str join " ")
        $"def main [] {\n  let r = \(^env -i ...[($base_words)] ($nu.current-exe) ($det) -- ($nsb)/probe ($nout) ($nfifo) | complete\)\n  print \($\"rc=\($r.exit_code\) err=[\($r.stderr | str trim\)]\"\)\n}\n" | save --raw $nscript
        let t0 = (date now)
        let nr = (^timeout 5 $nu.current-exe $nscript | complete)
        let took = ((date now) - $t0)
        let ngot = (^timeout 5 cat $nfifo | complete)
        let npid = if ($nout | path exists) { open --raw $nout | lines | where {|l| $l | str starts-with "pid " } | first | str substring 4.. } else { "" }
        let nalive = ($npid != "" and ($"/proc/($npid)" | path exists))
        $oks = ($oks | append (check ($nr.exit_code == 0 and ($nr.stdout | str contains "rc=0") and $took < 2sec and $ngot.exit_code == 0 and $nalive) $"2n capture-returns-while-child-runs: nushell `complete` returned in ($took) \(exit ($nr.exit_code), out '($nr.stdout | str trim)'\), child pid '($npid)' still alive: ($nalive)"))

        # 2b
        let T = (launch $s b1 tmux ["WM_LAUNCH_TEST=1" "WM_LAUNCH_TEST_NO_FDCLOSE=1"] [])
        let fds = if $T.started { field $T fds | split row " " } else { [] }
        $oks = ($oks | append (check ($T.started and ("7" in $fds) and ("9" in $fds)) $"2b fd-closer-has-teeth: without it fds 7 and 9 leak \(got '($fds | str join ' ')'\)"))
        let R = (run-detach $s b2 [...$s.base "WM_LAUNCH_TEST_NO_FDCLOSE=1"] [])
        $oks = ($oks | append (check ($R.exit_code != 0 and not $R.started and not $R.wrote and ($R.stderr | str contains "WM_LAUNCH_TEST")) "2b knob refused without WM_LAUNCH_TEST=1, nothing started"))

        # 2c
        let C = (launch $s c1 tmux [] ["--set" "TMUX_TARGET=dev"])
        let cn = (envs-of $C | each {|e| $e | str substring 4.. | split row "=" | first } | where {|n| not ($n in $volatile) } | sort)
        let want = ($snapnames | append "TMUX_TARGET" | where {|n| not ($n in $volatile) } | sort)
        $oks = ($oks | append (check ($C.started and (envs-of $C | any {|e| $e == "env TMUX_TARGET=dev" }) and $cn == $want) $"2c set-passes-only-named: TMUX_TARGET=dev plus exactly the snapshot, nothing from the caller \(got [($cn | str join ' ')]\)"))

        # 2d / 2e / 2f
        let d = (run-detach $s d1 $s.base ["--dry-run"])
        $oks = ($oks | append (check ($d.exit_code == 0 and ($d.stdout | str trim) == $"x11 ($s.sb)/probe ($s.sb)/out-d1 ($s.sb)/fifo-d1" and not $d.started and not $d.wrote) "2d dry-run-x11: `x11 <argv>`, nothing started"))

        let sb_e = (sandbox)
        let tb_e = (toolbin $sb_e)
        ^mkdir -p $"($sb_e)/stub" $"($sb_e)/home" $"($sb_e)/run"
        "#!/bin/sh\nexit 0\n" | save --raw $"($sb_e)/stub/systemctl"
        # stub systemd-run: records that it was asked, never starts a unit
        $"#!/bin/sh\necho \"$*\" >> ($sb_e)/systemd-run-called\nexit 0\n" | save --raw $"($sb_e)/stub/systemd-run"
        ^chmod +x $"($sb_e)/stub/systemctl" $"($sb_e)/stub/systemd-run"
        let s_e = ($s | merge {sb: $s.sb})
        # systemd is the backend only with no DISPLAY (a Wayland/KWin host)
        let env_e = [$"HOME=($sb_e)/home" $"XDG_RUNTIME_DIR=($sb_e)/run" $"PATH=($sb_e)/stub:($s.tb)"]
        let e = (run-detach $s e1 $env_e ["--dry-run"])
        $oks = ($oks | append (check ($e.exit_code == 0 and ($e.stdout | str trim) == $"systemd ($s.sb)/probe ($s.sb)/out-e1 ($s.sb)/fifo-e1" and not $e.started and not $e.wrote) "2e dry-run-systemd: stub systemctl + no DISPLAY -> `systemd <argv>`, nothing started"))
        # a REAL command found through the caller's PATH (a list in nushell)
        let e2 = (^env -i ...$env_e $nu.current-exe $det --dry-run -- sleep 1 | complete)
        $oks = ($oks | append (check ($e2.exit_code == 0 and ($e2.stdout | str trim) == "systemd sleep 1") $"2e dry-run-systemd: real `sleep` is found on the systemd path \(exit ($e2.exit_code), stderr '($e2.stderr | str trim)'\)"))
        let e3 = (^env -i ...$env_e $nu.current-exe $det --dry-run -- no-such-cmd-xyzzy | complete)
        $oks = ($oks | append (check ($e3.exit_code == 127 and ($e3.stderr | str contains "no-such-cmd-xyzzy")) "2e dry-run-systemd: a missing command is still refused (127, named)"))

        # 2e (stdio): the systemd backend hands the child to a transient unit,
        # whose stdio is the journal/null unless --pipe/--pty/--wait/--scope is
        # asked for. Prove the real call asks for none of them.
        let e4 = (^env -i ...$env_e $nu.current-exe $det -- sleep 1 | complete)
        let called = if ($"($sb_e)/systemd-run-called" | path exists) { open --raw $"($sb_e)/systemd-run-called" } else { "" }
        $oks = ($oks | append (check ($e4.exit_code == 0 and ($called | str contains "--collect") and not ($called =~ '(--pipe|--pty|--wait|--scope| -P| -t| -S)') and ($e4.stdout | str trim) == "") $"2e systemd-stdio: systemd-run is not asked to attach the caller's stdio \(args '($called | str trim)'\)"))
        ^rm -f $"($sb_e)/systemd-run-called"

        # 2m: an X11 display with no snapshot never falls through to systemd
        let m = (run-detach $s m1 [...$env_e "DISPLAY=:977"] [])
        let mmsg = $"wm-launch-detach: no launch backend for display :977 \(no snapshot at ($sb_e)/run/wm-session-env-_977; systemd is only used when DISPLAY is unset\)"
        $oks = ($oks | append (check ($m.exit_code == 78 and ($m.stderr | str trim) == $mmsg and not $m.started and not $m.wrote and not ($"($sb_e)/systemd-run-called" | path exists)) $"2m x11-display-never-systemd: DISPLAY set + no snapshot + systemd answering -> 78 naming the snapshot \(exit ($m.exit_code), stderr '($m.stderr | str trim)'\)"))
        let m2 = (^env -i ...$env_e "DISPLAY=:977" $nu.current-exe $det --dry-run -- sleep 1 | complete)
        $oks = ($oks | append (check ($m2.exit_code == 78 and ($m2.stdout | str trim) == "") "2m x11-display-never-systemd: --dry-run too, nothing printed"))
        ^rm -rf $sb_e

        let f = (run-detach $s f1 [...$s.base "WM_LAUNCH_TEST=1" "WM_LAUNCH_TEST_OS=windows"] ["--dry-run"])
        $oks = ($oks | append (check ($f.exit_code == 0 and ($f.stdout | str trim) == $"windows ($s.sb)/probe ($s.sb)/out-f1 ($s.sb)/fifo-f1" and not $f.started and not $f.wrote) "2f dry-run-windows: `windows <argv>` even with a snapshot present, nothing started"))

        # 2g: no snapshot for the display, no systemctl on PATH
        let sb_g = (sandbox)
        ^mkdir -p $"($sb_g)/run"
        let g = (run-detach $s g1 [$"HOME=($sb_g)/home" $"XDG_RUNTIME_DIR=($sb_g)/run" $"PATH=($s.tb)" "DISPLAY=:977"] [])
        let gmsg = $"wm-launch-detach: no launch backend for display :977 \(no snapshot at ($sb_g)/run/wm-session-env-_977; systemd is only used when DISPLAY is unset\)"
        $oks = ($oks | append (check ($g.exit_code == 78 and ($g.stderr | str trim) == $gmsg and not $g.started and not $g.wrote) $"2g no-backend-78: the plan's message, nothing started \(stderr '($g.stderr | str trim)'\)"))
        let g2 = (run-detach $s g2 [$"HOME=($sb_g)/home" $"XDG_RUNTIME_DIR=($sb_g)/run" $"PATH=($s.tb)"] [])
        let g2msg = "wm-launch-detach: no launch backend (DISPLAY is unset and there is no systemd user manager)"
        $oks = ($oks | append (check ($g2.exit_code == 78 and ($g2.stderr | str trim) == $g2msg and not $g2.started and not $g2.wrote) $"2g no-backend-78: no DISPLAY, no systemd \(stderr '($g2.stderr | str trim)'\)"))
        ^rm -rf $sb_g

        # 2h
        let nasty = ["a b" "it's \"q\"" "$HOME $(id) `x`" "\u{e9}\u{4e2d}!" "--set" "*" "true" "false" "1" "1.5" "1.50" "null" "{}" "[]" "-1" "--"]
        let h = (launch $s h1 tmux [] [] ($nasty | each {|a| $a | str replace --all "'" "'\\''" }))
        let got = if ($"($h.out).args" | path exists) { open --raw $"($h.out).args" | split row (char -i 0) | drop 1 } else { [] }
        $oks = ($oks | append (check ($h.started and $got == $nasty) $"2h argv-verbatim: spaces, quotes, $, backticks, unicode, a glob, a fake flag and nu literals \(true false 1 1.5 1.50 null {} [] -1 --\) arrive unchanged \(got ($got | to nuon)\)"))

        # 2i
        let bad = $"($s.sb)/run/wm-session-env-_966"
        "PATH=/usr/bin\u{0}FOO=1\u{0}" | save --raw $bad
        let i = (run-detach $s i1 [...$s.base "DISPLAY=:966"] [])
        $oks = ($oks | append (check ($i.exit_code == 78 and ($i.stderr | str contains $bad) and not $i.started and not $i.wrote) "2i corrupt-snapshot-78: names the path, never the caller env"))

        # 2j: :977 has a snapshot, :978 has none -> not cross-used
        let j = (run-detach $s j1 $s.base ["--display" ":978"])
        $oks = ($oks | append (check ($j.exit_code == 78 and ($j.stderr | str contains ":978") and ($j.stderr | str contains "wm-session-env-_978") and not $j.started and not $j.wrote) "2j display-not-cross-used: --display :978 refused though :977 has a snapshot"))

        # 2k
        let k = (^env -i ...$s.base $nu.current-exe $det -- no-such-cmd-xyzzy arg | complete)
        $oks = ($oks | append (check ($k.exit_code != 0 and ($k.stderr | str contains "no-such-cmd-xyzzy")) "2k missing-command: non-zero and named \(a bare setsid -f would have said 0\)"))

        # 2l: the session snapshot (written with :977) serves a caller with :977.0
        let l = (run-detach $s l1 [...$s.base "DISPLAY=:977.0"] ["--dry-run"])
        $oks = ($oks | append (check ($l.exit_code == 0 and ($l.stdout | str trim) == $"x11 ($s.sb)/probe ($s.sb)/out-l1 ($s.sb)/fifo-l1" and not $l.started) $"2l screen-suffix-resolves: DISPLAY=:977.0 finds the :977 snapshot \(exit ($l.exit_code), stderr '($l.stderr | str trim)'\)"))
    } finally {
        kill-probes $s.sb
        ^rm -rf $s.sb
    }

    print "-- 3. wm-launch-terminal / wm-launch-gui"
    let T = "wm-launch-terminal"

    # 3a: no flags = focused workspace, launched via detach, exit 0
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st"] ["STUB_WS=focusedws"])
    let ts = (calls (logw $sb tmux-start))
    let dt = (calls (logw $sb detach))
    $oks = ($oks | append (check ($r.exit_code == 0 and $ts == [["start" "0" "focusedws"]] and $dt == [["--set" "TMUX_TARGET=sess-focusedws" "--" "st"]]) $"3a no-flags-focused: tmux-start start 0 focusedws, detach --set TMUX_TARGET=sess-focusedws -- st \(tmux-start ($ts | to nuon), detach ($dt | to nuon), stderr '($r.stderr | str trim)'\)"))
    # multi-word term_cmd still split
    let r = (t3-run $sb $T ["wezterm-gui start"])
    let dt = (calls (logw $sb detach))
    $oks = ($oks | append (check ($r.exit_code == 0 and ($dt | last) == ["--set" "TMUX_TARGET=sess-focusedws" "--" "wezterm-gui" "start"]) "3a multi-word term_cmd split into argv words"))
    # the stubs, not the real tools, were what ran
    let ws = (^env -i $"HOME=($sb)/home" "PATH=/usr/bin:/bin" /bin/sh -c 'command -v tmux-start' | complete)
    $oks = ($oks | append (check (($sb | path exists) and (open --raw $"($sb)/home/.local/bin/tmux-start" | str contains "log-tmux-start")) "3a sandbox: tmux-start resolves to the stub under the sandbox HOME"))
    ^rm -rf $sb

    # 3b: callers unchanged
    let zz = ($here | path dirname | path dirname | path join "i3/config.d/zz-fallback-binds.conf")
    let go = ($here | path dirname | path dirname | path join "hotkeyd/cmd/hotkeyd/config.go")
    let zzok = (open --raw $zz | lines | any {|l| $l == "bindsym $mod+Return exec ~/.local/bin/wm-launch-terminal st" })
    let gook = (open --raw $go | str contains "Chord: \"$mod+Return\", Actions: runAction(\"~/.local/bin/wm-launch-terminal st\")")
    $oks = ($oks | append (check ($zzok and $gook) "3b callers-unchanged: i3 fallback bind and hotkeyd $mod+Return still say `wm-launch-terminal st`"))

    # 3c: --workspace resolves for W, not the focused one
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st" "--workspace" "other"] ["STUB_WS=focusedws"])
    let ts = (calls (logw $sb tmux-start))
    let dt = (calls (logw $sb detach))
    $oks = ($oks | append (check ($r.exit_code == 0 and $ts == [["start" "0" "other"]] and $dt == [["--set" "TMUX_TARGET=sess-other" "--" "st"]]) $"3c workspace-flag: tmux-start called with 'other' only \(($ts | to nuon)\)"))
    ^rm -rf $sb

    # 3d: --session skips resolution
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st" "--session" "my sess"] ["STUB_WS=focusedws"])
    let dt = (calls (logw $sb detach))
    $oks = ($oks | append (check ($r.exit_code == 0 and (logw $sb tmux-start) == [] and (logw $sb tmux-to-workstation) == [] and $dt == [["--set" "TMUX_TARGET=my sess" "--" "st"]]) $"3d session-flag-no-resolve: no tmux-start call, TMUX_TARGET=my sess \(detach ($dt | to nuon)\)"))
    ^rm -rf $sb

    # 3e: exclusive
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st" "--session" "a" "--workspace" "b"])
    $oks = ($oks | append (check ($r.exit_code == 2 and ($r.stderr | str contains "--workspace") and ($r.stderr | str contains "--session") and (logw $sb detach) == [] and (logw $sb tmux-start) == []) "3e workspace-session-exclusive: exit 2, nothing resolved or launched"))
    ^rm -rf $sb

    # 3f: class per terminal (table); failure names the terminal
    let sb = (stub-home)
    let table = [[term want]; ["st" ["-c" "SLOT"]] ["foot" ["--app-id" "SLOT"]] ["kitty" ["--class" "SLOT"]] ["alacritty" ["--class" "SLOT"]] ["xterm" ["-class" "SLOT"]]]
    for row in $table {
        let n = (calls (logw $sb detach) | length)
        let r = (t3-run $sb $T [$row.term "--session" "s1" "--class" "SLOT"])
        let dt = (calls (logw $sb detach))
        let got = if ($dt | length) > $n { $dt | last } else { [] }
        $oks = ($oks | append (check ($r.exit_code == 0 and $got == (["--set" "TMUX_TARGET=s1" "--" $row.term] | append $row.want)) $"3f class-per-terminal: ($row.term) -> ($row.want | str join ' ') \(got ($got | to nuon), stderr '($r.stderr | str trim)'\)"))
    }
    ^rm -rf $sb

    # 3g: unknown terminal + --class
    let sb = (stub-home)
    let r = (t3-run $sb $T ["wezterm-gui start" "--session" "s1" "--class" "SLOT"])
    $oks = ($oks | append (check ($r.exit_code == 2 and ($r.stderr | str contains "wezterm-gui") and (logw $sb detach) == []) "3g class-unknown-term-2: exit 2 naming the terminal, nothing launched"))
    ^rm -rf $sb

    # 3h / 3i: gui
    let sb = (stub-home)
    let r = (t3-run $sb "wm-launch-gui" ["firefox" "--new-window" "a b"])
    $oks = ($oks | append (check ($r.exit_code == 0 and (calls (logw $sb detach)) == [["--" "firefox" "--new-window" "a b"]]) $"3h gui-argv: detach -- firefox --new-window 'a b' \(got (calls (logw $sb detach) | to nuon), stderr '($r.stderr | str trim)'\)"))
    # literal words nu would otherwise type as bool/null/number/record/list must arrive verbatim
    let lit = ["true" "false" "null" "1.50" "{}" "[]" "-1" "--"]
    let r = (t3-run $sb "wm-launch-gui" ["--dry-run" "echo" ...$lit])
    $oks = ($oks | append (check ($r.exit_code == 0 and (calls (logw $sb detach) | last) == ["--dry-run" "--" "echo" ...$lit]) $"3h gui-literal-words: true false null 1.50 {} [] -1 -- arrive verbatim \(got (calls (logw $sb detach) | last | to nuon), stderr '($r.stderr | str trim)'\)"))
    # wm-launch-terminal's string-typed params with the same words
    let r = (t3-run $sb $T ["true" "--session" "null" "--class" "false"])
    $oks = ($oks | append (check ($r.exit_code == 2 and ($r.stderr | str contains "'true'")) $"3h terminal: term_cmd `true` stays a string \(exit 2 naming it; got ($r.exit_code), '($r.stderr | str trim)'\)"))
    let n0 = (calls (logw $sb detach) | length)
    let r = (t3-run $sb $T ["st" "--session" "1.50" "--class" "true"])
    let r2 = (t3-run $sb $T ["st" "--session" "null" "--class" "{}"])
    let r3 = (t3-run $sb $T ["st" "--workspace" "false"])
    let d = (calls (logw $sb detach) | skip $n0)
    $oks = ($oks | append (check ($r.exit_code == 0 and $r2.exit_code == 0 and $r3.exit_code == 0 and $d == [["--set" "TMUX_TARGET=1.50" "--" "st" "-c" "true"] ["--set" "TMUX_TARGET=null" "--" "st" "-c" "{}"] ["--set" "TMUX_TARGET=sess-false" "--" "st"]]) $"3h terminal: --session/--class/--workspace take true null 1.50 {} verbatim, no parse error \(got ($d | to nuon), '($r.stderr | str trim)($r2.stderr | str trim)($r3.stderr | str trim)'\)"))
    let n = (logw $sb detach | length)
    let r = (t3-run $sb "wm-launch-gui" [])
    $oks = ($oks | append (check ($r.exit_code == 2 and (logw $sb detach | length) == $n) "3i gui-empty-2: exit 2, nothing launched"))
    ^rm -rf $sb

    # 3j: ssh registry entry
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st" "--workspace" "sshws"])
    let tw = (calls (logw $sb tmux-to-workstation))
    $oks = ($oks | append (check ($r.exit_code == 0 and $tw == [["connect" "--no-attach" "-g" "sshws" "--cwd" "/srv/p" "--" "myhost"]] and (logw $sb tmux-start) == [] and (calls (logw $sb detach)) == [["--set" "TMUX_TARGET=thin_remote" "--" "st"]]) $"3j ssh-entry: --workspace takes the remote branch \(($tw | to nuon)\)"))
    let r = (t3-run $sb $T ["st" "--workspace" "sshws" "--session" "x"])
    let r2 = (t3-run $sb $T ["st" "--session" "x"] ["STUB_WS=sshws"])
    $oks = ($oks | append (check ($r.exit_code == 2 and $r2.exit_code == 0 and (calls (logw $sb tmux-to-workstation) | length) == 1 and (calls (logw $sb detach) | last) == ["--set" "TMUX_TARGET=x" "--" "st"]) "3j ssh-entry: --session still wins over a focused ssh workspace (no second remote connect)"))
    ^rm -rf $sb

    # 3k: tmux-start fails
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st"] ["STUB_TS_FAIL=1"])
    $oks = ($oks | append (check ($r.exit_code == 7 and ($r.stderr | str contains "tmux-start boom") and (logw $sb detach) == []) "3k tmux-start-fails: its exit code and stderr surface, nothing launched"))
    ^rm -rf $sb

    # 3l: --dry-run is forwarded to detach (and tested end to end with the REAL detach)
    let sb = (stub-home)
    let r = (t3-run $sb $T ["st" "--session" "s1" "--class" "C" "--dry-run"])
    $oks = ($oks | append (check ($r.exit_code == 0 and (calls (logw $sb detach)) == [["--dry-run" "--set" "TMUX_TARGET=s1" "--" "st" "-c" "C"]]) "3l dry-run forwarded first to detach"))
    let r = (t3-run $sb "wm-launch-gui" ["--dry-run" "firefox"])
    $oks = ($oks | append (check ($r.exit_code == 0 and (calls (logw $sb detach) | last) == ["--dry-run" "--" "firefox"]) "3l gui dry-run forwarded to detach"))
    ^rm -rf $sb
    let rs = (session)
    try {
        ^mkdir -p $"($rs.sb)/home/.local/bin" $"($rs.sb)/home/.config/nushell/scripts/project"
        # wm-launch-terminal `use`s the project module at PARSE time, so it must exist even to run --session
        "export def lookup [name: string] { null }\n" | save --raw $"($rs.sb)/home/.config/nushell/scripts/project/mod.nu"
        $"#!/bin/sh\nexec ($nu.current-exe) ($here)/wm-launch-detach \"$@\"\n" | save --raw $"($rs.sb)/home/.local/bin/wm-launch-detach"
        ^chmod +x $"($rs.sb)/home/.local/bin/wm-launch-detach"
        "#!/bin/sh\nexit 0\n" | save --raw $"($rs.tb)/st"
        ^chmod +x $"($rs.tb)/st"
        let r = (^env -i ...$rs.base $nu.current-exe $"($here)/wm-launch-terminal" st --session s1 --class C --dry-run | complete)
        $oks = ($oks | append (check ($r.exit_code == 0 and ($r.stdout | str trim) == "x11 st -c C") $"3l real detach dry-run prints `x11 st -c C` \(got '($r.stdout | str trim)', stderr '($r.stderr | str trim)'\)"))
    } finally { ^rm -rf $rs.sb }

    let failed = ($oks | where {|x| not $x } | length)
    print ""
    print $"wm-launch-test: (($oks | length) - $failed) passed, ($failed) failed"
    if $failed > 0 { exit 1 }
}
