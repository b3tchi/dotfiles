#!/usr/bin/env nu
# preview — thin CLI wrapper around the preview-d daemon (ft005).
#
# Usage:
#   preview start                          # idempotent daemon launch (port-probe -> pidfile -> detach)
#   preview stop                           # graceful stop (closes windows, then POST /stop + SIGTERM fallback)
#   preview status                         # daemon health (pid / root / port / started_at)
#   preview show <path> [--window N]       # one-shot: /-rooted daemon + window + send + print URL
#   preview send <path> [--window N]       # POST {path} to /preview<N> (default window 1)
#   preview register <addr> [--slot N]     # POST {nvim, slot?} to /register, prints assigned slot
#   preview window [N] [--close]           # idempotent native qml6 window spawn/close (default N=1)
#
# Mirrors nushell/actions/akm-graph + nushell/actions/d2-router (adr0001
# nushell-first surface, adr0003 mandatory-wrapper mandate — preview-d and
# the qml6-hosted PreviewView.qml client are engines, not interfaces; no
# consumer calls either directly). sp008 Task 1 wired start/stop/status;
# sp008 Task 5 adds `send` (the editor/nnn cursor-signal path) without
# changing this shape. The `open` verb (reverse channel) lands in sp008
# Task 6. sp009 Task 3 adds `register` so each nvim instance can claim its
# own slot instead of every instance defaulting to window 1
# (nvim/plugins/preview.lua calls this on `:PreviewStart`). sp013 Task 2
# adds `window` — lifecycle control for the webview client host — with the
# same probe/pidfile discipline `start` already uses, plus mandatory
# /proc/<pid>/cmdline verification before any SIGTERM (pid recycling is a
# ship-blocker anti-pattern per the sp013 plan). `stop` now closes all open
# windows before touching the daemon. sp022 Task 6 replaces the preview-wv
# GTK/WebKit engine with `qml6 PreviewView.qml -- <N> <port>` (one native
# Qt Quick process per slot — sp022's hard requirement) and, with it,
# window IDENTITY: the daemon-style substring cmdline check could not tell
# slot 1's pidfile from slot 2's live window (## problem, sp022.md), so
# window identity is now an exact-argument check on /proc/<pid>/cmdline
# (window-cmdline-matches) instead, and window PLACEMENT (place-window)
# resolves windows by pid (`xdotool search --pid` -> `[id=…]` under i3,
# native `[pid=…]` under sway) instead of by WM_CLASS — qml6's WM_CLASS is
# the runtime's own identity ("qml6"/"Qml Runtime", poc016), shared with
# every other qml6-hosted app in the repo (d2-view), so class matching was
# never viable for this engine. sp022 Task 7 collapses the docking mechanism
# itself: [[poc016]] proved a qml6 window survives being split/moved/
# reparented AFTER it has already mapped (the old wry host did not, hence
# the pre-map split-then-move-the-terminal choreography), so docking is now
# spawn -> resolve the window by pid (bounded poll) -> mark the launching
# frame -> move the PREVIEW window's container to that mark + reorder —
# ordinary i3/sway, applied identically whether the window is fresh or
# already live. `show` re-docks a live window on every call (the "docks
# only on first open" limitation is gone); `window` still docks a fresh
# window to the right, same mechanism.

const DAEMON_BIN = "preview-d"
const QML_RUNTIME = "qml6"
const QML_REL_DIR = "preview/qml"
const QML_FILE = "PreviewView.qml"

# How long place-window waits for a detached window to be mapped before
# giving up (dotfiles-816). 20 × 150ms ≈ 3s — comfortably longer than a
# webview takes to map, short enough that a window which never appears
# doesn't stall the caller. Placement is best-effort: expiring here leaves
# the window where the WM put it, which is what happened before this
# existed, not a failure worth erroring on.
const PLACE_ATTEMPTS = 20
const PLACE_POLL = 150ms
const CACHE_DIR  = "~/.cache/preview"
const PID_FILE   = "~/.cache/preview/pid"
const LOG_FILE   = "~/.cache/preview/log"

# Resolve the daemon port from the environment (mirrors daemon default 4200).
def preview-port [] {
    $env | get -o PREVIEW_PORT | default "4200"
}

# Base URL for the daemon API.
def api-base [] {
    $"http://127.0.0.1:(preview-port)"
}

# Resolve the preview root: $PREVIEW_ROOT, else the akm-root helper, else cwd.
def preview-root [] {
    let env_root = ($env | get -o PREVIEW_ROOT | default "")
    if ($env_root | is-not-empty) {
        return $env_root
    }
    let resolved = (do { ^akm-root } | complete)
    if $resolved.exit_code == 0 and ($resolved.stdout | str trim | is-not-empty) {
        return ($resolved.stdout | str trim)
    }
    (pwd)
}

# Probe /status. Returns parsed JSON or null on connection failure.
def probe-status [] {
    try {
        http get --max-time 2sec $"(api-base)/status"
    } catch {
        null
    }
}

# Read an int pid from an arbitrary pidfile path. Returns null if absent,
# empty, or unreadable — shared by the daemon pidfile and each window's
# per-N pidfile.
def read-pidfile-at [path: string] {
    if ($path | path exists) {
        try { open $path | str trim | into int } catch { null }
    } else {
        null
    }
}

# Ensure the pidfile's parent dir exists (edge case: cache dir missing —
# created), then write the pid.
def write-pidfile-at [path: string, pid: int] {
    let dir = ($path | path dirname)
    if not ($dir | path exists) {
        mkdir $dir
    }
    $pid | into string | save --force $path
}

# Read the pid from the daemon pidfile. Returns null if absent or unreadable.
def read-pidfile [] {
    read-pidfile-at ($PID_FILE | path expand)
}

# Check if a pid is alive (kill -0 equivalent). Returns bool.
def pid-alive [pid: int] {
    (do { ^kill -0 $pid } | complete | get exit_code) == 0
}

# /proc/<pid>/cmdline as a list of argv elements, split on the NUL bytes
# the kernel separates them with. [] on any read failure (pid gone, no
# permission, ...) — never throws, mirroring the old pid-cmdline-matches
# contract of "can't verify == doesn't match".
def cmdline-args [pid: int] {
    let cmdline_path = $"/proc/($pid)/cmdline"
    if not ($cmdline_path | path exists) {
        return []
    }
    try {
        (open --raw $cmdline_path) | split row (char -i 0)
    } catch {
        []
    }
}

# Verify /proc/<pid>/cmdline is actually slot N's qml6 window before any
# SIGTERM is sent — the anti-pattern sp013's plan calls a ship-blocker: a
# recycled pid could otherwise belong to an unrelated process. sp022 Task 6
# replaces the old daemon-binary-name substring check with an EXACT-argument
# check: require an argv element ending in PreviewView.qml AND an argv
# element exactly equal to N. Substring-on-binary-name was not enough once
# every slot invokes the same `qml6 PreviewView.qml -- <N> <port>` shape —
# it could not tell slot 1's pidfile from slot 2's live window (the ##
# problem bug: both cmdlines contain "PreviewView.qml", and both share the
# daemon's port, so neither is a safe needle — only the slot number is
# unique per window). Never throws: unreadable/missing cmdline degrades to
# false, same "can't verify == doesn't match" contract as before.
def window-cmdline-matches [pid: int, n: int] {
    let args = (cmdline-args $pid)
    if ($args | is-empty) {
        return false
    }
    let has_qml = ($args | any {|a| $a | str ends-with $QML_FILE })
    let has_n = ($args | any {|a| $a == ($n | into string) })
    $has_qml and $has_n
}

# Resolve the absolute path to PreviewView.qml: akm-root (falling back to
# ~/.dotfiles when it fails or is missing) joined with preview/qml/. Loud
# error naming the resolved path if the file isn't there (sp022 Task 6 edge
# case: akm-root failing -> ~/.dotfiles fallback; QML file missing there ->
# loud error naming the path).
def qml-view-path [] {
    let resolved = if (which akm-root | is-empty) {
        null
    } else {
        (do { ^akm-root } | complete)
    }
    let root = if $resolved != null and $resolved.exit_code == 0 and ($resolved.stdout | str trim | is-not-empty) {
        $resolved.stdout | str trim
    } else {
        "~/.dotfiles" | path expand
    }
    let qml = ($root | path join $QML_REL_DIR $QML_FILE)
    if not ($qml | path exists) {
        error make { msg: $"preview: ($QML_FILE) not found at ($qml)" }
    }
    $qml
}

# The X display number from a DISPLAY value: ":10.0" -> "10", ":0" -> "0".
# null when DISPLAY is empty, remote ("host:10"), or otherwise malformed
# (mirrors preview-webview's display_number, the Rust seam this ports).
def display-number [display: string] {
    if not ($display | str starts-with ":") {
        return null
    }
    let rest = ($display | str substring 1..)
    let num = ($rest | split row "." | first)
    if ($num | is-empty) {
        return null
    }
    try {
        $num | into int | ignore
        $num
    } catch {
        null
    }
}

# Reports whether `display` (":10.0" style) is served by an xorgxrdp
# virtual Xorg, matched by finding a running Xorg whose cmdline carries
# this display's EXACT token (":N") and mentions xrdp. xorg_cmdlines is
# injected so this is unit-testable without /proc — mirrors
# preview-webview's is_xrdp_display/running_xorg_cmdlines seam
# ([[adr0004]]/[[adr0005]]; preview-test table-tests this directly via
# `use`). Deliberately per-display: a desktop can run native :0 (real GPU)
# alongside xrdp :10, and only the latter needs software GL.
export def is-xrdp-display [display: string, xorg_cmdlines: list<string>] {
    let n = (display-number $display)
    if $n == null {
        return false
    }
    let tok = $":($n)"
    $xorg_cmdlines | any {|c|
        ($c | str contains --ignore-case "xrdp") and (($c | split row " ") | any {|t| $t == $tok })
    }
}

# Chromium command-line flags QtWebEngine needs before it will hand the web
# tier a WebGL context on a GPU-less virtual Xorg. Measured on a real
# xorgxrdp session (dotfiles-14kr): without these, the stl tier dies with
# "ContextResult::kFatalFailure: WebGL1/WebGL2 blocklisted" ->
# "THREE.WebGLRenderer: Error creating WebGL context." and the window shows
# "failed to load STL: Error creating WebGL context." Chromium's own GPU
# blocklist is what refuses, so the fix is Chromium-side: swiftshader as the
# GL implementation (--use-gl=angle --use-angle=swiftshader),
# --enable-unsafe-swiftshader to lift the blocklist that otherwise rejects
# a software GL backend outright, and --disable-gpu-compositing so the
# compositor does not also try for a hardware context.
const XRDP_CHROMIUM_FLAGS = "--enable-unsafe-swiftshader --use-gl=angle --use-angle=swiftshader --disable-gpu-compositing"

# Chromium flags that BOUND the web tier's per-navigation memory growth
# (dotfiles-j5kq / sp022 T10). Applied on EVERY display, not just
# xorgxrdp — nothing about the mechanism is display-specific.
#
# MECHANISM (measured, not guessed — full numbers in preview/README.md):
# the web tier navigates ONE long-lived WebEngineView, so ONE renderer
# process serves every html/akm/stl visit for the window's whole life. Each
# akm visit leaves ~40 MB of dead JS (the cross-origin akm-graph iframe
# re-parses ~1 MB of bundle and re-allocates the graph's typed arrays), and
# V8 does not collect it until its own old-space limit is reached. V8 sizes
# that limit from physical RAM, so on a 24 GB host the renderer climbed to
# ~1.49 GB before its first major GC — which reads as an unbounded leak to
# anyone who stops measuring first. It is not a leak: a 60-cycle
# page.html <-> adr0009.md loop grew ~39 MB/cycle to 1.49 GB, then went
# FLAT (+1.1 MB/cycle) for the remaining 28 cycles. A deduped
# /proc/<pid>/task/*/children PSS walk put 100% of the growth in the single
# renderer child (136 MB -> 1266 MB) with the qml6 browser process flat at
# ~176 MB, and smaps put it in V8's two pools (the sandbox anon region
# 510 MB + [anon:v8] 206 MB).
#
# So the fix is to choose the ceiling instead of letting V8 derive one from
# host RAM: --max-old-space-size=256 moves the plateau to ~600 MB total PSS,
# reached by navigation ~14 and flat after (proof by intervention — the same
# loop, same rig, same scripts). 256 MB is ~2x the measured first-visit
# working set of the heaviest tier, which is the headroom that keeps this a
# ceiling rather than a GC-thrash / renderer-OOM trap.
#
# Passed as ONE token: QtWebEngine splits QTWEBENGINE_CHROMIUM_FLAGS on
# whitespace with no quote handling, so a --js-flags value may not contain
# spaces (multiple V8 flags would need a different transport).
const MEMORY_CHROMIUM_FLAGS = "--js-flags=--max-old-space-size=256"

# The `VAR=value ` prefix window-spawn prepends to its `bash -c` launch line,
# given whether the target display is xorgxrdp and whatever
# QTWEBENGINE_CHROMIUM_FLAGS the caller already has set (""=unset). Factored
# out of window-spawn so preview-test can table-test it without a real Xorg
# (the is-xrdp-display seam pattern).
#
# On a native display: no Qt/GL overrides — real GL, real GPU — but the
# Chromium memory ceiling still applies (MEMORY_CHROMIUM_FLAGS above: V8's
# default old-space limit is derived from host RAM, not from the display
# server, so the unbounded-looking growth of dotfiles-j5kq is not an
# xrdp phenomenon and must not be fixed only there).
#
# On xorgxrdp, THREE things are needed, and dotfiles-14kr's 2x2 matrix on a
# real xorgxrdp session settled which does what:
#
#   QT_QUICK_BACKEND=software + LIBGL_ALWAYS_SOFTWARE=1
#     Qt Quick's own scenegraph, per [[adr0004]]/[[adr0005]] and the
#     i3/config-xrdp precedent (a GPU-less virtual Xorg wedges hardware GL,
#     dotfiles-49j). MEASURED ORTHOGONAL to the web tier: every tier
#     (image/md/code/html/akm) renders identically with and without this
#     pair, and the stl tier's WebGL failure reproduces with the pair
#     ABSENT too — so the pair was never the web tier's problem, contrary
#     to dotfiles-14kr's original hypothesis. It stays.
#
#   QTWEBENGINE_CHROMIUM_FLAGS=<XRDP_CHROMIUM_FLAGS>
#     QtWebEngine's separate Chromium GPU stack, which has its own
#     blocklist and does NOT consult either Qt var above. This is what
#     actually fixes stl. Set only when the caller has not set it: an
#     explicit QTWEBENGINE_CHROMIUM_FLAGS in the environment is a
#     deliberate override and wins (overriding it would make the var
#     un-settable, since a duplicate assignment on the launch line would
#     always shadow the inherited one). That deference covers the memory
#     ceiling too: a caller who takes over the flag string owns the whole
#     Chromium command line, ceiling included.
export def spawn-env-prefix [xrdp: bool, caller_chromium_flags: string] {
    let chromium = if ($caller_chromium_flags | is-not-empty) {
        ""
    } else {
        let flags = if $xrdp {
            $"($XRDP_CHROMIUM_FLAGS) ($MEMORY_CHROMIUM_FLAGS)"
        } else {
            $MEMORY_CHROMIUM_FLAGS
        }
        $"QTWEBENGINE_CHROMIUM_FLAGS='($flags)' "
    }
    if not $xrdp {
        return $chromium
    }
    $"QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 ($chromium)"
}

# Space-joined argv of every running Xorg, read from /proc (mirrors
# preview-webview's running_xorg_cmdlines). Empty on any read failure — a
# detection miss degrades to "not xrdp" (no guard), never worse.
def running-xorg-cmdlines [] {
    if not ("/proc" | path exists) {
        return []
    }
    let entries = (try { ls /proc } catch { [] })
    $entries
    | each {|e|
        let pid = (try { ($e.name | path basename) | into int } catch { null })
        if $pid == null {
            ""
        } else {
            (cmdline-args $pid) | str join " "
        }
    }
    | where {|c| $c | str contains "Xorg" }
}

# Ensure cache dir and write the daemon pidfile.
def write-pidfile [pid: int] {
    write-pidfile-at ($PID_FILE | path expand) $pid
}

# Path to window N's pidfile.
def window-pid-file [n: int] {
    $"($CACHE_DIR)/wv-($n).pid" | path expand
}

# Path to window N's spawn log.
def window-log-file [n: int] {
    $"($CACHE_DIR)/wv-($n).log" | path expand
}

# Idempotent start: port-probe first, pidfile second, then detached launch.
# Idempotent start. root_override forces a specific root (the `show` verb
# passes "/" so any absolute path previews); omitted, it resolves the normal
# $PREVIEW_ROOT/akm-root/cwd chain.
def main-start [root_override?: string] {
    # 1. Port probe — if the daemon is already answering, no-op.
    let live = (probe-status)
    if $live != null {
        print $"preview: daemon already running \(pid ($live.pid)\) on port (preview-port) — no-op"
        return
    }

    # 2. Binary check — fail loud with an actionable message.
    if (which $DAEMON_BIN | is-empty) {
        error make {
            msg: $"preview: '($DAEMON_BIN)' not found on PATH — run: rotz install preview"
        }
    }

    # 3. Stale pidfile cleanup.
    let old_pid = (read-pidfile)
    if $old_pid != null {
        if (pid-alive $old_pid) {
            print $"preview: ERROR — port (preview-port) appears occupied by pid ($old_pid) (not preview-d); refusing to start"
            error make { msg: "preview: port occupied by foreign process" }
        } else {
            print $"preview: stale pidfile \(pid ($old_pid) dead\) — cleaning up"
            rm --force ($PID_FILE | path expand)
        }
    }

    # 4. Detached launch on the resolved root + port.
    let log  = ($LOG_FILE | path expand)
    let dir  = ($CACHE_DIR | path expand)
    let root = (if ($root_override | is-empty) { (preview-root) } else { $root_override })
    let port = (preview-port)
    if not ($dir | path exists) {
        mkdir $dir
    }

    # nohup + bash & echo $! detaches the daemon from the current session.
    let pid_result = (do {
        ^bash -c $"PREVIEW_PORT=($port) nohup ($DAEMON_BIN) --root '($root)' >>($log) 2>&1 & echo $!"
    } | complete)

    if $pid_result.exit_code != 0 {
        error make { msg: $"preview: failed to launch daemon: ($pid_result.stderr)" }
    }

    let new_pid = ($pid_result.stdout | str trim | into int)
    write-pidfile $new_pid

    # Readiness gate: callers treat `start` returning as "the daemon is
    # answering" (nvim :PreviewStart registers immediately after, dotfiles-nbt),
    # so block until /status responds — bounded so a crashed daemon fails
    # loud instead of hanging.
    mut ready = false
    for _ in 1..50 {
        if (probe-status) != null { $ready = true; break }
        sleep 100ms
    }
    if not $ready {
        error make { msg: $"preview: daemon \(pid ($new_pid)\) not answering on port ($port) after 5s — check ($log)" }
    }
    print $"preview: started \(pid ($new_pid)\), root ($root), port ($port), logging to ($log)"
}

# Close window N: SIGTERM the pidfile's pid, but only after
# /proc/<pid>/cmdline confirms it is actually slot N's qml6 window — a
# recycled pid (alive, but now belongs to something else, OR belongs to a
# DIFFERENT slot's qml6 window) is treated as stale and is never signaled
# (sp013 Task 2 edge case, tightened by sp022 Task 6's exact-argument
# check). Always removes the pidfile on the way out so this is safe to call
# repeatedly (double `--close` is a clean idempotent no-op) and safe to
# call on a window that was never opened (no pidfile -> clean message,
# exit 0).
def window-close [n: int] {
    let pid_file = (window-pid-file $n)
    let pid = (read-pidfile-at $pid_file)
    if $pid == null {
        print $"preview: window ($n) not open — nothing to close"
        return
    }
    if (pid-alive $pid) and (window-cmdline-matches $pid $n) {
        ^kill -TERM $pid
        print $"preview: closed window ($n) \(pid ($pid)\)"
    } else if (pid-alive $pid) {
        print $"preview: window ($n) pidfile pid ($pid) is alive but is not slot ($n)'s ($QML_RUNTIME) window \(recycled pid\) — leaving it running, cleaning up stale pidfile"
    } else {
        print $"preview: window ($n) pidfile stale \(pid ($pid) dead\) — cleaning up"
    }
    rm --force $pid_file
}

# Idempotent spawn of window N's qml6 process, guarded by a per-window
# pidfile — the same probe/pidfile discipline `main-start` uses for the
# daemon (sp013 Task 2 success criteria). sp022 Task 6: the engine is now
# `qml6 PreviewView.qml -- <N> <port>` (one native Qt Quick process per
# slot) instead of the GTK/WebKit preview-wv binary.
def window-spawn [n: int] {
    let pid_file = (window-pid-file $n)

    # 1. Existing pidfile check — alive + cmdline-verified -> no-op. Alive
    #    but mismatched (recycled pid, or another slot's live window) or
    #    dead -> stale, clean the pidfile but never signal the foreign
    #    process, then fall through to spawn.
    let existing = (read-pidfile-at $pid_file)
    if $existing != null {
        if (pid-alive $existing) and (window-cmdline-matches $existing $n) {
            print $"preview: window ($n) already open \(pid ($existing)\) — no-op"
            return
        } else {
            print $"preview: window ($n) stale pidfile \(pid ($existing)\) — cleaning up and respawning"
            rm --force $pid_file
        }
    }

    # 2. Binary check — fail loud, naming the qt packages qml6 ships in
    #    (rather than a `rotz install` target: qml6 is a system Qt binary,
    #    not one of this repo's own build outputs).
    if (which $QML_RUNTIME | is-empty) {
        error make {
            msg: $"preview: '($QML_RUNTIME)' not found on PATH — install qt6-base qt6-declarative qt6-svg qt6-websockets \(rotz install preview\), then retry"
        }
    }

    # 3. Daemon check — no window spawn when the daemon is down (sp013
    #    plan anti-pattern: probe /status first, loud error pointing at
    #    `preview start`).
    if (probe-status) == null {
        error make {
            msg: $"preview: daemon not answering on port (preview-port) — run: preview start"
        }
    }

    # 4. Resolve the QML client file — akm-root with ~/.dotfiles fallback,
    #    loud error naming the path if missing there either.
    let qml = (qml-view-path)

    # 5. Detached spawn, inheriting the caller's environment
    #    (DISPLAY/XAUTHORITY carry through automatically; PREVIEW_PORT is
    #    set explicitly to mirror main-start's convention).
    #    QT_FORCE_STDERR_LOGGING=1 (d2-view precedent) is what makes
    #    console.log/warn/error AND qml6's own usage-line stderr actually
    #    land in wv-<N>.log — without it both are silently swallowed
    #    (measured: bad args -> rc=2, zero output).
    #    On an xorgxrdp display, spawn-env-prefix forces software GL for the
    #    Qt Quick scenegraph the same way preview-wv's is_xrdp_display guard
    #    did — a GPU-less virtual Xorg wedges hardware GL (dotfiles-49j) —
    #    AND hands QtWebEngine's separate Chromium GPU stack the swiftshader
    #    flags the web tier needs for WebGL there (dotfiles-14kr). Native
    #    displays (including no Xorg at all, e.g. sway) get none of the GL
    #    overrides — but they DO get the Chromium memory ceiling, which is
    #    display-independent (MEMORY_CHROMIUM_FLAGS, dotfiles-j5kq).
    let dir = ($CACHE_DIR | path expand)
    if not ($dir | path exists) {
        mkdir $dir
    }
    let log  = (window-log-file $n)
    let port = (preview-port)

    let display = ($env | get -o DISPLAY | default "")
    let xrdp = (is-xrdp-display $display (running-xorg-cmdlines))
    let extra_env = (spawn-env-prefix $xrdp ($env | get -o QTWEBENGINE_CHROMIUM_FLAGS | default ""))
    if $xrdp {
        print $"preview: xorgxrdp display ($display) — forcing software GL + swiftshader WebGL for window ($n)"
    }

    let pid_result = (do {
        ^bash -c $"PREVIEW_PORT=($port) QT_FORCE_STDERR_LOGGING=1 ($extra_env)nohup ($QML_RUNTIME) ($qml) -- ($n) ($port) >>($log) 2>&1 & echo $!"
    } | complete)

    if $pid_result.exit_code != 0 {
        error make { msg: $"preview: failed to launch window ($n): ($pid_result.stderr)" }
    }

    let new_pid = ($pid_result.stdout | str trim | into int)
    write-pidfile-at $pid_file $new_pid
    place-window $n
    print $"preview: opened window ($n) \(pid ($new_pid)\)"
}

# Read slot n's recorded workspace off the daemon, or "" if the daemon has
# none (no nvim ever registered for this slot — e.g. a window opened straight
# from a shell) or is unreachable. Never errors: placement is best-effort
# decoration on top of a window that already exists.
def slot-workspace [n: int] {
    let rows = (try {
        http get --max-time 2sec $"(api-base)/slots"
    } catch { return "" })
    let row = ($rows | where slot == $n)
    if ($row | is-empty) { return "" }
    ($row | get 0.workspace)
}

# Window N's X11 id, resolved via `xdotool search --pid` — needed only
# under i3, which has no native pid-match criteria (sway's `[pid=…]`
# criterion needs no xdotool at all, see place-window below). null when
# xdotool is missing, the pid has no mapped window yet, or the search
# fails.
def window-xid-for-pid [pid: int] {
    if (which xdotool | is-empty) { return null }
    let r = (do { ^xdotool search --pid $pid } | complete)
    if $r.exit_code != 0 { return null }
    let out = ($r.stdout | str trim)
    if ($out | is-empty) { return null }
    try { $out | lines | first | into int } catch { null }
}

# Move window n to the workspace its nvim registered from (dotfiles-816), so
# the preview lands beside the editor driving it rather than wherever the
# spawning shell happened to be focused.
#
# A no-op when the slot has no recorded workspace: the WM's default
# placement is the correct fallback, and inventing a workspace would be
# worse than leaving it alone.
#
# sp022 Task 6: resolution is pid-based, not class-based. qml6's WM_CLASS is
# the RUNTIME's own identity ("qml6"/"Qml Runtime", poc016) — shared by
# every qml6-hosted app in the repo (d2-view included) — so a class (or
# class+title) criterion was never viable for this engine the way it was
# for the old dedicated preview-wv binary. sway has a native `[pid=…]`
# criterion; i3 does not, so the i3 branch resolves the pid to an X11 id via
# xdotool first and matches on `[id=…]`. I3SOCK is unset for the same
# wrong-session reason as current-workspace.
def place-window [n: int] {
    let ws = (slot-workspace $n)
    if ($ws | is-empty) { return }
    # If the recorded workspace is the one already focused, a `move workspace`
    # only yanks the window out of its dock split into a plain tab on the SAME
    # workspace — which is exactly what made nvim :PreviewStart open an
    # invisible tab (dotfiles-nmp). The dock (prepare-split in main-window)
    # already positioned it here; leave it. Cross-workspace moves still run so
    # the dotfiles-816 "preview follows the editor to another workspace" case
    # keeps working.
    if $ws == (current-workspace) { return }
    let pid = (read-pidfile-at (window-pid-file $n))
    if $pid == null { return }
    for bin in [swaymsg i3-msg] {
        if (which $bin | is-empty) { continue }
        # The window was spawned DETACHED, so it is usually not mapped yet
        # when we get here — i3 then matches nothing, and the exit code does
        # NOT say so: i3-msg exits 0 while reporting {"success": false,
        # "error": "Nothing to move: ..."} in its body. Trusting the exit
        # code silently no-ops, which is exactly how this first shipped
        # broken. Poll on the body's success flag instead, bounded, so a
        # window that never appears costs a bounded wait rather than a hang.
        for attempt in 1..($PLACE_ATTEMPTS) {
            let criteria = if $bin == "swaymsg" {
                $"[pid=($pid)]"
            } else {
                let xid = (window-xid-for-pid $pid)
                if $xid == null {
                    sleep $PLACE_POLL
                    continue
                }
                $"[id=($xid)]"
            }
            let r = (do {
                ^env -u I3SOCK $bin $"($criteria) move workspace ($ws)"
            } | complete)
            if $r.exit_code == 0 {
                let ok = (try {
                    $r.stdout | from json | get 0.success
                } catch { false })
                if $ok { return }
            }
            sleep $PLACE_POLL
        }
    }
}

# `preview window [N] [--close]` — default N=1.
def main-window [n: int, close: bool] {
    if $close {
        window-close $n
        return
    }
    # Dock the window beside the launching frame as a side split (preview to
    # the right), visible next to the editor — the design the i3 config
    # describes ("sits beside the editor like a split"), and the fix for nvim
    # :PreviewStart opening an invisible tab (dotfiles-nmp). No image shape is
    # known here (nvim previews many files), so the direction is fixed rather
    # than shape-chosen as in `show`. Dock AFTER spawn (sp022 Task 7): a qml6
    # window survives being moved post-map ([[poc016]]), so there is no need
    # to pre-split before it maps the way the old wry host required.
    # Degrades gracefully headless: no frame (no X session) -> window-spawn
    # still runs, dock-window-into-place's own no-WM/no-pidfile guards handle
    # the rest.
    let orig = (active-window-id)
    window-spawn $n
    if $orig != null {
        dock-window-into-place $n $orig "right"
    }
}

# Close every open window (wv-*.pid) — called by `stop` before it touches
# the daemon (sp013 Task 2 success criteria). Missing cache dir is a
# no-op, not an error.
def close-all-windows [] {
    let dir = ($CACHE_DIR | path expand)
    if not ($dir | path exists) {
        return
    }
    let files = (try { glob ($dir | path join "wv-*.pid") } catch { [] })
    for pid_file in $files {
        let base = ($pid_file | path basename)
        let n = (try { $base | str replace "wv-" "" | str replace ".pid" "" | into int } catch { null })
        if $n != null {
            window-close $n
        }
    }
}

# Stop the daemon: close all windows first, then POST /stop, then SIGTERM
# the recorded pid. All steps are safe to repeat — a POST /stop against an
# already-stopped daemon just fails the try (probe-status style) and a
# missing/dead pid is a no-op, so a second `preview stop` is a clean
# idempotent no-op rather than an error (sp008 Task 1 edge case: double
# stop; sp013 Task 2 extends this to windows too).
def main-stop [] {
    close-all-windows

    let sent = (try {
        http post --max-time 2sec $"(api-base)/stop" ""
        true
    } catch {
        false
    })
    if $sent {
        print "preview: sent stop to daemon"
    }

    let pid = (read-pidfile)
    if $pid != null {
        if (pid-alive $pid) {
            ^kill -TERM $pid
            print $"preview: sent SIGTERM to pid ($pid)"
        } else {
            print $"preview: pid ($pid) already gone"
        }
        rm --force ($PID_FILE | path expand)
    } else if not $sent {
        print "preview: not running (no pidfile, no response on port (preview-port))"
    }
}

# Print daemon health as a nu record, or a clean "not running" message —
# never a stack trace — when the daemon is down (sp008 Task 1 test_plan).
def main-status [] {
    let data = (probe-status)
    if $data == null {
        print $"preview: not running — no response on port (preview-port)"
        return
    }
    $data | select pid root port started_at
}

# Push a path to window N's slot: POST /preview<N> {"path": <path>} (ft005
# api_surface `send` verb — sp008 Task 5). This is the wrapper both nvim's
# CursorHold/CursorMoved autocmd (nvim/plugins/preview.lua) and nnn's
# preview hook call — nothing calls the daemon directly ([[adr0003]]). A
# missing/empty path (e.g. a caller forgetting to guard a no-file buffer)
# is a loud error, not a silent no-op, so misuse surfaces immediately in a
# manual run — the guarding against "no file to send" lives in the callers
# (nvim autocmd's should_send / nnn hook's directory check), per the sp008
# Task 5 edge cases.
def main-send [path?: string, window: int = 1] {
    if ($path | is-empty) {
        error make { msg: "preview: send requires a path" }
    }
    let url = $"(api-base)/preview($window)"
    try {
        http post --max-time 2sec --content-type application/json $url { path: $path }
    } catch { |err|
        error make { msg: $"preview: send failed — ($err.msg)" }
    }
    print $"preview: sent ($path) to window ($window)"
}

# Ensure a running daemon rooted at "/" so `show` can preview ANY absolute
# path without a per-call restart (localhost-only, no-auth, single-user — the
# jail is relaxed to the whole filesystem on purpose; see dotfiles-ad7). Down
# -> start at /. Up but rooted narrower (e.g. an nvim/nnn session started it
# at the repo root) -> one-time restart at /, which is a superset so those
# consumers keep resolving. Already at / -> no-op.
def ensure-daemon-slash [] {
    let st = (probe-status)
    if $st == null {
        main-start "/"
    } else if $st.root != "/" {
        print $"preview: daemon rooted at ($st.root) — restarting at / so any path previews"
        main-stop
        main-start "/"
    }
}

# ── shape-based docking (dotfiles-bfk) ───────────────────────────────────
#
# `preview show` docks the window beside the frame it was launched from
# instead of tabbing into whatever i3 container has focus. Split direction
# follows image shape: landscape -> above (top), portrait -> left, square ->
# below (or a tab when the frame is too short to usefully split). Always
# tiled, never floating (the i3 config carries no float rule for the
# preview window).

# Aspect bands: w/h > SQUARE_HI is landscape, < SQUARE_LO is portrait, in
# between is square. SQUARE_MIN_H is the launching frame height (px) below
# which a square image tabs rather than splitting below — a below-split of a
# short frame leaves two unusably thin panes.
const SQUARE_LO = 0.8
const SQUARE_HI = 1.25
const SQUARE_MIN_H = 900

# The X11 id of the window focused right now — captured at launch to remember
# the "original frame" before any preview window steals a spot in the tree.
# null when there is no X session / xdotool (Termux, headless).
def active-window-id [] {
    if (which xdotool | is-empty) { return null }
    let r = (do { ^xdotool getactivewindow } | complete)
    if $r.exit_code != 0 { return null }
    try { $r.stdout | str trim | into int } catch { null }
}

# Image pixel dimensions as {w, h}, or null if they can't be read. Prefers
# ImageMagick `identify` (authoritative); falls back to parsing `file`'s
# "W x H" — taking the LAST match, since JPEG headers report a density pair
# (e.g. "72 x 72") before the real dimensions.
def image-dims [path: string] {
    if (which identify | is-not-empty) {
        let r = (do { ^identify -format "%w %h" $path } | complete)
        if $r.exit_code == 0 {
            let parts = ($r.stdout | str trim | split row " ")
            if ($parts | length) >= 2 {
                let d = (try { {w: ($parts.0 | into int), h: ($parts.1 | into int)} } catch { null })
                if $d != null { return $d }
            }
        }
    }
    if (which file | is-empty) { return null }
    let r = (do { ^file -b $path } | complete)
    if $r.exit_code != 0 { return null }
    let m = ($r.stdout | parse -r '(?<w>\d+)\s*x\s*(?<h>\d+)')
    if ($m | is-empty) { return null }
    try { {w: ($m | last | get w | into int), h: ($m | last | get h | into int)} } catch { null }
}

# Height in px of window `id`, or null. Used for the square-frame-too-short
# tab fallback.
def window-height [id: int] {
    if (which xdotool | is-empty) { return null }
    let r = (do { ^xdotool getwindowgeometry --shell $id } | complete)
    if $r.exit_code != 0 { return null }
    let line = ($r.stdout | lines | where ($it | str starts-with "HEIGHT="))
    if ($line | is-empty) { return null }
    try { ($line | first | str replace "HEIGHT=" "" | into int) } catch { null }
}

# The active WM control binary (i3 or sway — identical split/move syntax), or
# null if neither is present.
def wm-bin [] {
    for bin in [i3-msg swaymsg] {
        if (which $bin | is-not-empty) { return $bin }
    }
    null
}

# Choose the dock mode from image shape and the launching frame's height:
# "top" (landscape), "left" (portrait), "below" (square), or "tab" (square
# but the frame is too short to split).
def dock-mode [w: int, h: int, orig: int] {
    let r = ($w / $h)
    if $r > $SQUARE_HI {
        "top"
    } else if $r < $SQUARE_LO {
        "left"
    } else {
        let fh = (window-height $orig)
        if ($fh != null and $fh < $SQUARE_MIN_H) { "tab" } else { "below" }
    }
}

# Run one WM (i3/sway) command, swallowing failure — placement is
# best-effort and must never break `show`.
def i3run [cmd: string] {
    let bin = (wm-bin)
    if $bin == null { return }
    do { ^env -u I3SOCK $bin $cmd } | complete | ignore
}

# ── mark-based docking (sp022 Task 7, dotfiles-zw0d.7) ──────────────────
#
# [[poc016]] proved a qml6 window survives every i3 reparent operation
# (split/move/move-to-mark, floating toggle, cross-workspace move) that made
# a mapped wry/WebKitGTK window self-close (dotfiles-bfk) — so unlike the
# webview host this replaces, the PREVIEW window itself can be split/moved
# AFTER it has already mapped, live or fresh, with no pre-map choreography.
# That collapses prepare-split + wait-preview-mapped + finalize-dock's
# move-the-terminal inversion into one recipe run on the preview window:
# mark the launching frame, move the preview window's container to that
# mark, then reorder if the mode wants the preview BEFORE the frame.
#
# Spot-checked empirically against real i3 4.25.1 AND real sway 1.12
# (dotfiles-zw0d.7 task notes carry the transcripts) on a throwaway
# Xvfb/headless-sway session before this landed — i3 has no native `pid`
# criterion (`[pid=N] focus` is a parse error: i3-msg's own error lists the
# valid criteria and `pid` is not among them), confirming T6's claim rather
# than assuming it; sway's `[pid=N]` IS native and needs no xdotool at all.
# Both WMs accept identical `mark` / `move container to mark <mark>` /
# `move up` / `move left` syntax. workspace_layout tabbed (a common i3
# default, including this repo's own config) means a bare `move container to
# mark` without first setting the frame's split direction lands the preview
# as a TAB, not a split — dock-frame always sets the layout explicitly
# rather than relying on whatever default the target WM/config carries.
const DOCK_MARK = "preview-dock-anchor"

# Resolve pid to the WM criterion used to target the PREVIEW window,
# bounded-polling for the window to actually be mapped. i3: no native pid
# criterion (measured above), so pid -> X11 id via `xdotool search --pid`
# first, then `[id=<xid>]`; missing xdotool degrades immediately (no point
# polling for a binary that will never appear). sway: `[pid=<pid>]` directly
# — mapped-ness is bounded-retried by dock-window's own success-flag loop
# instead, so no separate wait is needed here. null when the window never
# resolves within PLACE_ATTEMPTS (crashed qml6, or xdotool absent) — the
# caller logs why and skips the dock rather than hanging or erroring.
def window-criteria [bin: string, pid: int] {
    if $bin == "swaymsg" {
        return $"[pid=($pid)]"
    }
    if (which xdotool | is-empty) { return null }
    for _ in 1..($PLACE_ATTEMPTS) {
        let xid = (window-xid-for-pid $pid)
        if $xid != null { return $"[id=($xid)]" }
        sleep $PLACE_POLL
    }
    null
}

# Set the launching frame's split direction (or tabbed layout) and mark it —
# done explicitly for every mode rather than relying on the WM's/config's
# default layout (workspace_layout tabbed is common, including this repo's
# own i3 config), so the dock is deterministic regardless of what the
# frame's container defaulted to. `mark` targets the FOCUSED container after
# `split`/`layout` — verified this stays on the frame's own leaf (splitting
# wraps the leaf in a new parent, focus and the leaf itself are unaffected)
# rather than the newly created wrapper.
def dock-frame [orig: int, mode: string] {
    i3run $"[id=($orig)] focus"
    match $mode {
        "top" | "below" => { i3run "split vertical" }
        "left" | "right" => { i3run "split horizontal" }
        "tab" => { i3run "layout tabbed" }
        _ => {}
    }
    i3run $"[id=($orig)] mark ($DOCK_MARK)"
}

# Move the PREVIEW window (already pid-resolved to `criteria`) to sit beside
# the just-marked launching frame, then reorder for the modes that want the
# preview BEFORE the frame in the split (top/left) — default insertion order
# places the moved-in window AFTER the marked one, which is already correct
# for below/right/tab and needs one extra `move` for top/left. Retried on the
# body success flag — i3-msg/swaymsg exit 0 while reporting {"success":
# false} for "nothing to move" (the dotfiles-816 lesson), so a window that
# hasn't actually landed at the mark yet just costs a bounded wait rather
# than a silent no-op. Returns whether the dock landed.
def dock-window [bin: string, criteria: string, mode: string] {
    mut docked = false
    for _ in 1..($PLACE_ATTEMPTS) {
        let r = (do {
            ^env -u I3SOCK $bin $"($criteria) move container to mark ($DOCK_MARK)"
        } | complete)
        if $r.exit_code == 0 {
            let ok = (try { $r.stdout | from json | get 0.success } catch { false })
            if $ok { $docked = true; break }
        }
        sleep $PLACE_POLL
    }
    if $docked {
        match $mode {
            "top" => { do { ^env -u I3SOCK $bin $"($criteria) move up" } | complete | ignore }
            "left" => { do { ^env -u I3SOCK $bin $"($criteria) move left" } | complete | ignore }
            _ => {}
        }
    }
    $docked
}

# Dock window N beside `orig` in `mode` ("top"/"left"/"below"/"right"/"tab"),
# whether N was just spawned OR is already live — the SAME recipe re-docks a
# live window, because (unlike the wry host this replaces) a qml6 window
# survives being moved after it has already mapped ([[poc016]]). Best-effort
# throughout: no-ops cleanly when there is no WM, no pidfile, or the window
# never resolves to a criterion within PLACE_ATTEMPTS — each case prints why,
# so a crashed qml6 or a closed launching frame surfaces in the log instead
# of hanging or erroring `show`/`window`. Always unmarks the frame afterward
# so a leftover mark never lingers to confuse the next dock.
def dock-window-into-place [n: int, orig: int, mode: string] {
    let bin = (wm-bin)
    if $bin == null { return }
    let pid = (read-pidfile-at (window-pid-file $n))
    if $pid == null {
        print $"preview: window ($n) has no pidfile — skipping dock"
        return
    }
    let criteria = (window-criteria $bin $pid)
    if $criteria == null {
        print $"preview: window ($n) \(pid ($pid)\) never mapped within (($PLACE_ATTEMPTS * $PLACE_POLL)) — skipping dock, see (window-log-file $n)"
        return
    }
    dock-frame $orig $mode
    let ok = (dock-window $bin $criteria $mode)
    i3run $"unmark ($DOCK_MARK)"
    if $ok {
        print $"preview: docked window ($n) ($mode) of frame ($orig)"
    } else {
        print $"preview: window ($n) \(pid ($pid)\) placement timed out — leaving it where the WM put it"
    }
}

# One-shot preview: ensure a /-rooted daemon, open window N, send the file,
# and print its localhost URL (the browser-on-a-port fallback). This is the
# verb Claude Code's /preview slash command and any ad-hoc caller uses to
# throw an arbitrary image/file into the preview window in one command
# (dotfiles-ad7). A missing/nonexistent path is a loud error, mirroring
# `send`'s guard.
def main-show [path?: string, window: int = 1] {
    if ($path | is-empty) {
        error make { msg: "preview: show requires a path" }
    }
    let abs = ($path | path expand)
    if not ($abs | path exists) {
        error make { msg: $"preview: no such file: ($abs)" }
    }
    # Capture the launching frame + image shape BEFORE anything opens a
    # window, so shape docking has the original frame to dock against
    # (dotfiles-bfk).
    let orig = (active-window-id)
    let dims = (image-dims $abs)
    ensure-daemon-slash
    # Dock whenever there is a frame + WM + known image shape to dock
    # against — no "is this window already open" guard: sp022 Task 7
    # collapsed that check, because dock-window-into-place re-docks a LIVE
    # window exactly as safely as a fresh one ([[poc016]]). No frame/dims
    # (non-image, headless) -> no dock, same as before.
    let mode = if ($orig != null and $dims != null) {
        (dock-mode $dims.w $dims.h $orig)
    } else {
        null
    }
    # Window spawn is best-effort GUI: on a headless host (Termux, no WM,
    # no qml6) the detached window just dies in its log — the daemon + URL
    # below still give a working browser-on-a-port preview, so this never
    # gates the send.
    window-spawn $window
    # The daemon (root=/) converts this absolute path abs->rel internally
    # (handlePreviewSet), so /file/<abs-minus-leading-slash> is the URL.
    main-send $abs $window
    # Dock (or re-dock) AFTER the window exists — spawned just now, or
    # already live from a previous `show`/`window` call.
    if $mode != null {
        dock-window-into-place $window $orig $mode
    }
    let rel = ($abs | str trim --left --char '/')
    print $"preview: (api-base)/file/($rel)?full"
}

# Register this nvim's server address against a slot (ft005 api_surface
# `register` verb — sp009 Task 3): POST {nvim, slot?} to /register and
# print the daemon's assigned slot on stdout — the machine-parseable
# contract nvim/plugins/preview.lua relies on to learn its own slot number
# after `:PreviewStart`. Passing --slot rebinds that slot to a (possibly
# refreshed) address instead of allocating a new one, which is how the
# plugin makes a second `:PreviewStart` in the same nvim instance
# idempotent rather than leaking a fresh slot per call (sp009 Task 3 edge
# case). A missing address is a loud error, not a silent no-op, mirroring
# `send`'s missing-path guard.
# Ask the running WM which workspace is focused, or "" when there is no WM
# to ask (Termux), no WM running, or the query fails (dotfiles-816).
#
# I3SOCK is unset for the call ON PURPOSE. An inherited I3SOCK points at
# whichever session the calling shell was born in, so a shell in session A
# would answer with session A's workspace and place the window on the wrong
# screen. Unset, i3-msg re-derives the socket from $DISPLAY — the session
# the caller is actually in. SWAYSOCK is left alone: swaymsg needs it, and
# it does not carry the same cross-session hazard.
#
# "" is the honest answer for "no workspace known" and callers must treat it
# as "leave placement to the WM", never as a workspace name.
def current-workspace [] {
    for bin in [swaymsg i3-msg] {
        if (which $bin | is-empty) { continue }
        let out = (do { ^env -u I3SOCK $bin -t get_workspaces } | complete)
        if $out.exit_code != 0 { continue }
        let ws = (try {
            $out.stdout | from json | where focused | get 0.name
        } catch { "" })
        if ($ws | is-not-empty) { return $ws }
    }
    ""
}

def main-register [nvim?: string, slot?: int] {
    if ($nvim | is-empty) {
        error make { msg: "preview: register requires an nvim server address" }
    }
    let url = $"(api-base)/register"
    # The workspace is captured HERE, at register time, because this is the
    # one moment we know the answer: :PreviewStart runs from inside nvim, so
    # the focused workspace IS nvim's. A later `preview window N` runs in a
    # different process (possibly a different workspace entirely) and cannot
    # work it out — nvim sits under tmux, which severs the pid chain from the
    # terminal window the WM knows about.
    let ws = (current-workspace)
    let body = if ($slot == null) { {nvim: $nvim} } else { {nvim: $nvim, slot: $slot} }
    let body = if ($ws | is-empty) { $body } else { $body | insert workspace $ws }
    let resp = (try {
        http post --max-time 2sec --content-type application/json $url $body
    } catch { |err|
        error make { msg: $"preview: register failed — ($err.msg)" }
    })
    print $resp.slot
}

# Parse `arg` (the `window` subcommand's optional positional) into a window
# number, defaulting to 1 when omitted. A non-numeric arg is a loud usage
# error rather than a silent fallback.
def parse-window-arg [arg?: string] {
    if ($arg | is-empty) {
        return 1
    }
    try {
        $arg | into int
    } catch {
        error make { msg: $"preview: invalid window number '($arg)'" }
    }
}

# preview — control the preview-d daemon
def main [
    subcommand?: string        # start | stop | status | show | send | register | window
    arg?: string                # path for `show`/`send`; nvim server address for `register`; N for `window`
    --window (-w): int = 1     # target preview<N> slot for `show`/`send` (default 1)
    --slot (-s): int             # explicit slot for `register` (rebind instead of allocate)
    --close                      # with `window`: close instead of spawn
] {
    match $subcommand {
        "start"    => { main-start }
        "stop"     => { main-stop }
        "status"   => { main-status }
        "show"     => { main-show $arg $window }
        "send"     => { main-send $arg $window }
        "register" => { main-register $arg $slot }
        "window"   => { main-window (parse-window-arg $arg) $close }
        _ => {
            print "Usage: preview <subcommand>"
            print ""
            print "Subcommands:"
            print "  start                        — launch daemon (idempotent)"
            print "  stop                         — stop daemon (closes all windows first)"
            print "  status                       — daemon health (pid / root / port / started_at)"
