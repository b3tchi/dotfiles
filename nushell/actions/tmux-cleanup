#!/usr/bin/env nu
# Kill unattached tmux sessions and cleanup unpinned panes
# Replaces kill_local_unattached() from bashrc
#
# @wm-restore-pending (sp038, dotfiles-et3u.12): wm-state restore sets this
# session option to a unix time on every session it hands over to a new
# terminal, before it closes the old one. st starts its shell (and so its tmux
# client) only once its window is first mapped, and a terminal restored onto a
# hidden workspace is not mapped until it is shown - so for a while such a
# session has no client at all. A LIVE mark stands in for that client: the
# session counts as attached and its current window as viewed. tmux.conf's
# client-attached hook clears the mark when the client arrives. A mark older
# than PENDING_TTL (24h: the new terminal was closed before it was ever shown)
# or one that is not a unix time is stale: it protects nothing and is unset.
const PENDING_MARK = "@wm-restore-pending"
const PENDING_TTL = 86400

# Is a mark value a live pending mark at unix time `now`?
def mark_live [value: string, now: int] {
    let ts = (try { $value | into int } catch { null })
    if $ts == null { return false }
    let age = ($now - $ts)
    $age >= 0 and $age < $PENDING_TTL
}

# Get all tmux sessions with their metadata. A session name never holds ':'
# (tmux replaces it), so ':' separates; the mark is last and takes the rest.
def get_sessions [] {
    let now = (date now | format date '%s' | into int)
    tmux list-sessions -F $"#{session_id}:#{session_attached}:#{window_id}:#{session_group}:#{session_name}:#{($PENDING_MARK)}"
    | lines
    | where $it != ""
    | each { |l|
        let p = ($l | split row ":")
        let mark = ($p | skip 5 | str join ":")
        {
            id: $p.0, attached: ($p.1 | into int), window: $p.2, group: $p.3, name: $p.4,
            mark: $mark, pending: (mark_live $mark $now)
        }
    }
}

# Get all windows with their metadata. `-a` lists a window once per session
# that holds it (every session of a group), so dedupe: a second kill-window of
# the same id fails and would abort the whole run.
def get_windows [] {
    tmux list-windows -a -F "#{window_id} #{window_active_clients}"
    | lines
    | where $it != ""
    | uniq
    | parse "{id} {clients}"
    | update clients { |row| $row.clients | into int }
}

# Get all panes for a specific window
def get_panes [window_id: string] {
    tmux list-panes -t $window_id -F "#{pane_id} #{@pinned}"
    | lines
    | where $it != ""
    | parse "{id} {pinned}"
    | update pinned { |row| if $row.pinned == "" { "0" } else { $row.pinned } }
}

# Check if any window has pinned panes
def has_pinned_panes [session_name: string] {
    let windows = (tmux list-windows -t $session_name -F "#{window_id}"
        | lines
        | where $it != "")

    for window in $windows {
        let pinned_count = (get_panes $window
            | where pinned == "1"
            | length)

        if $pinned_count > 0 {
            return true
        }
    }

    return false
}

# Log to tmux log file
def log [message: string] {
    let log_file = $"($env.HOME)/.tmux.log"
    $"(date now | format date '%Y-%m-%d %H:%M:%S') - ($message)\n"
    | save --append $log_file
}

# Main cleanup logic
def main [] {
    # Add small delay to avoid race condition during session switching
    # When switching sessions with C-b s, there's a brief moment where both
    # the old and new session might appear unattached
    sleep 200ms

    let all_sessions = (get_sessions)

    # Stale marks protect nothing: unset them (by session id, never a name).
    for sess in ($all_sessions | where { |s| $s.mark != "" and not $s.pending }) {
        log $"Clearing stale ($PENDING_MARK) on ($sess.name): '($sess.mark)'"
        tmux set-option -u -t $"($sess.id):" $PENDING_MARK
    }

    # A live mark counts as an attached client (see the header).
    let sessions = ($all_sessions | update attached { |s| if $s.pending { [$s.attached 1] | math max } else { $s.attached } })
    let pending_windows = ($all_sessions | where pending | get window)

    # Process session groups
    let groups = ($sessions | where group != "" | get group | uniq)

    for group in $groups {
        let group_sessions = ($sessions | where group == $group)
        let all_unattached = ($group_sessions | where attached > 0 | length) == 0

        if $all_unattached {
            # All sessions unattached - check for pinned panes
            let first_session = ($group_sessions | first | get name)

            if (has_pinned_panes $first_session) {
                # Has pinned panes - don't kill any sessions, just log
                log $"Skipping cleanup for group ($group) - has pinned panes and all sessions unattached"
            } else {
                # No pinned panes and all unattached - safe to kill all but one
                let sorted = ($group_sessions | get name | sort --natural)
                let keep = ($sorted | last)

                for sess in ($sorted | where $it != $keep) {
                    log $"Killing extra unattached session in group ($group) - no pinned panes, keeping ($keep): ($sess)"
                    tmux kill-session -t $sess
                }
            }
        } else {
            # Some sessions attached - kill unattached ones unless pinned
            for sess in ($group_sessions | where attached == 0) {
                if (has_pinned_panes $sess.name) {
                    log $"Skipping unattached session ($sess.name) in group ($group) - has pinned panes"
                } else {
                    log $"Killing unattached session in group ($group) - group has attached session: ($sess.name)"
                    tmux kill-session -t $sess.name
                }
            }
        }
    }

    # Process unattached windows (a pending session's current window counts
    # as viewed: it is what the new client will show)
    let windows = (get_windows | where {|w| $w.clients == 0 and not ($w.id in $pending_windows) })

    for window in $windows {
        let panes = (get_panes $window.id)
        let pinned_count = ($panes | where pinned == "1" | length)

        if $pinned_count == 0 {
            # No pinned panes - kill entire window
            log $"Killing unattached window - no pinned panes: ($window.id)"
            tmux kill-window -t $window.id
        } else {
            # Has pinned panes - kill only unpinned panes
            for pane in ($panes | where pinned != "1") {
                log $"Killing unpinned pane in window with pinned panes: ($pane.id) - window: ($window.id)"
                tmux kill-pane -t $pane.id
            }
        }
    }
}
