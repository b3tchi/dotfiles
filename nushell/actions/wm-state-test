#!/usr/bin/env nu
# wm-state-test - scripted test for `wm-state restore` on kwi3 (sp007 Task 6,
# kwi3-a1j.6), in the wm-ipc-test pattern.
#
# On kwi3 `restore` builds the whole workspace with ONE `workspace.build`
# (ft011: placeholders addressed by con id, no marks, no append_layout) instead
# of the i3 verbs kwi3 no longer speaks. This drives the real script against the
# REAL kwi3 core: kwi3's own node rig i3kwin/test/rpc-server.js on a throwaway
# socket under /tmp, seeded with live windows by a small driver written into the
# sandbox (the rig's own CLI has no way to give a window a class).
#
# Cases (the names are the sp007 T6 test_plan's):
#   dry-run-kwi3            exact workspace.build params + exec lines, rig untouched
#   restore-shape           built workspace == saved layout (layouts, order, shares),
#                           one placeholder per terminal awaiting wm-slot-<ws>-<key>
#   restore-gui-window-leaf GUI leaves hold the live windows' con ids (saved id,
#                           else first by class)
#   restore-gui-placeholder a GUI leaf with no live window is a class placeholder
#   restore-renames-old     old workspace renamed <name>-old, old terminals closed
#   restore-old-stamped     a second restore stamps the leftover <name>-old
#   no-i3-verbs             no append_layout/mark/get_marks/con_mark, no i3-msg call
#   i3-dry-run-unchanged    the i3 dry-run equals the golden (changed on exec lines only, sp038 T6)
#                           file captured from main before this task
#   i3-dry-run-read-only    an i3 dry run sends only -t get_* queries
#   i3-exec-real-parser     exec lines for names with , ; " \ ' $( ) unicode, sent to a REAL
#   sway-exec-real-parser   sandbox i3 (Xvfb >= 100) / headless sway: one intact launcher word
#                           each, nothing executed; sway refuses a `"` by name
#   i3-launcher-refused     launcher pre-flight (--dry-run) refuses -> exit 1, NO i3 command
#   i3-slow-launcher        terminals map after 1.5s -> old ones killed only after they map
#   i3-slot-never-maps      a slot never maps -> that ws keeps <ws>-old, warning names it
#   i3-old-slot-not-counted only windows new since restore began satisfy the attach poll
#   i3-bare-terminal-swallow a bare terminal's placeholder swallows its slot class
#   placeholder-only-ws     only unmatched GUI leaves -> built as placeholders only
#   name-unicode            spaces / unicode / shell + regex metacharacters
#   tmux-down-aborts        no tmux -> exit 1 before any kwi3 call
#   launcher-refused        the launcher's exit 78 reported per terminal, the other
#                           terminals still launched, the old terminals NOT closed
#   launcher-missing-aborts-early  no ~/.local/bin/wm-launch-terminal -> exit 1
#                           naming the path, before any kwi3 call
#   no-exec-rpc             restore sends no `exec` RPC (sp038 T4: terminals go
#                           through wm-launch-terminal, a stub in the sandbox)
#
# Safety: every nu run is `env -i`; HOME is a sandbox; PATH starts with stubs for
# tmux (answers from a flag file, can never reach a real server), i3-msg, swaymsg
# and i3 (the kwi3 runs' i3-msg fails LOUDLY and logs); the rig is killed by its
# exact pid. Nothing touches :10, a live i3, a live tmux or xrdp.
#
# Run:  KWI3_REPO=/path/to/kwi3 nu nushell/actions/wm-state-test
# Pass: exits 0 and prints "PASS: N checks passed"

const HERE = (path self | path dirname)

let kwi3_repo = ($env | get -o KWI3_REPO | default ($env.HOME | path join ".local/src/kwi3"))
let rig_js = ($kwi3_repo | path join "i3kwin/test/rpc-server.js")
let kwi3_msg = ($kwi3_repo | path join "i3kwin/bin/kwi3-msg")
for f in [$rig_js $kwi3_msg] {
    if not ($f | path exists) {
        print -e $"FATAL: ($f) not found - set KWI3_REPO to a kwi3 checkout"
        exit 2
    }
}
let node = (which node | get -o 0.path | default "")
if ($node | is-empty) { print -e "FATAL: node not on PATH"; exit 2 }
let nu_bin = (which nu | get 0.path)
let golden = ($HERE | path join "wm-state-test.i3-dry-run.golden")

# /tmp, not a scratchpad: AF_UNIX sun_path is 108 bytes.
let tmp = (^mktemp -d /tmp/wmstate-test.XXXXXX | str trim)
let home = $"($tmp)/home"
let bin = $"($tmp)/bin"
let bin_i3 = $"($tmp)/bin-i3"
^mkdir -p $"($home)/.local/bin" $"($home)/.cache" $bin $bin_i3
for s in [wm-ipc.nu wm-state] {
    ^ln -s ($HERE | path join $s) $"($home)/.local/bin/($s)"
}
^ln -s $kwi3_msg $"($bin)/kwi3-msg"

# Stub tmux: logs argv, "down" while $tmp/tmux-down exists. First on PATH, so a
# real tmux server is unreachable from every run below.
let tmux_log = $"($tmp)/tmux.log"
$"#!/bin/bash
echo \"$*\" >> ($tmux_log)
if [ -e ($tmp)/tmux-down ]; then echo 'no server running' >&2; exit 1; fi
case \"$1\" in list-sessions) echo 'a: 1 windows' ;; esac
exit 0
" | save -f $"($bin)/tmux"
# kwi3 runs: i3-msg / swaymsg / i3 fail loudly and log. Any call is a failure.
let i3_log = $"($tmp)/i3-msg.log"
for n in [i3-msg swaymsg i3] {
    $"#!/bin/bash\nprintf '%q ' \"$@\" >> ($i3_log); echo >> ($i3_log)\necho 'STUB ($n): must never be called on kwi3' >&2\nexit 97\n" | save -f $"($bin)/($n)"
}
# i3 run: a stub i3 answering what restore --dry-run reads (fixture tree below).
let i3_tree = $"($tmp)/i3-tree.json"
let i3_run_log = $"($tmp)/i3-run.log"
$"#!/bin/bash
printf '%q ' \"$@\" >> ($i3_run_log); echo >> ($i3_run_log)
case \"$*\" in
  *get_version*) echo '{\"major\":4}' ;;
  *get_workspaces*) echo '[{\"num\":1,\"name\":\"dev\",\"focused\":true}]' ;;
  *get_tree*) cat ($i3_tree) ;;
  *get_marks*) echo '[\"wm-gui-stale\"]' ;;
  *) echo '[{\"success\":true}]' ;;
esac
" | save -f $"($bin_i3)/i3-msg"
"#!/bin/bash\nexit 1\n" | save -f $"($bin_i3)/swaymsg"
"#!/bin/bash\nexit 1\n" | save -f $"($bin_i3)/i3"
# Stub wm-launch-terminal (sp038 T4): restore on kwi3 launches terminals through
# ~/.local/bin/wm-launch-terminal. The stub logs ONE line per call, args joined
# with US (0x1f) so a word with spaces stays one word; exits 78 when a word of
# the call contains a line of $tmp/launcher-refuse (the real launcher's refusal
# code); and queues the --class value for the rig driver to map as a window.
let launcher_log = $"($tmp)/launcher.log"
let launcher_path = $"($home)/.local/bin/wm-launch-terminal"
let launcher_body = $"#!/bin/bash
for a in \"$@\"; do printf '%s\\037' \"$a\" >> ($launcher_log); done; echo >> ($launcher_log)
if [ -s ($tmp)/launcher-refuse ]; then
  for a in \"$@\"; do
    while IFS= read -r pat; do
      case \"$a\" in *\"$pat\"*) echo 'STUB launcher: refused' >&2; exit 78 ;; esac
    done < ($tmp)/launcher-refuse
  done
fi
prev=''
for a in \"$@\"; do [ \"$prev\" = --class ] && echo \"$a\" >> ($tmp)/map.queue; prev=\"$a\"; done
# i3 live runs: the stub i3 runs `exec` payloads with STUB_WS = the workspace
# focused at that moment; a real, non --dry-run, launch then \"maps\" its class
# there after $tmp/i3live/delay seconds, unless the class is in i3live/nomap.
if [ -n \"${STUB_WS:-}\" ]; then
  dry=0; cls=''; prev=''
  for a in \"$@\"; do [ \"$a\" = --dry-run ] && dry=1; [ \"$prev\" = --class ] && cls=\"$a\"; prev=\"$a\"; done
  if [ $dry = 0 ] && ! grep -qxF -- \"$cls\" ($tmp)/i3live/nomap 2>/dev/null; then
    d=$\(cat ($tmp)/i3live/delay 2>/dev/null || echo 0)
    printf '%s\\t%s\\t%s\\t%s\\n' \"$cls\" \"$STUB_WS\" \"$\(date +%s.%N)\" \"$d\" >> ($tmp)/i3live/maps
  fi
fi
exit 0
"
$launcher_body | save -f $launcher_path
^chmod +x $launcher_path
^cp $"($bin)/tmux" $"($bin_i3)/tmux"
^chmod +x ...(glob $"($bin)/*") ...(glob $"($bin_i3)/*")
^ln -s $kwi3_msg $"($bin_i3)/kwi3-msg"
let path_base = [($node | path dirname) "/usr/local/bin" "/usr/bin" "/bin"] | str join ":"
let test_path = $"($bin):($path_base)"
let test_path_i3 = $"($bin_i3):($path_base)"

# ── the rig driver ────────────────────────────────────────────────────────────
# Seeds live windows (class/instance/caption on a named workspace), logs every
# exec the core asked the host to spawn, and can refuse (flag file) or map a
# window for the spawn (flag file) like a real terminal would.
let driver = $"($tmp)/driver.js"
r#'
'use strict';
const fs = require('fs');
const R = process.env.KWI3_REPO;
const rpc = require(R + '/i3kwin/test/rpc-server.js');
const h = require(R + '/i3kwin/test/harness.js');
const root = R + '/i3kwin';
const sources = fs.readdirSync(root + '/core').filter((f) => f.endsWith('.js'))
    .map((f) => root + '/core/' + f)
    .concat([root + '/adapters/kwin/contents/code/adapter.js']);
const [sockPath, seedPath, tmp] = process.argv.slice(2);
const seed = JSON.parse(fs.readFileSync(seedPath, 'utf8'));
rpc.start(sockPath, sources, { logCalls: true }).then((rig) => {
    const ctx = rig.ctx, ws = rig.world.ws;
    const open = (cls, caption) => {
        const w = h.fake.observe(h.fake.FakeWindow({
            resourceClass: cls, resourceName: cls, caption: caption,
            output: ws.activeScreen, desktops: [ws.currentDesktop]
        }), 'window');
        ws.windows.push(w);
        ctx.manage(w);
    };
    for (const s of seed.windows) {
        h.rpcCall(ctx, 'workspace.focus', { name: s.ws });
        open(s.class, s.caption);
    }
    h.rpcCall(ctx, 'workspace.focus', { name: seed.start });
    ctx.host.spawn = (cmd) => {
        fs.appendFileSync(tmp + '/spawn.log', cmd + '\n');
        return true;   // restore must never reach here any more (sp038 T4)
    };
    // The stub launcher queues each --class it was given; with `mapspawn` set a
    // terminal "appears" with that class, like a real one would.
    let mapped = 0;
    setInterval(() => {
        let q;
        try { q = fs.readFileSync(tmp + '/map.queue', 'utf8').split('\n').filter(Boolean); } catch (e) { return; }
        for (; mapped < q.length; mapped++) {
            if (fs.existsSync(tmp + '/mapspawn')) { open(q[mapped], 'tmux'); }
        }
    }, 40);
    console.log('READY');
    process.on('SIGTERM', () => process.exit(0));
});
'#
| save -f $driver

# ── helpers ───────────────────────────────────────────────────────────────────

def rig [test_path: string, sock: string, method: string, params?: string] {
    if $params == null {
        ^env -i $"PATH=($test_path)" $"KWI3SOCK=($sock)" kwi3-msg $method
    } else {
        ^env -i $"PATH=($test_path)" $"KWI3SOCK=($sock)" kwi3-msg $method $params
    }
}

def rig-json [test_path: string, sock: string, method: string] {
    rig $test_path $sock $method | from json
}

# Every leaf window of a tree.get document, wherever it floats or tiles.
def leaves [node: record] {
    let kids = (($node | get -o nodes | default []) | append ($node | get -o floating_nodes | default []))
    if ($kids | is-empty) {
        if ($node | get -o window) != null { [$node] } else { [] }
    } else {
        $kids | each {|k| leaves $k } | flatten
    }
}

def workspace-nodes [node: record] {
    let own = if ($node | get -o type | default "") == "workspace" and ($node | get name) != "__i3_scratch" { [$node] } else { [] }
    $own | append (($node | get -o nodes | default []) | each {|k| workspace-nodes $k } | flatten)
}

def ws-node [tree: record, name: string] {
    let m = (workspace-nodes $tree | where name == $name)
    if ($m | is-empty) { null } else { $m | first }
}

# A workspace's shape, comparable by hand: containers {layout, kids}, a window
# `w:<con id>`, a placeholder `ph:<class regex>`.
def shape [node: record] {
    let kids = ($node | get -o nodes | default [])
    if ($kids | is-not-empty) {
        { layout: $node.layout, kids: ($kids | each {|k| shape $k }) }
    } else if ($node | get -o window) != null {
        $"w:($node.id)"
    } else {
        let sw = ($node | get -o swallows | default [])
        $"ph:($sw | each {|s| $s | get -o class | default '?' } | str join ',')"
    }
}

def con-by-title [tree: record, title: string] {
    let m = (leaves $tree | where {|l| ($l | get -o window_properties.title) == $title })
    if ($m | is-empty) { null } else { $m | first }
}

# Run one nu script (wm-state ...) in the sandbox.
def run-ws [tmp: string, test_path: string, extra: list<string>, args: list<string>] {
    do { ^env -i $"HOME=($tmp)/home" $"PATH=($test_path)" ...$extra ($env.WM_STATE_TEST_NU) -n $"($tmp)/home/.local/bin/wm-state" ...$args } | complete
}

$env.WM_STATE_TEST_NU = $nu_bin

mut passed = 0
mut failed = 0
def check [name: string, cond: bool, detail: string] {
    if $cond { print $"  PASS  ($name)" } else { print $"  FAIL  ($name)\n        ($detail)" }
    $cond
}

# ── i3 fixture + (re)capture of the golden file ───────────────────────────────
# A real i3 get_tree shape: root > output > content > workspace dev holding a
# terminal (st) and a GUI window (Firefox). `pid` is set on every leaf so
# wm-state never shells out to xprop.
{
    id: 1, type: "root", name: "root", nodes: [{
        id: 2, type: "output", name: "eDP-1", nodes: [{
            id: 3, type: "con", name: "content", nodes: [{
                id: 4, type: "workspace", name: "dev", layout: "splith", nodes: [
                    { id: 5, type: "con", name: "tmux", window: 100, pid: 4242, layout: "splith", nodes: [], floating_nodes: [], window_properties: { class: "st", title: "tmux" } },
                    { id: 6, type: "con", name: "ff", window: 101, pid: 4243, layout: "splith", nodes: [], floating_nodes: [], window_properties: { class: "Firefox", title: "ff" } }
                ], floating_nodes: []
            }], floating_nodes: []
        }], floating_nodes: []
    }], floating_nodes: []
} | to json -r | save -f $i3_tree

let i3_state = {
    workspaces: [{
        name: "dev", ws_layout: "splith",
        layout: { "1": "st", "2": "Firefox" },
        state: {
            "1": { wid: 100, pid: 4242, class: "st", title: "tmux", session_type: "local", session: "a", tmux_window_id: "5" },
            "2": { wid: 101, pid: 4243, class: "Firefox", title: "ff", skip_restore: true }
        }
    }]
}

print "\n[i3] dry-run on the i3 path"
$i3_state | to yaml | save -f $"($home)/.cache/sway-state.yaml"
"" | save -f $i3_run_log
"" | save -f $"($tmp)/i3.sock"      # find-i3-sockets only needs the path to exist
let i3r = (run-ws $tmp $test_path_i3 [$"I3SOCK=($tmp)/i3.sock"] ["restore" "--dry-run" "--workspace" "dev"])
if ($env | get -o WM_STATE_CAPTURE_GOLDEN | default "" | is-not-empty) {
    $i3r.stdout | save -f $env.WM_STATE_CAPTURE_GOLDEN
    print $"captured golden -> ($env.WM_STATE_CAPTURE_GOLDEN)"
}
let want_golden = if ($golden | path exists) { open $golden --raw } else { "<missing golden>" }
if (check "i3-dry-run-unchanged: byte-identical to the golden from main" ($i3r.exit_code == 0 and $i3r.stdout == $want_golden and ($i3r.stdout | str contains "append_layout")) $"exit=($i3r.exit_code)\n--- got\n($i3r.stdout)\n--- golden\n($want_golden)\nstderr=($i3r.stderr)") { $passed += 1 } else { $failed += 1 }
# sp038 T6: the golden changed ON PURPOSE (Jan, 2026-10-06) - and only on its
# exec lines. The pre-sp038 golden is kept beside it; every line that differs
# must be an `ipc-raw exec` line on BOTH sides, and the line count is equal.
let old_lines = (open $"($HERE)/wm-state-test.i3-dry-run.pre-sp038.golden" --raw | lines)
let new_lines = ($i3r.stdout | lines)
let changed = if ($old_lines | length) == ($new_lines | length) { $old_lines | zip $new_lines | where {|p| $p.0 != $p.1 } } else { [[bad]; ["length"]] }
let non_exec = ($changed | where {|p| not (($p.0 | str contains "ipc-raw exec ") and ($p.1 | str contains "ipc-raw exec ")) })
if (check "i3-golden-exec-only: same line count, every changed line is an exec line, >=1 changed" (($old_lines | length) == ($new_lines | length) and ($changed | is-not-empty) and ($non_exec | is-empty)) $"changed=($changed | to json -r)") { $passed += 1 } else { $failed += 1 }
let exec_new = ($new_lines | where {|l| $l | str contains "ipc-raw exec " })
if (check "i3-exec-uses-launcher: exec \"~/.local/bin/wm-launch-terminal <term> --session a --class wm-slot-dev-1\" (one i3 double-quoted string)" ($exec_new == ["  DRY: ipc-raw exec \"~/.local/bin/wm-launch-terminal kitty --session a --class wm-slot-dev-1\""]) $"exec=($exec_new | to json -r)") { $passed += 1 } else { $failed += 1 }
let dry_mut = (open $i3_run_log | lines | where {|l| ($l | is-not-empty) and not ($l =~ '(^| )-t get_') })
if (check "i3-dry-run-read-only: the dry run sent i3 only -t get_* queries, no command" ($dry_mut | is-empty) $"sent=($dry_mut | to json -r)") { $passed += 1 } else { $failed += 1 }

# ── nasty names through i3's OWN command parser (sp038 T6) ────────────────────
# i3 ends an unquoted `exec` argument at `,` or `;` (commands_parser.c
# parse_string); only i3 double quotes protect it, and sh's single quotes
# inside them protect it from /bin/sh. So the exec lines a dry run emits for
# names holding , ; " \ ' $( ) and unicode are sent, verbatim, to a REAL i3:
# a throwaway one on its own Xvfb display (>= 100, never :10/:40/:60), its own
# config and IPC socket under $tmp, env -i, HOME = the sandbox (so `~/.local/
# bin/wm-launch-terminal` is the stub). The stub must see each name as ONE
# word, and nothing in a name may run.
let nasty_sess = "s, a; exec touch PWN1 \"q\" \\ 'z' $(touch PWN2) 日本"
let nasty_ws = "w; b, exec touch PWN3 \"d\" \\e 'f' é"
let pwn_real = $"($tmp)/pwn-real"
^mkdir -p $pwn_real
open $i3_tree | update nodes.0.nodes.0.nodes.0.name $nasty_ws | to json -r | save -f $i3_tree
{ workspaces: [{ name: $nasty_ws, ws_layout: "splith",
    layout: { "1": "st", "2": "st" },
    state: {
      "1": { wid: 100, pid: 4242, class: "st", title: "t", session_type: "local", session: $nasty_sess, tmux_window_id: "5" },
      "2": { wid: 101, pid: 4243, class: "st", title: "t2" } } }] } | to yaml | save -f $"($home)/.cache/sway-state.yaml"
let nr = (run-ws $tmp $test_path_i3 [$"I3SOCK=($tmp)/i3.sock"] ["restore" "--dry-run" "--workspace" $nasty_ws])
let nexecs = ($nr.stdout | lines | where {|l| $l | str starts-with "  DRY: ipc-raw exec " } | each {|l| $l | str replace "  DRY: ipc-raw " "" })
let want_a = ["kitty" "--session" $nasty_sess "--class" $"wm-slot-($nasty_ws)-1"]
let want_b = ["kitty" "--workspace" $nasty_ws "--class" $"wm-slot-($nasty_ws)-2"]
let real_i3 = (which i3 | get -o 0.path | default "")
let real_i3msg = (which i3-msg | where {|c| $c.path != $"($bin_i3)/i3-msg" } | get -o 0.path | default "")
let xvfb = (which Xvfb | get -o 0.path | default "")
let x11ns = ($kwi3_repo | path join "i3kwin/test/x11-unix-ns.sh")
mut skips = []
if ($real_i3 | is-empty) or ($real_i3msg | is-empty) or ($xvfb | is-empty) or not ($x11ns | path exists) {
    $skips = ($skips | append "i3-exec-real-parser: needs i3, i3-msg, Xvfb and $KWI3_REPO/i3kwin/test/x11-unix-ns.sh - UNVERIFIED")
} else {
    let bound = (^ss -xl | lines | each {|l| $l | parse -r '@/tmp/\.X11-unix/X(?<n>[0-9]+)' | get -o 0.n } | compact)
    let dnum = (100..199 | where {|n| not ($"($n)" in $bound) and not ($"/tmp/.X($n)-lock" | path exists) and not ($"/tmp/.X11-unix/X($n)" | path exists) } | first)
    let xpid = (^bash -c $"'($x11ns)' '($xvfb)' :($dnum) -screen 0 640x480x24 -nolisten tcp > '($tmp)/xvfb.log' 2>&1 & echo $!" | str trim | into int)
    mut up = false
    for _ in 1..50 { if (^ss -xl | str contains $"@/tmp/.X11-unix/X($dnum) ") { $up = true; break }; sleep 100ms }
    let rsock = $"($tmp)/real-i3.sock"
    $"ipc-socket ($rsock)\nfont pango:monospace 8\n" | save -f $"($tmp)/real-i3.cfg"
    let ipid = if $up { ^bash -c $"cd '($pwn_real)' || exit 1; env -i 'HOME=($home)' PATH=/usr/bin:/bin DISPLAY=:($dnum) '($real_i3)' -c '($tmp)/real-i3.cfg' > '($tmp)/real-i3.log' 2>&1 & echo $!" | str trim | into int } else { 0 }
    mut i3up = false
    if $ipid > 0 { for _ in 1..50 { if (do { ^$real_i3msg -s $rsock -t get_version } | complete | get exit_code) == 0 { $i3up = true; break }; sleep 100ms } }
    if (check "i3-exec-real-parser: a sandbox i3 came up on its own display and socket" $i3up $"display=:($dnum) xvfb=(open $"($tmp)/xvfb.log") i3=(if ($"($tmp)/real-i3.log" | path exists) { open $"($tmp)/real-i3.log" } else { "" })") { $passed += 1 } else { $failed += 1 }
    if $i3up {
        "" | save -f $launcher_log
        let replies = ($nexecs | each {|c| do { ^$real_i3msg -s $rsock $c } | complete })
        mut calls = []
        for _ in 1..50 {
            $calls = (open $launcher_log --raw | lines | where {|l| $l | is-not-empty } | each {|l| $l | split row (char -u '1f') | where {|w| $w != "" } })
            if ($calls | length) >= 2 { break }
            sleep 100ms
        }
        sleep 300ms   # anything a split command would have run gets its chance
        if (check "i3-exec-real-parser: real i3 hands each name to the launcher as ONE intact word" ($nr.exit_code == 0 and ($nexecs | length) == 2 and ($replies | all {|r| $r.exit_code == 0 and ($r.stdout | str contains '"success":true') and not ($r.stdout | str contains '"success":false') }) and ($calls | length) == 2 and $want_a in $calls and $want_b in $calls) $"execs=($nexecs | to json -r) replies=($replies | to json -r) argv=($calls | to json -r) stderr=($nr.stderr)") { $passed += 1 } else { $failed += 1 }
        let pwned = (^ls -A $pwn_real | lines)
