        layout: { "1": "st-256color", splitv: { "2": "st-256color", "3": "Zathura" }, tabbed: { "4": "st", "5": "Firefox", "6": "Gone" } },
        state: {
            "1": { wid: $T1, pid: 11, class: "st-256color", title: "tmux", session_type: "local", session: "a", tmux_window_id: "5" },
            "2": { wid: $T2, pid: 12, class: "st-256color", title: "tmux", session_type: "local", session: "b", tmux_window_id: "6" },
            "3": { wid: $Z, pid: 13, class: "Zathura", title: "zathura", skip_restore: true },
            "4": { wid: $T3, pid: 14, class: "st", title: "bash" },
            "5": { wid: 999999, pid: 15, class: "Firefox", title: "ff", skip_restore: true },
            "6": { wid: 888888, pid: 16, class: "Gone", title: "gone", skip_restore: true }
        }
      }
      {
        name: "gui", ws_layout: "splith",
        layout: { "1": "Nowhere" },
        state: { "1": { wid: 777777, pid: 17, class: "Nowhere", title: "n", skip_restore: true } }
      }
      {
        name: "ef", ws_layout: "splitv",
        layout: { "1": "st-256color", "2": "st-256color" },
        state: {
            "1": { wid: 1, pid: 21, class: "st-256color", title: "tmux", session_type: "local", session: "e1", tmux_window_id: "7" },
            "2": { wid: 2, pid: 22, class: "st-256color", title: "tmux", session_type: "local", session: "e2", tmux_window_id: "8" }
        }
      }
      {
        name: $uni_ws, ws_layout: "splith",
        layout: { "1": "st-256color" },
        state: { "1": { wid: 3, pid: 31, class: "st-256color", title: "tmux", session_type: "local", session: "séss ion 日本 u1", tmux_window_id: "9" } }
      }
    ]
}
$saved | to yaml | save -f $"($home)/.cache/sway-state.yaml"

def rig-calls [log: string] { open $log | lines | where {|l| $l | str starts-with "CALL " } }
def mutating [log: string] {
    rig-calls $log | where {|l| $l =~ '"method":"(workspace\.(rename|build|focus|move)|window\.|exec|layout\.|action\.)' }
}

# The stub launcher's calls since line $skip: one list of argv words per call.
def launcher-calls [tmp: string, skip: int = 0] {
    let f = $"($tmp)/launcher.log"
    if not ($f | path exists) { return [] }
    open $f --raw | lines | skip $skip | where {|l| $l | is-not-empty } | each {|l| $l | split row (char --integer 0x1f) | where {|w| $w | is-not-empty } }
}
def launcher-n [tmp: string] { launcher-calls $tmp | length }

# Terminal slots for dev are wm-slot-dev-<key>.
let tree_before_dry = (rig $test_path $sock "tree.get")
let calls_before = (mutating $rig_log | length)

# ── 1. dry-run-kwi3 ───────────────────────────────────────────────────────────
print "\n[1] dry-run-kwi3"
let tree_json = $"{\"layout\":\"splith\",\"nodes\":[{\"key\":\"1\",\"swallows\":[{\"class\":\"^wm-slot-dev-1$\"}]},{\"layout\":\"splitv\",\"nodes\":[{\"key\":\"2\",\"swallows\":[{\"class\":\"^wm-slot-dev-2$\"}]},{\"key\":\"3\",\"window\":($Z)}]},{\"layout\":\"tabbed\",\"nodes\":[{\"key\":\"4\",\"swallows\":[{\"class\":\"^wm-slot-dev-4$\"}]},{\"key\":\"5\",\"window\":($F1)},{\"key\":\"6\",\"swallows\":[{\"class\":\"^Gone$\"}]}]}]}"
let want_dry = ([
    "Restoring workspace: dev"
    $"  DRY: kwi3-rpc workspace.rename {\"id\":($dev_id),\"name\":\"dev-old\"}"
    $"  DRY: kwi3-rpc workspace.build {\"name\":\"dev\",\"tree\":($tree_json)}"
    "  DRY: ~/.local/bin/wm-launch-terminal st --session a --class wm-slot-dev-1"
    "  DRY: ~/.local/bin/wm-launch-terminal st --session b --class wm-slot-dev-2"
    "  DRY: ~/.local/bin/wm-launch-terminal st --workspace dev --class wm-slot-dev-4"
    "  DRY: sleep 600ms (let new terminals attach)"
    $"  DRY: kwi3-rpc window.close {\"id\":($T1)}"
    $"  DRY: kwi3-rpc window.close {\"id\":($T2)}"
    $"  DRY: kwi3-rpc window.close {\"id\":($T3)}"
    "  DRY: kwi3-rpc workspace.focus {\"name\":\"main\"}"
    "Dry run complete"
    ""
] | str join "\n")
let r = (run-ws $tmp $test_path $k ["restore" "--dry-run" "--workspace" "dev"])
let tree_after_dry = (rig $test_path $sock "tree.get")
if (check "dry-run-kwi3: exact build params and launcher command lines" ($r.exit_code == 0 and $r.stdout == $want_dry) $"exit=($r.exit_code)\n--- got\n($r.stdout)\n--- want\n($want_dry)\nstderr=($r.stderr)") { $passed += 1 } else { $failed += 1 }
if (check "dry-run-kwi3: rig tree unchanged, no mutating call, nothing spawned, launcher not run" ($tree_before_dry == $tree_after_dry and (mutating $rig_log | length) == $calls_before and (open $"($tmp)/spawn.log" | lines | is-empty) and (launcher-n $tmp) == 0) "dry run changed the rig or ran the launcher") { $passed += 1 } else { $failed += 1 }

# ── 2. restore (first run) ────────────────────────────────────────────────────
print "\n[2] restore dev"
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
let t1 = (rig-json $test_path $sock "tree.get")
let dev = (ws-node $t1 "dev")
let want_shape = {
    layout: "splith",
    kids: [
        "ph:^wm-slot-dev-1$"
        { layout: "splitv", kids: ["ph:^wm-slot-dev-2$" $"w:($Z)"] }
        { layout: "tabbed", kids: ["ph:^wm-slot-dev-4$" $"w:($F1)" "ph:^Gone$"] }
    ]
}
let got_shape = if $dev == null { null } else { { layout: $dev.layout, kids: ($dev.nodes | each {|k| shape $k }) } }
if (check "restore ran clean" ($r.exit_code == 0 and ($r.stdout | str contains "Restore complete")) $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }
if (check "restore-shape: layouts and order equal the saved layout, one placeholder per terminal" ($got_shape == $want_shape) $"got=($got_shape | to json -r)\nwant=($want_shape | to json -r)") { $passed += 1 } else { $failed += 1 }
let shares = if $dev == null { [] } else { $dev.nodes | get percent }
let inner = if $dev == null { [] } else { ($dev.nodes | get 1).nodes | get percent }
let eq3 = ($shares | each {|p| ($p - 1.0 / 3.0) | math abs } | all {|d| $d < 0.001 })
let eq2 = ($inner | each {|p| ($p - 0.5) | math abs } | all {|d| $d < 0.001 })
if (check "restore-shape: shares equal (a save carries none)" ($eq3 and $eq2 and ($shares | length) == 3) $"shares=($shares | to json -r) inner=($inner | to json -r)") { $passed += 1 } else { $failed += 1 }
let spawned = (launcher-calls $tmp)
if (check "restore-shape: one launcher call per terminal, exact argv" ($spawned == [["st" "--session" "a" "--class" "wm-slot-dev-1"] ["st" "--session" "b" "--class" "wm-slot-dev-2"] ["st" "--workspace" "dev" "--class" "wm-slot-dev-4"]]) $"spawned=($spawned | to json -r)") { $passed += 1 } else { $failed += 1 }
if (check "no-exec-rpc: restore sent no exec RPC (rig request log), the host spawned nothing" ((rig-calls $rig_log | where {|l| $l =~ '"method":"exec"' } | is-empty) and (open $"($tmp)/spawn.log" | lines | is-empty)) "an exec RPC reached the rig") { $passed += 1 } else { $failed += 1 }
if (check "restore-gui-window-leaf: Zathura by saved con id, Firefox by class (first, not ff-2)" ($got_shape != null and $F1 != $F2 and ("w:($Z)" | is-not-empty) and (not ($got_shape | to json -r | str contains $"w:($F2)"))) $"got=($got_shape | to json -r)") { $passed += 1 } else { $failed += 1 }
if (check "restore-gui-window-leaf: the pulled windows left `other`" (ws-node $t1 "other" | default {nodes: []} | leaves $in | where id in [$Z $F1] | is-empty) "windows still on other") { $passed += 1 } else { $failed += 1 }
if (check "restore-gui-placeholder: Gone is a class placeholder" (($got_shape | to json -r) | str contains "ph:^Gone$") $"got=($got_shape | to json -r)") { $passed += 1 } else { $failed += 1 }
let old = (ws-node $t1 "dev-old")
let old_ids = if $old == null { [] } else { leaves $old | get id }
let all_ids = (workspace-nodes $t1 | each {|w| leaves $w | get id } | flatten)
if (check "restore-renames-old: dev-old holds the unsaved window, old terminals are closed" ($old != null and ($old | get nodes | length) == 1 and (con-by-title $t1 "keep-dev" | get -o id) in $old_ids and not ($T1 in $all_ids) and not ($T2 in $all_ids) and not ($T3 in $all_ids)) $"old=($old_ids | to json -r) all=($all_ids | to json -r)") { $passed += 1 } else { $failed += 1 }
let focused = (rig-json $test_path $sock "workspace.list" | where focused == true | get -o 0.name | default "")
if (check "restore returns to the start workspace" ($focused == "main") $"focused=($focused)") { $passed += 1 } else { $failed += 1 }

# ── 3. second restore stamps the leftover ─────────────────────────────────────
print "\n[3] restore-old-stamped"
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
let names = (rig-json $test_path $sock "workspace.list" | get name)
let stamped = ($names | where {|n| $n =~ '^dev-old-[0-9]+$' })
let t2 = (rig-json $test_path $sock "tree.get")
let stamped_ws = if ($stamped | is-empty) { null } else { ws-node $t2 ($stamped | first) }
let dev2 = (ws-node $t2 "dev")
let dev2_shape = if $dev2 == null { null } else { { layout: $dev2.layout, kids: ($dev2.nodes | each {|k| shape $k }) } }
if (check "restore-old-stamped: leftover dev-old stamped dev-old-<ts> (keeps its window), new dev built" ($r.exit_code == 0 and ($stamped | length) == 1 and "dev" in $names and not ("dev-old" in $names) and $stamped_ws != null and ((leaves $stamped_ws | get window_properties.title) == ["keep-dev"]) and $dev2_shape == $want_shape) $"names=($names | to json -r) shape=($dev2_shape | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
# (The previous dev held only windows the build pulled out plus placeholders, so
# it is gone - nothing is left under a plain dev-old.) Its placeholders must not outlive it, or `wm-slot-dev-1` would
# be swallowed by the OLD one when the new terminal maps.
let stale_ph = (workspace-nodes $t2 | where name != "dev" | each {|w| $w.nodes | each {|k| shape $k } } | to json -r | str contains "ph:")
if (check "restore-old-stamped: no placeholder left on a -old workspace" (not $stale_ph) "an old placeholder would steal a new terminal") { $passed += 1 } else { $failed += 1 }

# ── 4. placeholder-only workspace ─────────────────────────────────────────────
print "\n[4] placeholder-only-ws"
let nspawn = (launcher-n $tmp)
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "gui"])
let t3 = (rig-json $test_path $sock "tree.get")
let gui = (ws-node $t3 "gui")
if (check "placeholder-only-ws: built as one placeholder, survives, nothing spawned" ($r.exit_code == 0 and $gui != null and ($gui.nodes | each {|k| shape $k }) == ["ph:^Nowhere$"] and (launcher-n $tmp) == $nspawn) $"gui=($gui | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 5. unicode / metacharacter names ──────────────────────────────────────────
print "\n[5] name-unicode"
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" $uni_ws])
let t4 = (rig-json $test_path $sock "tree.get")
let uw = (ws-node $t4 $uni_ws)
let uni_class = $"wm-slot-($uni_ws)-1"
let want_re = $"^wm-slot-dév 日本 \\$x 'q'-1$"
let spawn_all = (launcher-calls $tmp)
let want_exec = ["st" "--session" "séss ion 日本 u1" "--class" $uni_class]
if (check "name-unicode: workspace built under its exact name, regex escaped" ($r.exit_code == 0 and $uw != null and ($uw.nodes | each {|k| shape $k }) == [$"ph:($want_re)"]) $"uw=($uw | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
if (check "name-unicode: the slot class is ONE argv word, verbatim, no shell quoting" (($spawn_all | last) == $want_exec) $"got=($spawn_all | last | to json -r)\nwant=($want_exec)") { $passed += 1 } else { $failed += 1 }
if (check "name-unicode: <name>-old holds the unsaved window" ((ws-node $t4 $"($uni_ws)-old" | default {nodes: []} | leaves $in | get window_properties.title) == ["keep-uni"]) "old workspace missing") { $passed += 1 } else { $failed += 1 }

# ── 6. launcher refused ───────────────────────────────────────────────────────
print "\n[6] launcher-refused"
"wm-slot-ef-1\n" | save -f $"($tmp)/launcher-refuse"   # the launcher refuses slot 1 only (exit 78)
let nspawn = (launcher-n $tmp)
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "ef"])
let t5 = (rig-json $test_path $sock "tree.get")
let attempted = (launcher-calls $tmp $nspawn)
let ef_old = (ws-node $t5 "ef-old")
let ef_old_titles = if $ef_old == null { [] } else { leaves $ef_old | get window_properties.title }
if (check "launcher-refused: reported per terminal (slot named), the other terminal still launched, restore continues" ($r.exit_code == 0 and ($attempted | length) == 2 and (($attempted | get 1) == ["st" "--session" "e2" "--class" "wm-slot-ef-2"]) and ($r.stderr | str contains "wm-slot-ef-1") and ($r.stderr | str contains "78")) $"attempted=($attempted | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
if (check "launcher-refused: old terminals kept (their tmux clients are the only attachment left)" (($ef_old_titles | sort) == ["keep-ef" "old-e1" "old-e2"]) $"old=($ef_old_titles | to json -r)") { $passed += 1 } else { $failed += 1 }
^rm -f $"($tmp)/launcher-refuse"

# ── 7. a spawned terminal fills its placeholder (the mapspawn leg) ─────────────
print "\n[7] spawned terminals map into their placeholders"
"" | save -f $"($tmp)/mapspawn"
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
sleep 300ms   # the driver polls the stub launcher's queue every 40ms
let t6 = (rig-json $test_path $sock "tree.get")
let dev3 = (ws-node $t6 "dev")
let filled = if $dev3 == null { [] } else { leaves $dev3 | get window_properties.class }
if (check "restore: terminals the launcher started with `--class wm-slot-...` land in dev, GUI leaves stay" ($r.exit_code == 0 and ($filled | where {|c| $c =~ '^wm-slot-dev-' } | length) == 3 and "Zathura" in $filled and "Firefox" in $filled) $"classes=($filled | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
^rm -f $"($tmp)/mapspawn"

# ── 7b. save -> restore -> save -> restore (kwi3-a1j.9) ────────────────────────
# After a restore the terminals wear `wm-slot-<ws>-<key>`; a save of that state
# used to file them as GUI skip_restore, so the NEXT restore never respawned
# them. Section 7 left dev holding exactly those terminals.
print "\n[7b] round-trip"
let cache = $"($home)/.cache/sway-state.yaml"
let r = (run-ws $tmp $test_path $k ["save" "--workspace" "dev"])
let sv = (open $cache | get workspaces | where name == "dev" | first)
let term_entries = ($sv.state | transpose k v | where {|e| ($e.v.class | str starts-with "wm-slot-") })
if (check "round-trip: save ran clean, the three slot terminals are in the cache" ($r.exit_code == 0 and ($term_entries | length) == 3) $"($r | to nuon) state=($sv.state | to json -r)") { $passed += 1 } else { $failed += 1 }
if (check "round-trip: slot terminals are NOT skip_restore" ($term_entries | all {|e| ($e.v | get -o skip_restore | default false) == false }) $"state=($sv.state | to json -r)") { $passed += 1 } else { $failed += 1 }
let sess = ($term_entries | each {|e| { c: $e.v.class, s: ($e.v | get -o session | default "") } } | sort-by c)
if (check "round-trip: tmux session association survives the save" ($sess == [{c: "wm-slot-dev-1", s: "a"} {c: "wm-slot-dev-2", s: "b"} {c: "wm-slot-dev-4", s: ""}]) $"sess=($sess | to json -r)") { $passed += 1 } else { $failed += 1 }
"" | save -f $"($tmp)/mapspawn"
let nspawn = (launcher-n $tmp)
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
let again = (launcher-calls $tmp $nspawn)
if (check "round-trip: second restore respawns the terminals with fresh slot classes and sessions" ($r.exit_code == 0 and $again == [["st" "--session" "a" "--class" "wm-slot-dev-1"] ["st" "--session" "b" "--class" "wm-slot-dev-2"] ["st" "--workspace" "dev" "--class" "wm-slot-dev-4"]]) $"again=($again | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-ws $tmp $test_path $k ["save" "--workspace" "dev"])
let sv2 = (open $cache | get workspaces | where name == "dev" | first)
if (check "round-trip: a second save is stable (same layout, same state)" ($r.exit_code == 0 and $sv2.layout == $sv.layout and ($sv2.state | get "1" | get session) == "a" and ($sv2.state | get "2" | get session) == "b") $"layout1=($sv.layout | to json -r) layout2=($sv2.layout | to json -r)") { $passed += 1 } else { $failed += 1 }
# A corrupt cache must not abort a FULL save: on main it is simply overwritten.
"workspaces: [unclosed\n  - : : {" | save -f $cache
let r = (run-ws $tmp $test_path $k ["save"])
let healed = (try { open $cache | get workspaces | length } catch { -1 })
if (check "round-trip: a full save over a corrupt cache succeeds and rewrites it" ($r.exit_code == 0 and $healed > 0) $"healed=($healed) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
^rm -f $"($tmp)/mapspawn"

# ── 8. tmux down ──────────────────────────────────────────────────────────────
print "\n[8] tmux-down-aborts"
"" | save -f $"($tmp)/tmux-down"
let calls_n = (rig-calls $rig_log | length)
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
let calls_after = (rig-calls $rig_log | length)
if (check "tmux-down-aborts: exit 1, says why, not one kwi3 call" ($r.exit_code == 1 and ($r.stderr | str contains "tmux server unreachable") and $calls_after == $calls_n) $"calls ($calls_n) -> ($calls_after) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
^rm -f $"($tmp)/tmux-down"

# ── 8b. launcher missing ──────────────────────────────────────────────────────
print "\n[8b] launcher-missing-aborts-early"
^mv $launcher_path $"($launcher_path).away"
let calls_n = (mutating $rig_log | length)
let r = (run-ws $tmp $test_path $k ["restore" "--workspace" "dev"])
let r_dry = (run-ws $tmp $test_path $k ["restore" "--dry-run" "--workspace" "dev"])
let calls_after = (mutating $rig_log | length)
if (check "launcher-missing-aborts-early: exit 1, names the path, no mutating kwi3 call (live and dry-run)" ($r.exit_code == 1 and ($r.stderr | str contains $launcher_path) and $r_dry.exit_code == 1 and ($r_dry.stderr | str contains $launcher_path) and $calls_after == $calls_n) $"calls ($calls_n) -> ($calls_after) ($r | to nuon) ($r_dry | to nuon)") { $passed += 1 } else { $failed += 1 }
^mv $"($launcher_path).away" $launcher_path

# ── 9. no i3 verb anywhere ────────────────────────────────────────────────────
print "\n[9] no-i3-verbs"
let rig_text = (open $rig_log)
let stub_calls = (if ($i3_log | path exists) { open $i3_log | str trim } else { "" })
let verbs = ["append_layout" "get_marks" "con_mark" "mark "]
let seen = ($verbs | where {|v| $rig_text | str contains $v })
if (check "no-i3-verbs: no i3 verb in the rig's request log, no i3-msg/swaymsg call at all" (($seen | is-empty) and ($stub_calls | is-empty)) $"seen=($seen | to json -r) i3-msg log=($stub_calls)") { $passed += 1 } else { $failed += 1 }
let tmux_used = (open $tmux_log | lines | where {|l| not ($l | str starts-with "list-sessions") and not ($l =~ '(^| )list-clients ') })
if (check "sandbox: the stub tmux was only asked list-sessions / list-clients" ($tmux_used | is-empty) $"tmux=($tmux_used | to json -r)") { $passed += 1 } else { $failed += 1 }

# ── cleanup ───────────────────────────────────────────────────────────────────

^kill $rig_pid
sleep 200ms
^rm -rf $tmp

print ""
if $failed > 0 {
    print $"FAIL: ($failed) of ($passed + $failed) checks failed"
    exit 1
}
print $"PASS: ($passed) checks passed"
