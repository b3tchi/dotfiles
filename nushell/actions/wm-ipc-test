#!/usr/bin/env nu
# wm-ipc-test — scripted test for wm-ipc.nu's kwi3 branch (kwi3-ax6), in the
# d2-router-test / preview-test pattern.
#
# kwi3 drops its i3 IPC socket and the I3SOCK export (kwi3-234.18); from then
# on a kwi3 session is reachable ONLY through $KWI3SOCK (JSON-RPC 2.0 NDJSON,
# kwi3 repo docs/notes/ft010.md). This drives wm-ipc.nu and its real callers
# (ws-list.nu, ws-switch.nu) against the REAL kwi3 core, not a stub: kwi3's
# own node rig i3kwin/test/rpc-server.js (the one quickshell/
# test-kwi3-backend.sh uses), on a throwaway socket under /tmp.
#
# Tests:
#   1. ipc-cmd / wm-name name kwi3 when $KWI3SOCK answers.
#   2. ws-list `sorted` returns the rig's workspaces, i3-shaped
#      (name/num/focused), read back against `kwi3-msg workspace.list`.
#   3. ws-switch.nu N actually changes the rig's focused workspace
#      (a new one, then back to an existing one).
#   4. ws-switch.nu N move / follow move the focused window (where focus
#      lands after a plain move is kwi3's Logic, not this translation)
#      (`move container to workspace X`; the `;` chain runs in order).
#   5. rename: ws-list `normalize` (quoted `rename workspace "A" to "B"`)
#      and an explicit rename;workspace chain, run in order.
#   6. -t get_tree -> tree.get (i3's get_tree shape).
#   7. An unknown command under kwi3 is a LOUD error (non-zero, names the
#      command), and an all-or-nothing chain sends nothing at all.
#   8. $KWI3SOCK set but dead (missing path, and a stale socket file):
#      logs to stderr, does nothing, and NEVER falls back to i3 even with an
#      answering $I3SOCK beside it.
#   9. $KWI3SOCK unset: the i3 path is unchanged — the same commands through
#      main's wm-ipc.nu and this one give the identical stub i3-msg argv log.
#
# Safety: every nu run is `env -i` (no DISPLAY / WAYLAND_DISPLAY / I3SOCK /
# SWAYSOCK / HOTKEYD_I3SOCK from the caller), HOME is a sandbox whose
# ~/.local/bin holds THIS tree's scripts, PATH starts with stubs for i3-msg,
# swaymsg and i3 so no real WM can be reached, and the rig is killed by its
# exact pid.
#
# Run:  KWI3_REPO=/path/to/kwi3 nu nushell/actions/wm-ipc-test
#       (KWI3_REPO defaults to ~/.local/src/kwi3, test-kwi3-backend.sh's
#       convention; it must provide i3kwin/test/rpc-server.js and
#       i3kwin/bin/kwi3-msg)
# Pass: exits 0 and prints "PASS: N checks passed"

const HERE = (path self | path dirname)

let kwi3_repo = ($env | get -o KWI3_REPO | default ($env.HOME | path join ".local/src/kwi3"))
let rig_js = ($kwi3_repo | path join "i3kwin/test/rpc-server.js")
let kwi3_msg = ($kwi3_repo | path join "i3kwin/bin/kwi3-msg")
for f in [$rig_js $kwi3_msg] {
    if not ($f | path exists) {
        print -e $"FATAL: ($f) not found - set KWI3_REPO to a kwi3 checkout"
        exit 2
    }
}
let node = (which node | get -o 0.path | default "")
if ($node | is-empty) { print -e "FATAL: node not on PATH"; exit 2 }
let nu_bin = (which nu | get 0.path)

# ── sandbox ───────────────────────────────────────────────────────────────────

# /tmp, not a scratchpad: AF_UNIX sun_path is 108 bytes.
let tmp = (^mktemp -d /tmp/wmipc-test.XXXXXX | str trim)
let home = $"($tmp)/home"
let bin = $"($tmp)/bin"
^mkdir -p $"($home)/.local/bin" $bin $"($tmp)/old"
for s in [wm-ipc.nu ws-list.nu ws-switch.nu] {
    ^ln -s ($HERE | path join $s) $"($home)/.local/bin/($s)"
}
^ln -s $kwi3_msg $"($bin)/kwi3-msg"

# Stub i3-msg: records its argv, answers get_version / get_workspaces.
let i3_log = $"($tmp)/i3-msg.log"
let sway_log = $"($tmp)/swaymsg.log"
$"#!/bin/bash
printf '%q ' \"$@\" >> ($i3_log); echo >> ($i3_log)
case \"$*\" in
  *get_version*) echo '{\"major\":4}' ;;
  *get_workspaces*) echo '[{\"num\":1,\"name\":\"1\",\"focused\":true}]' ;;
  *) echo '[{\"success\":true}]' ;;
esac
" | save -f $"($bin)/i3-msg"
# Stub swaymsg / i3: never answer, so the i3 path's sway probe misses.
$"#!/bin/bash\nprintf '%q ' \"$@\" >> ($sway_log); echo >> ($sway_log); exit 1\n" | save -f $"($bin)/swaymsg"
"#!/bin/bash\nexit 1\n" | save -f $"($bin)/i3"
^chmod +x $"($bin)/i3-msg" $"($bin)/swaymsg" $"($bin)/i3"
let i3sock = $"($tmp)/i3.sock"
"" | save -f $i3sock      # find-i3-sockets only needs the path to exist
let test_path = ([$bin ($node | path dirname) "/usr/local/bin" "/usr/bin" "/bin"] | str join ":")

let sock = $"($tmp)/k.sock"
let rig_log = $"($tmp)/rig.log"
let rig_pid = (^bash -c $"'($node)' '($rig_js)' '($sock)' > '($rig_log)' 2>&1 & echo $!" | str trim | into int)

mut ok = false
for _ in 1..50 {
    if (do { ^env -i $"PATH=($test_path)" $"KWI3SOCK=($sock)" kwi3-msg workspace.list } | complete | get exit_code) == 0 {
        $ok = true
        break
    }
    sleep 100ms
}
if not $ok {
    print -e $"FATAL: rig did not come up: (open $rig_log)"
    ^kill $rig_pid
    ^rm -rf $tmp
    exit 2
}

# ── helpers ───────────────────────────────────────────────────────────────────

# Run nu in the sandbox. `extra` is a list of "K=V" env entries.
def run-nu [tmp: string, test_path: string, extra: list<string>, args: list<string>] {
    do { ^env -i $"HOME=($tmp)/home" $"PATH=($test_path)" ...$extra nu -n ...$args } | complete
}

def rig-list [test_path: string, sock: string] {
    ^env -i $"PATH=($test_path)" $"KWI3SOCK=($sock)" kwi3-msg workspace.list | from json
}

def focused-name [test_path: string, sock: string] {
    rig-list $test_path $sock | where focused == true | get -o 0.name | default ""
}

mut passed = 0
mut failed = 0
def check [name: string, cond: bool, detail: string] {
    if $cond { print $"  PASS  ($name)" } else { print $"  FAIL  ($name)\n        ($detail)" }
    $cond
}

let k = [$"KWI3SOCK=($sock)" $"I3SOCK=($i3sock)"]
let use_ipc = $"use ($home)/.local/bin/wm-ipc.nu *;"
let use_wsl = $"use ($home)/.local/bin/ws-list.nu *;"
let ws_switch = $"($home)/.local/bin/ws-switch.nu"

# ── 1. detection ──────────────────────────────────────────────────────────────
print "\n[1] detection"
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) print \(ipc-cmd\); print \(wm-name\)"])
if (check "ipc-cmd kwi3-msg, wm-name kwi3" (($r.stdout | str trim) == "kwi3-msg\nkwi3") $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 2. ws-list returns the rig's workspaces ───────────────────────────────────
print "\n[2] ws-list sorted"
let r = (run-nu $tmp $test_path $k ["-c" $"($use_wsl) sorted | select name num focused | to json -r"])
let want = (rig-list $test_path $sock | sort-by num | select name num focused | to json -r)
if (check "sorted == workspace.list" ($r.exit_code == 0 and ($r.stdout | str trim) == $want) $"want ($want) got ($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 3. ws-switch N changes the focused workspace ──────────────────────────────
print "\n[3] ws-switch N"
let r = (run-nu $tmp $test_path $k [$ws_switch "2"])
let f = (focused-name $test_path $sock)
if (check "ws-switch 2 -> focused \"2\"" ($r.exit_code == 0 and $f == "2") $"focused=($f) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k [$ws_switch "1"])
let f = (focused-name $test_path $sock)
if (check "ws-switch 1 -> focused \"1\"" ($r.exit_code == 0 and $f == "1") $"focused=($f) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 4. move / follow ──────────────────────────────────────────────────────────
print "\n[4] ws-switch N move / follow"
let r = (run-nu $tmp $test_path $k [$ws_switch "2" "move"])
let l = (rig-list $test_path $sock)
let w1 = ($l | where name == "1" | get -o 0.windows | default (-1))
let w2 = ($l | where name == "2" | get -o 0.windows | default (-1))
let f = (focused-name $test_path $sock)
if (check "move: one window moved from \"1\" to \"2\"" ($r.exit_code == 0 and $w1 == 1 and $w2 == 1) $"w1=($w1) w2=($w2) focused=($f) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k [$ws_switch "2" "follow"])
let l = (rig-list $test_path $sock)
let w2 = ($l | where name == "2" | get -o 0.windows | default (-1))
let f = (focused-name $test_path $sock)
if (check "follow: both windows on \"2\", focused \"2\"" ($r.exit_code == 0 and $w2 == 2 and $f == "2") $"w2=($w2) focused=($f) ($r | to nuon) list=($l | to json -r)") { $passed += 1 } else { $failed += 1 }

# ── 5. rename ─────────────────────────────────────────────────────────────────
print "\n[5] rename"
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc 'rename workspace \"2\" to \"proj_1\"' | ignore"])
let names = (rig-list $test_path $sock | get name)
if (check "rename workspace \"2\" to \"proj_1\"" ($r.exit_code == 0 and "proj_1" in $names and not ("2" in $names)) $"names=($names | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k ["-c" $"($use_wsl) normalize proj"])
let names = (rig-list $test_path $sock | get name)
if (check "ws-list normalize proj_1 -> proj" ($r.exit_code == 0 and "proj" in $names and not ("proj_1" in $names)) $"names=($names | to json -r) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc 'rename workspace \"proj\" to \"proj_1\"; workspace other; rename workspace to other2' | ignore"])
let names = (rig-list $test_path $sock | get name)
let f = (focused-name $test_path $sock)
if (check "chain rename; workspace; rename-focused runs in order" ($r.exit_code == 0 and "proj_1" in $names and $f == "other2") $"names=($names | to json -r) focused=($f) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 6. get_tree ───────────────────────────────────────────────────────────────
print "\n[6] -t get_tree"
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc '-t get_tree' | from json | get type"])
if (check "get_tree -> tree.get root" ($r.exit_code == 0 and ($r.stdout | str trim) == "root") $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 7. unknown command is loud, chains are all-or-nothing ─────────────────────
print "\n[7] unknown command"
let before = (rig-list $test_path $sock | to json -r)
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc 'sticky toggle'"])
if (check "sticky toggle: non-zero, names it" ($r.exit_code != 0 and ($r.stderr | str contains "sticky toggle")) $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc 'workspace 1; nosuchverb x'"])
let after = (rig-list $test_path $sock | to json -r)
if (check "bad chain: non-zero, nothing sent" ($r.exit_code != 0 and $after == $before) $"before=($before) after=($after) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc-raw 'exec foo'"])
if (check "ipc-raw goes through the same translation" ($r.exit_code == 0) $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }
let r = (run-nu $tmp $test_path $k ["-c" $"($use_ipc) ipc '-t get_marks'"])
if (check "-t get_marks: non-zero" ($r.exit_code != 0 and ($r.stderr | str contains "get_marks")) $"($r | to nuon)") { $passed += 1 } else { $failed += 1 }

# ── 8. KWI3SOCK set but dead: log, do nothing, never i3 ───────────────────────
print "\n[8] dead KWI3SOCK"
let stale = $"($tmp)/stale.sock"
^python3 -c $"import socket; s=socket.socket\(socket.AF_UNIX\); s.bind\('($stale)'\)"
for dead in [$"($tmp)/missing.sock" $stale] {
    "" | save -f $i3_log
    let before = (rig-list $test_path $sock | to json -r)
    let dk = [$"KWI3SOCK=($dead)" $"I3SOCK=($i3sock)"]
    let r = (run-nu $tmp $test_path $dk ["-c" $"($use_ipc) let x = \(ipc 'workspace 5'\); print \($x == null\); print \(ipc-cmd | to json\); print \(wm-name | to json\)"])
    let after = (rig-list $test_path $sock | to json -r)
    let i3calls = (open $i3_log | str trim)
    if (check $"($dead | path basename): returns null, logs, no i3 call" ($r.exit_code == 0 and ($r.stdout | str trim) == "true\nnull\nnull" and ($r.stderr | str contains "KWI3SOCK") and ($i3calls | is-empty) and $before == $after) $"i3calls=($i3calls) ($r | to nuon)") { $passed += 1 } else { $failed += 1 }
}

# ── 9. KWI3SOCK unset: the i3 path is main's, argv for argv ───────────────────
print "\n[9] i3 path unchanged"
^git -C $HERE show main:nushell/actions/wm-ipc.nu | save -f $"($tmp)/old/wm-ipc.nu"
let script = "print (ipc-cmd); print (wm-name); ipc '-t get_workspaces' | print; ipc 'workspace 2' | print; ipc 'rename workspace \"a b\" to \"c\"' | print; ipc-raw \"exec foo 'bar baz'\" | print; ipc 'sticky toggle' | print"
let ik = [$"I3SOCK=($i3sock)"]
"" | save -f $i3_log
"" | save -f $sway_log
let old = (run-nu $tmp $test_path $ik ["-c" $"use ($tmp)/old/wm-ipc.nu *; ($script)"])
let old_log = (open $i3_log)
let old_sway = (open $sway_log)
"" | save -f $i3_log
"" | save -f $sway_log
let new = (run-nu $tmp $test_path $ik ["-c" $"($use_ipc) ($script)"])
let new_log = (open $i3_log)
let new_sway = (open $sway_log)
if (check "same stdout / exit" ($old.stdout == $new.stdout and $old.exit_code == $new.exit_code and $new.exit_code == 0) $"old=($old | to nuon) new=($new | to nuon)") { $passed += 1 } else { $failed += 1 }
if (check "same i3-msg argv log" ($old_log == $new_log and ($new_log | str contains $"-s ($i3sock) workspace 2")) $"old:\n($old_log)\nnew:\n($new_log)") { $passed += 1 } else { $failed += 1 }
if (check "same swaymsg argv log" ($old_sway == $new_sway) $"old:\n($old_sway)\nnew:\n($new_sway)") { $passed += 1 } else { $failed += 1 }

# ── cleanup ───────────────────────────────────────────────────────────────────

^kill $rig_pid
sleep 200ms
^rm -rf $tmp

print ""
if $failed > 0 {
    print $"FAIL: ($failed) of ($passed + $failed) checks failed"
    exit 1
}
print $"PASS: ($passed) checks passed"
