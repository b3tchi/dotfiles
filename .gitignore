node_modules/
.mypy_cache/
__pycache__/
*.pyc
resources/
*.sh.log
raspberry/pi_image/
nvim/test_*
flow-launcher/Plugins/*/*.json.bak
power-toys/**/Logs
nushell/scripts/gwt/config/profiles.yaml

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Perles per-project config (use global ~/.config/perles/config.yaml)
.perles/

# SSH per-host configs (per-machine, not tracked; .gitkeep preserves dir)
ssh/config.d/*
!ssh/config.d/.gitkeep

# Eval sandboxes (each seed re-creates a throwaway git repo)
claude/marketplace/plugins/infinifu/skills/*-workspace/iteration-*/eval-*/with_skill/sandbox/
claude/marketplace/plugins/infinifu/skills/*-workspace/iteration-*/eval-*/without_skill/sandbox/

# Compiled daemon build artifacts (Go binaries — build output, not source)
akm-graph/akmgraph
preview/preview
preview/preview-d
d2/d2router

# Agent task worktrees (dotfiles-3c7). `work-do` checks each bd task out into
# .worktrees/bd-<id>.<N>/, and the Claude Code harness makes its own under
# .claude/worktrees/ — each is a WHOLE SECOND COPY of this repo.
#
# Untracked, they showed up in `git status`, and this repo is known to have
# concurrent agent sessions, at least one of which does `git add -A` and
# auto-commits. One such sweep with a worktree present commits the entire copy
# into main, doubling the tree — recoverable, but silent and ugly, and it gets
# likelier the more the pipeline is used.
.worktrees/
.claude/worktrees/
