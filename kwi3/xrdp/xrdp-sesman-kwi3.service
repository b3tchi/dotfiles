# kwi3-7m8.7 — the kwi3 listener's own session manager, for this WSL/Arch
# box.
#
# Adapted from the phone's krdp/phone/systemd/xrdp-sesman-kwi3.service
# (kwi3-soc.14) verbatim except for the description; the mechanism does not
# change per host, only the port and paths do, and those live in
# xrdp-kwi3.service and the ini files, not here.
#
#   sudo install -m 644 xrdp-sesman-kwi3.service /etc/systemd/system/
#
# Deliberately NOT a copy of xrdp-sesman.service with a different --config.
# xrdp-sesman(8) does take `-c /path/to/sesman.ini`, but its own man page
# says why that is not enough on its own: "you will have to have a
# /etc/xrdp/sesman.ini in place too, as a few elements of the system
# (notably xrdp(8) and xrdp-chansrv(8)) will want to read it." Measured on
# xrdp 0.10.6 (this box's package, same version as the phone's),
# xrdp_mm_connect_sm() builds that path with
#
#     g_snprintf(buf, 255, "%s/sesman.ini", "/etc/xrdp")
#
# — the directory is a compile-time literal in the binary, not derived from
# `xrdp -c`, so there is no configuration that points a second xrdp at a
# second sesman. A private mount namespace is what is left, and it is
# exact: one file, replaced for this unit and everything it spawns, and
# invisible to the stock stack — /etc/xrdp/rsakeys.ini, cert.pem, key.pem,
# startwm.sh, the km-*.ini keymaps and gfx.toml are all read unchanged
# through the same /etc/xrdp path, because only sesman.ini is overridden.
[Unit]
Description=xrdp session manager for the kwi3 listener (kwi3-7m8.7)
Documentation=man:xrdp-sesman(8) man:sesman.ini(5)
After=network.target
StopWhenUnneeded=true
BindsTo=xrdp-kwi3.service

[Service]
Type=exec
# The one line this whole unit exists for. sesexec, Xorg, chansrv and
# startwm.sh are all children of this process, so they inherit the
# namespace and every one of them reads the SAME sesman.ini — which is
# what makes [SessionVariables] KWI3_SESSION=1 reach ~/.xinitrc.
PrivateMounts=yes
BindPaths=/etc/xrdp-kwi3/sesman.ini:/etc/xrdp/sesman.ini
ExecStart=/usr/bin/xrdp-sesman --nodaemon
ExecReload=kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
