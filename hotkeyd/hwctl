#!/bin/sh
# hwctl CONTROL +|- : one step of a device control, for hotkeyd's controls
# layer ($mod+c on kwi3: a letter steps up, held Alt steps down).
# hwctl show : one line of KEY=VALUE pairs, for the bar's controls panel.
#
#   volume      default sink, 5 %, 0..100
#   brightness  every /sys/class/backlight device, 5 % of max, never off
#               (needs the video group)
#   rotation    the first enabled KWin output, + clockwise, - counter
#               (kscreen-doctor; $WAYLAND_DISPLAY must be the session's)
#
# Toggles (+ and - both flip them):
#   autorotate  ~/.config/spacewar/autorotate, which the phone's
#               spacewar-autorotate watches (nothing-pmos controls/)
#   wifi, bluetooth, nfc
#               rfkill soft block (the seat's /dev/rfkill ACL)
#   gps         qmi-gnss.socket, geoclue's NMEA source (a polkit rule in
#               nothing-pmos controls/ allows start/stop); "in-use" while a
#               client holds a GNSS session

AUTOROTATE=${XDG_CONFIG_HOME:-$HOME/.config}/spacewar/autorotate
USAGE="usage: hwctl volume|brightness|rotation|autorotate|wifi|bluetooth|nfc|gps +|- | hwctl show"

# rfkill TYPE -> on|off|-
radio() {
	case $(rfkill -rn -o SOFT,HARD list "$1" 2>/dev/null | head -n 1) in
	"unblocked unblocked") echo on ;;
	"") echo - ;;
	*) echo off ;;
	esac
}

control=$1 dir=$2
if [ "$control" = show ]; then
	vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n 1)
	bri=
	for d in /sys/class/backlight/*; do
		[ -r "$d/brightness" ] || continue
		bri="$(($(cat "$d/brightness") * 100 / $(cat "$d/max_brightness")))%"
		break
	done
	rot=$(kscreen-doctor -j 2>/dev/null | jq -r '[.outputs[] | select(.enabled)][0].rotation' 2>/dev/null)
	case "$rot" in 1) rot=normal ;; 2) rot=left ;; 4) rot=inverted ;; 8) rot=right ;; *) rot=- ;; esac
	if [ -e "$AUTOROTATE" ]; then auto=on; else auto=off; fi
	gps=off
	if systemctl is-active -q qmi-gnss.socket 2>/dev/null; then
		gps=on
		systemctl list-units -q --state=active --no-legend 'qmi-gnss@*' 2>/dev/null | grep -q . && gps=in-use
	fi
	echo "volume=${vol:--} brightness=${bri:--} rotation=$rot autorotate=$auto" \
		"wifi=$(radio wlan) bluetooth=$(radio bluetooth) nfc=$(radio nfc) gps=$gps"
	exit 0
fi
case "$dir" in
+ | -) ;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac

case "$control" in
volume)
	cur=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -n 1 | tr -d %)
	new=$((cur $dir 5))
	[ "$new" -gt 100 ] && new=100
	[ "$new" -lt 0 ] && new=0
	pactl set-sink-volume @DEFAULT_SINK@ "$new%"
	;;
brightness)
	for d in /sys/class/backlight/*; do
		[ -w "$d/brightness" ] || continue
		max=$(cat "$d/max_brightness")
		step=$((max / 20))
		new=$(($(cat "$d/brightness") $dir step))
		[ "$new" -gt "$max" ] && new=$max
		[ "$new" -lt "$step" ] && new=$step
		echo "$new" >"$d/brightness"
	done
	;;
rotation)
	# kscreen-doctor -j: rotation 1 none, 2 left, 4 inverted, 8 right
	set -- $(kscreen-doctor -j | jq -r '[.outputs[] | select(.enabled)][0] | "\(.name) \(.rotation)"')
	out=$1 rot=$2
	if [ "$dir" = + ]; then
		case "$rot" in 1) to=right ;; 8) to=inverted ;; 4) to=left ;; *) to=none ;; esac
	else
		case "$rot" in 1) to=left ;; 2) to=inverted ;; 4) to=right ;; *) to=none ;; esac
	fi
	kscreen-doctor "output.$out.rotation.$to" >/dev/null
	;;
autorotate)
	if [ -e "$AUTOROTATE" ]; then
		rm -f "$AUTOROTATE"
	else
		mkdir -p "${AUTOROTATE%/*}" && : >"$AUTOROTATE"
	fi
	;;
wifi) rfkill toggle wlan ;;
bluetooth) rfkill toggle bluetooth ;;
nfc) rfkill toggle nfc ;;
gps)
	if systemctl is-active -q qmi-gnss.socket; then
		systemctl --no-ask-password stop qmi-gnss.socket
	else
		systemctl --no-ask-password start qmi-gnss.socket
	fi
	;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac
