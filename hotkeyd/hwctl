#!/bin/sh
# hwctl CONTROL +|- : one step of a device control, for hotkeyd's controls
# layer ($mod+c: a letter steps up, held Alt or Shift steps down).
# hwctl show : one line of KEY=VALUE pairs, for the bar's controls panel.
# hwctl select CONTROL : pick the control the volume keys step in the layer
#   (a tap on its row in the panel; entering the layer picks volume again).
# hwctl selected +|- : one step of the picked control (volume when none is).
#
#   volume      default sink, 5 %, 0..100
#   brightness  every /sys/class/backlight device, to the next round 10 %, floor
#               10 % so it is never off (needs the video group). Percent, not raw
#               units: a step of max/10 truncates and drifts off the round numbers
#   rotation    + clockwise, - counter. Wayland (kwi3 on KWin): the first
#               enabled output, via kscreen-doctor ($WAYLAND_DISPLAY must be the
#               session's). X11 (i3): the primary output, else the first active
#               one, via xrandr ($DISPLAY)
#   scale       the session's size (fonts, titlebars, bar, every window): the
#               output scale of the first enabled output, a toggle
#               (+ and - both flip it) between 1.5 (the phone's own) and 2.
#               Wayland (kwi3 on KWin) only, via kscreen-doctor. The kwi3
#               module (kwi3/config.js, 8x20 logical) is kept as it is: at
#               each step a cell is still a whole number of device pixels
#               (1.5 12x30, 2 16x40), so foot's pinned
#               line-height and the grid stay in step
#
#   autosuspend idle delay before the phone suspends: 30s, 1min, 10min, 1hr, off,
#               wrapping; default 1min. ~/.config/spacewar/autosuspend, which
#               spacewar-idle-suspend reads (nothing-pmos suspend/)
#
# Toggles (+ and - both flip them):
#   autorotate  ~/.config/spacewar/autorotate, which the phone's
#               spacewar-autorotate watches (nothing-pmos controls/)
#   wifi, bluetooth, nfc
#               rfkill soft block (the seat's /dev/rfkill ACL)
#   gps         qmi-gnss.socket, geoclue's NMEA source (a polkit rule in
#               nothing-pmos controls/ allows start/stop); "in-use" while a
#               client holds a GNSS session
#   torch       the camera flash LED held on as a torchlight: the first
#               /sys/class/leds/*:flash or *:torch, brightness 0 or its max
#               (the LED's torch mode; needs the video group)

AUTOROTATE=${XDG_CONFIG_HOME:-$HOME/.config}/spacewar/autorotate
SUSPEND=${XDG_CONFIG_HOME:-$HOME/.config}/spacewar/autosuspend
BACKLIGHT=${HWCTL_BACKLIGHT:-/sys/class/backlight}
LEDS=${HWCTL_LEDS:-/sys/class/leds}
SELECTED=${XDG_RUNTIME_DIR:-/tmp}/hwctl-selected
CONTROLS="volume brightness rotation scale autorotate autosuspend wifi bluetooth nfc gps torch"
USAGE="usage: hwctl volume|brightness|rotation|scale|autorotate|autosuspend|wifi|bluetooth|nfc|gps|torch|selected +|- | hwctl select CONTROL | hwctl show"

# The control `selected` steps: what `select` stored, volume for none or a bad one.
selected_get() {
	_s=$(cat "$SELECTED" 2>/dev/null)
	case " $CONTROLS " in
	*" $_s "*) [ -n "$_s" ] && echo "$_s" || echo volume ;;
	*) echo volume ;;
	esac
}

# rfkill TYPE -> on|off|-
radio() {
	case $(rfkill -rn -o SOFT,HARD list "$1" 2>/dev/null | head -n 1) in
	"unblocked unblocked") echo on ;;
	"") echo - ;;
	*) echo off ;;
	esac
}

# The torch LED's directory: the first flash or torch LED; nothing for none.
torch_led() {
	for _d in "$LEDS"/*:flash "$LEDS"/*:torch; do
		[ -r "$_d/brightness" ] && { echo "$_d"; return 0; }
	done
}

# torch -> on|off|- (no LED)
torch_get() {
	_t=$(torch_led)
	[ -n "$_t" ] || { echo -; return 0; }
	[ "$(cat "$_t/brightness")" -gt 0 ] && echo on || echo off
}

# The auto-suspend delay in effect: the default for no setting, or a bad one.
suspend_delay() {
	case $(cat "$SUSPEND" 2>/dev/null) in
	30s) echo 30s ;;
	10min) echo 10min ;;
	1hr) echo 1hr ;;
	off) echo off ;;
	*) echo 1min ;;
	esac
}

# The device's current brightness in percent, to the nearest one.
percent() { # <device dir>
	_m=$(cat "$1/max_brightness")
	echo $((($(cat "$1/brightness") * 100 + _m / 2) / _m))
}

# The rotation backend: kscreen-doctor on a Wayland session that has it, xrandr
# otherwise. An i3 session has no $WAYLAND_DISPLAY.
kscreen() { [ -n "${WAYLAND_DISPLAY:-}" ] && command -v kscreen-doctor >/dev/null 2>&1; }

# "<output> <normal|left|inverted|right>" for the output rotation acts on;
# nothing when there is none.
rot_get() {
	if kscreen; then
		# kscreen-doctor -j: rotation 1 none, 2 left, 4 inverted, 8 right
		kscreen-doctor -j 2>/dev/null | jq -r '[.outputs[] | select(.enabled)][0] | "\(.name) \(.rotation)"' 2>/dev/null |
			awk 'NF == 2 { r = $2 == 2 ? "left" : $2 == 4 ? "inverted" : $2 == 8 ? "right" : "normal"; print $1, r }'
	else
		# xrandr: "NAME connected [primary] WxH+X+Y [left|inverted|right] (..."
		xrandr --query 2>/dev/null | awk '
			$2 == "connected" {
				for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) {
					r = $(i + 1)
					if (r !~ /^(left|inverted|right)$/) r = "normal"
					if ($3 == "primary" && !p) p = $1 " " r
					if (!f) f = $1 " " r
					break
				}
			}
			END { if (p) print p; else if (f) print f }'
	fi
}

rot_set() { # <output> <normal|left|inverted|right>
	if kscreen; then
		[ "$2" = normal ] && set -- "$1" none
		kscreen-doctor "output.$1.rotation.$2" >/dev/null
	else
		xrandr --output "$1" --rotate "$2"
	fi
}

# "<output> <scale>" for the first enabled output, scale in hundredths
# (150 = 1.5); nothing when there is none or no kscreen-doctor.
scale_get() {
	kscreen || return 0
	kscreen-doctor -j 2>/dev/null | jq -r '[.outputs[] | select(.enabled)][0] | "\(.name) \((.scale * 100) | round)"' 2>/dev/null |
		awk 'NF == 2 && $2 ~ /^[0-9]+$/'
}

# hundredths -> "1.5", "1.25", "2"
scale_fmt() { awk -v s="$1" 'BEGIN { printf "%g\n", s / 100 }'; }

control=$1 dir=$2
if [ "$control" = select ]; then
	case " $CONTROLS " in
	*" $dir "*) [ -n "$dir" ] || { echo "$USAGE" >&2; exit 2; } ;;
	*)
		echo "$USAGE" >&2
		exit 2
		;;
	esac
	echo "$dir" >"$SELECTED.new" && mv -f "$SELECTED.new" "$SELECTED"
	exit 0
fi
if [ "$control" = selected ]; then
	control=$(selected_get)
	# The volume keys repeat while held (every 200 ms). Volume and brightness
	# keep stepping; everything else would flap, so it takes one step per
	# press: a call under 0.5 s after the previous one is a repeat, skipped.
	case $control in
	volume | brightness) ;;
	*)
		now=$(cut -d' ' -f1 /proc/uptime | tr -d .)
		last=$(cat "$SELECTED.last" 2>/dev/null)
		echo "$now" >"$SELECTED.last"
		[ -n "$last" ] && [ $((now - last)) -lt 50 ] && exit 0
		;;
	esac
fi
if [ "$control" = show ]; then
	vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n 1)
	bri=
	for d in "$BACKLIGHT"/*; do
		[ -r "$d/brightness" ] || continue
		bri="$(percent "$d")%"
		break
	done
	rot=$(rot_get | cut -d' ' -f2)
	sc=$(scale_get | cut -d' ' -f2)
	[ -n "$sc" ] && sc=$(scale_fmt "$sc")
	if [ -e "$AUTOROTATE" ]; then auto=on; else auto=off; fi
	gps=off
	if systemctl is-active -q qmi-gnss.socket 2>/dev/null; then
		gps=on
		systemctl list-units -q --state=active --no-legend 'qmi-gnss@*' 2>/dev/null | grep -q . && gps=in-use
	fi
	echo "volume=${vol:--} brightness=${bri:--} rotation=${rot:--} scale=${sc:--} autorotate=$auto autosuspend=$(suspend_delay)" \
		"wifi=$(radio wlan) bluetooth=$(radio bluetooth) nfc=$(radio nfc) gps=$gps torch=$(torch_get) selected=$(selected_get)"
	exit 0
fi
case "$dir" in
+ | -) ;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac

case "$control" in
volume)
	cur=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -n 1 | tr -d %)
	new=$((cur $dir 5))
	[ "$new" -gt 100 ] && new=100
	[ "$new" -lt 0 ] && new=0
	pactl set-sink-volume @DEFAULT_SINK@ "$new%"
	;;
brightness)
	for d in "$BACKLIGHT"/*; do
		[ -w "$d/brightness" ] || continue
		max=$(cat "$d/max_brightness")
		cur=$(percent "$d")
		if [ "$dir" = + ]; then
			new=$(((cur + 10) / 10 * 10))
		else
			new=$(((cur - 1) / 10 * 10))
		fi
		[ "$new" -gt 100 ] && new=100
		[ "$new" -lt 10 ] && new=10
		echo $(((new * max + 50) / 100)) >"$d/brightness"
	done
	;;
rotation)
	set -- $(rot_get)
	[ $# -eq 2 ] || {
		echo "hwctl: no output to rotate" >&2
		exit 1
	}
	out=$1 rot=$2
	if [ "$dir" = + ]; then
		case "$rot" in normal) to=right ;; right) to=inverted ;; inverted) to=left ;; *) to=normal ;; esac
	else
		case "$rot" in normal) to=left ;; left) to=inverted ;; inverted) to=right ;; *) to=normal ;; esac
	fi
	rot_set "$out" "$to"
	;;
scale)
	set -- $(scale_get)
	[ $# -eq 2 ] || {
		echo "hwctl: no output to scale (needs kscreen-doctor on a Wayland session)" >&2
		exit 1
	}
	out=$1 cur=$2
	# a toggle: + and - both flip between the two; an odd scale set
	# elsewhere goes to the nearer one's other
	if [ "$cur" -lt 175 ]; then new=200; else new=150; fi
	kscreen-doctor "output.$out.scale.$(scale_fmt "$new")" >/dev/null
	;;
autorotate)
	if [ -e "$AUTOROTATE" ]; then
		rm -f "$AUTOROTATE"
	else
		mkdir -p "${AUTOROTATE%/*}" && : >"$AUTOROTATE"
	fi
	;;
autosuspend)
	if [ "$dir" = + ]; then
		case $(suspend_delay) in 30s) to=1min ;; 1min) to=10min ;; 10min) to=1hr ;; 1hr) to=off ;; *) to=30s ;; esac
	else
		case $(suspend_delay) in 30s) to=off ;; 1min) to=30s ;; 10min) to=1min ;; 1hr) to=10min ;; *) to=1hr ;; esac
	fi
	mkdir -p "${SUSPEND%/*}" && echo "$to" >"$SUSPEND"
	;;
wifi) rfkill toggle wlan ;;
bluetooth) rfkill toggle bluetooth ;;
nfc) rfkill toggle nfc ;;
gps)
	if systemctl is-active -q qmi-gnss.socket; then
		systemctl --no-ask-password stop qmi-gnss.socket
	else
		systemctl --no-ask-password start qmi-gnss.socket
	fi
	;;
torch)
	t=$(torch_led)
	[ -n "$t" ] || {
		echo "hwctl: no flash LED for the torch" >&2
		exit 1
	}
	if [ "$(cat "$t/brightness")" -gt 0 ]; then
		echo 0 >"$t/brightness"
	else
		cat "$t/max_brightness" >"$t/brightness"
	fi
	;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac
