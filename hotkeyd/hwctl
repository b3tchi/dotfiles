#!/bin/sh
# hwctl CONTROL +|- : one step of a device control, for hotkeyd's controls
# layer ($mod+c: a letter steps up, held Alt or Shift steps down).
# hwctl show : one line of KEY=VALUE pairs, for the bar's controls panel.
#
#   volume      default sink, 5 %, 0..100
#   brightness  every /sys/class/backlight device, to the next round 10 %, floor
#               10 % so it is never off (needs the video group). Percent, not raw
#               units: a step of max/10 truncates and drifts off the round numbers
#   rotation    + clockwise, - counter. Wayland (kwi3 on KWin): the first
#               enabled output, via kscreen-doctor ($WAYLAND_DISPLAY must be the
#               session's). X11 (i3): the primary output, else the first active
#               one, via xrandr ($DISPLAY)
#
#   autosuspend idle delay before the phone suspends: 30s, 1min, 10min, 1hr, off,
#               wrapping; default 1min. ~/.config/spacewar/autosuspend, which
#               spacewar-idle-suspend reads (nothing-pmos suspend/)
#
# Toggles (+ and - both flip them):
#   autorotate  ~/.config/spacewar/autorotate, which the phone's
#               spacewar-autorotate watches (nothing-pmos controls/)
#   wifi, bluetooth, nfc
#               rfkill soft block (the seat's /dev/rfkill ACL)
#   gps         qmi-gnss.socket, geoclue's NMEA source (a polkit rule in
#               nothing-pmos controls/ allows start/stop); "in-use" while a
#               client holds a GNSS session

AUTOROTATE=${XDG_CONFIG_HOME:-$HOME/.config}/spacewar/autorotate
SUSPEND=${XDG_CONFIG_HOME:-$HOME/.config}/spacewar/autosuspend
BACKLIGHT=${HWCTL_BACKLIGHT:-/sys/class/backlight}
USAGE="usage: hwctl volume|brightness|rotation|autorotate|autosuspend|wifi|bluetooth|nfc|gps +|- | hwctl show"

# rfkill TYPE -> on|off|-
radio() {
	case $(rfkill -rn -o SOFT,HARD list "$1" 2>/dev/null | head -n 1) in
	"unblocked unblocked") echo on ;;
	"") echo - ;;
	*) echo off ;;
	esac
}

# The auto-suspend delay in effect: the default for no setting, or a bad one.
suspend_delay() {
	case $(cat "$SUSPEND" 2>/dev/null) in
	30s) echo 30s ;;
	10min) echo 10min ;;
	1hr) echo 1hr ;;
	off) echo off ;;
	*) echo 1min ;;
	esac
}

# The device's current brightness in percent, to the nearest one.
percent() { # <device dir>
	_m=$(cat "$1/max_brightness")
	echo $((($(cat "$1/brightness") * 100 + _m / 2) / _m))
}

# The rotation backend: kscreen-doctor on a Wayland session that has it, xrandr
# otherwise. An i3 session has no $WAYLAND_DISPLAY.
kscreen() { [ -n "${WAYLAND_DISPLAY:-}" ] && command -v kscreen-doctor >/dev/null 2>&1; }

# "<output> <normal|left|inverted|right>" for the output rotation acts on;
# nothing when there is none.
rot_get() {
	if kscreen; then
		# kscreen-doctor -j: rotation 1 none, 2 left, 4 inverted, 8 right
		kscreen-doctor -j 2>/dev/null | jq -r '[.outputs[] | select(.enabled)][0] | "\(.name) \(.rotation)"' 2>/dev/null |
			awk 'NF == 2 { r = $2 == 2 ? "left" : $2 == 4 ? "inverted" : $2 == 8 ? "right" : "normal"; print $1, r }'
	else
		# xrandr: "NAME connected [primary] WxH+X+Y [left|inverted|right] (..."
		xrandr --query 2>/dev/null | awk '
			$2 == "connected" {
				for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) {
					r = $(i + 1)
					if (r !~ /^(left|inverted|right)$/) r = "normal"
					if ($3 == "primary" && !p) p = $1 " " r
					if (!f) f = $1 " " r
					break
				}
			}
			END { if (p) print p; else if (f) print f }'
	fi
}

rot_set() { # <output> <normal|left|inverted|right>
	if kscreen; then
		[ "$2" = normal ] && set -- "$1" none
		kscreen-doctor "output.$1.rotation.$2" >/dev/null
	else
		xrandr --output "$1" --rotate "$2"
	fi
}

control=$1 dir=$2
if [ "$control" = show ]; then
	vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n 1)
	bri=
	for d in "$BACKLIGHT"/*; do
		[ -r "$d/brightness" ] || continue
		bri="$(percent "$d")%"
		break
	done
	rot=$(rot_get | cut -d' ' -f2)
	if [ -e "$AUTOROTATE" ]; then auto=on; else auto=off; fi
	gps=off
	if systemctl is-active -q qmi-gnss.socket 2>/dev/null; then
		gps=on
		systemctl list-units -q --state=active --no-legend 'qmi-gnss@*' 2>/dev/null | grep -q . && gps=in-use
	fi
	echo "volume=${vol:--} brightness=${bri:--} rotation=${rot:--} autorotate=$auto autosuspend=$(suspend_delay)" \
		"wifi=$(radio wlan) bluetooth=$(radio bluetooth) nfc=$(radio nfc) gps=$gps"
	exit 0
fi
case "$dir" in
+ | -) ;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac

case "$control" in
volume)
	cur=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -n 1 | tr -d %)
	new=$((cur $dir 5))
	[ "$new" -gt 100 ] && new=100
	[ "$new" -lt 0 ] && new=0
	pactl set-sink-volume @DEFAULT_SINK@ "$new%"
	;;
brightness)
	for d in "$BACKLIGHT"/*; do
		[ -w "$d/brightness" ] || continue
		max=$(cat "$d/max_brightness")
		cur=$(percent "$d")
		if [ "$dir" = + ]; then
			new=$(((cur + 10) / 10 * 10))
		else
			new=$(((cur - 1) / 10 * 10))
		fi
		[ "$new" -gt 100 ] && new=100
		[ "$new" -lt 10 ] && new=10
		echo $(((new * max + 50) / 100)) >"$d/brightness"
	done
	;;
rotation)
	set -- $(rot_get)
	[ $# -eq 2 ] || {
		echo "hwctl: no output to rotate" >&2
		exit 1
	}
	out=$1 rot=$2
	if [ "$dir" = + ]; then
		case "$rot" in normal) to=right ;; right) to=inverted ;; inverted) to=left ;; *) to=normal ;; esac
	else
		case "$rot" in normal) to=left ;; left) to=inverted ;; inverted) to=right ;; *) to=normal ;; esac
	fi
	rot_set "$out" "$to"
	;;
autorotate)
	if [ -e "$AUTOROTATE" ]; then
		rm -f "$AUTOROTATE"
	else
		mkdir -p "${AUTOROTATE%/*}" && : >"$AUTOROTATE"
	fi
	;;
autosuspend)
	if [ "$dir" = + ]; then
		case $(suspend_delay) in 30s) to=1min ;; 1min) to=10min ;; 10min) to=1hr ;; 1hr) to=off ;; *) to=30s ;; esac
	else
		case $(suspend_delay) in 30s) to=off ;; 1min) to=30s ;; 10min) to=1min ;; 1hr) to=10min ;; *) to=1hr ;; esac
	fi
	mkdir -p "${SUSPEND%/*}" && echo "$to" >"$SUSPEND"
	;;
wifi) rfkill toggle wlan ;;
bluetooth) rfkill toggle bluetooth ;;
nfc) rfkill toggle nfc ;;
gps)
	if systemctl is-active -q qmi-gnss.socket; then
		systemctl --no-ask-password stop qmi-gnss.socket
	else
		systemctl --no-ask-password start qmi-gnss.socket
	fi
	;;
*)
	echo "$USAGE" >&2
	exit 2
	;;
esac
